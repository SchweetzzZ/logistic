  file_change {
    absolute_path_uri: "file:///src/components/CargoTracking.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Search, CheckCircle2, Clock, MapPin, Truck, ShieldCheck, Thermometer } from \'lucide-react\';\nimport { TrackingData } from \'../types\';\n\nexport const CargoTracking: React.FC = () => {\n  const [trackingCode, setTrackingCode] = useState(\'LGF-88492-BR\');\n  const [searched, setSearched] = useState(true);\n  const [loading, setLoading] = useState(false);\n\n  const [data] = useState<TrackingData>({\n    code: \'LGF-88492-BR\',\n    status: \'Em tr\303\242nsito \342\200\242 BR-101 Sul km 142\',\n    origin: \'Centro de Distribui\303\247\303\243o Cajamar, SP\',\n    destination: \'Terminal Log\303\255stico Itaja\303\255, SC\',\n    estimatedDelivery: \'Hoje, at\303\251 \303\240s 18:45\',\n    carrier: \'TransBrasil Log\303\255stica Integrada\',\n    vehiclePlate: \'BRA-9E42 (Cavalo Mec\303\242nico Scania R450)\',\n    temperature: \'18.4\302\260C (Carga climatizada)\',\n    sla: \'99.8% no prazo\',\n    steps: [\n      {\n        title: \'Carga coletada e despachada\',\n        location: \'CD Cajamar / SP\',\n        timestamp: \'Hoje, 06:15\',\n        completed: true,\n        current: false,\n        detail: \'Documenta\303\247\303\243o fiscal (CT-e / MDF-e) validada pela SEFAZ.\',\n      },\n      {\n        title: \'Triagem e confer\303\252ncia no hub\',\n        location: \'Crossdocking Curitiba / PR\',\n        timestamp: \'Hoje, 11:40\',\n        completed: true,\n        current: false,\n        detail: \'Pesagem por balan\303\247a din\303\242mica e inspe\303\247\303\243o visual aprovadas.\',\n      },\n      {\n        title: \'Em tr\303\242nsito na rodovia\',\n        location: \'BR-101 Sul \342\200\242 Sentido Litoral Catarinense\',\n        timestamp: \'Atualizado h\303\241 8 min\',\n        completed: false,\n        current: true,\n        detail: \'Velocidade de cruzeiro: 78 km/h. Telemetria GPS ativa.\',\n      },\n      {\n        title: \'Previs\303\243o de chegada no destino\',\n        location: \'Porto Seco Itaja\303\255 / SC\',\n        timestamp: \'Previsto: 18:45\',\n        completed: false,\n        current: false,\n        detail: \'Doca 04 reservada para descarregamento imediato.\',\n      },\n    ],\n  });\n\n  const handleSearch = (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoading(true);\n    setTimeout(() => {\n      setLoading(false);\n      setSearched(true);\n    }, 350);\n  };\n\n  return (\n    <section id=\"rastreio\" className=\"py-16 relative\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        <div className=\"max-w-4xl mx-auto bg-zinc-900/60 border border-zinc-800 rounded-2xl p-6 sm:p-8 backdrop-blur-sm shadow-xl\">\n          \n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-zinc-800/80\">\n            <div>\n              <div className=\"flex items-center gap-2 mb-1\">\n                <span className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n                <span className=\"text-xs font-mono uppercase text-zinc-400\">Consulta de telemetria p\303\272blica</span>\n              </div>\n              <h3 className=\"text-xl sm:text-2xl font-bold text-white\">\n                Rastrear encomenda em tempo real\n              </h3>\n              <p className=\"text-xs sm:text-sm text-zinc-400 mt-0.5\">\n                Consulte a localiza\303\247\303\243o exata, telemetria veicular e previs\303\243o de entrega por c\303\263digo ou NF-e.\n              </p>\n            </div>\n\n            {/* QUICK FORM */}\n            <form onSubmit={handleSearch} className=\"flex items-center gap-2\">\n              <input\n                type=\"text\"\n                value={trackingCode}\n                onChange={(e) => setTrackingCode(e.target.value)}\n                placeholder=\"Ex: LGF-88492-BR\"\n                className=\"w-48 sm:w-56 bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-xs font-mono text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 transition\"\n              />\n              <button\n                type=\"submit\"\n                disabled={loading}\n                className=\"bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-semibold px-4 py-2 rounded-lg text-xs transition active:scale-[0.98] shrink-0\"\n              >\n                {loading ? \'Buscando...\' : \'Consultar\'}\n              </button>\n            </form>\n          </div>\n\n          {/* TELEMETRY DETAILS */}\n          {searched && (\n            <div className=\"mt-6 space-y-6\">\n              {/* TOP SUMMARY BAR */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3 bg-zinc-950/80 border border-zinc-800 rounded-xl p-4\">\n                <div>\n                  <p className=\"text-[11px] text-zinc-400\">C\303\263digo de rastreio</p>\n                  <p className=\"text-sm font-bold font-mono text-emerald-400\">{data.code}</p>\n                  <p className=\"text-[11px] text-zinc-400 mt-1\">{data.carrier}</p>\n                </div>\n\n                <div>\n                  <p className=\"text-[11px] text-zinc-400\">Status atual</p>\n                  <div className=\"flex items-center gap-1.5 mt-0.5\">\n                    <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\n                    <p className=\"text-sm font-semibold text-zinc-100\">{data.status}</p>\n                  </div>\n                  <p className=\"text-[11px] text-zinc-400 mt-1\">{data.vehiclePlate}</p>\n                </div>\n\n                <div>\n                  <p className=\"text-[11px] text-zinc-400\">Previs\303\243o no destino</p>\n                  <p className=\"text-sm font-semibold text-zinc-100\">{data.estimatedDelivery}</p>\n                  <p className=\"text-[11px] font-mono text-emerald-400 mt-1\">{data.sla}</p>\n                </div>\n              </div>\n\n              {/* TIMELINE */}\n              <div className=\"space-y-4 pt-2\">\n                <p className=\"text-xs font-semibold text-zinc-300\">Hist\303\263rico de movimenta\303\247\303\243o:</p>\n                <div className=\"space-y-3\">\n                  {data.steps.map((step, idx) => (\n                    <div key={idx} className=\"flex items-start gap-3.5 group\">\n                      <div className=\"flex flex-col items-center shrink-0 mt-0.5\">\n                        {step.completed ? (\n                          <div className=\"w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center border border-emerald-500/30\">\n                            <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                          </div>\n                        ) : step.current ? (\n                          <div className=\"w-5 h-5 rounded-full bg-emerald-500 text-zinc-950 flex items-center justify-center animate-pulse shadow-sm shadow-emerald-500/40\">\n                            <Truck className=\"w-3 h-3\" />\n                          </div>\n                        ) : (\n                          <div className=\"w-5 h-5 rounded-full bg-zinc-900 border border-zinc-800\" />\n                        )}\n                        {idx < data.steps.length - 1 && (\n                          <div\n                            className={`w-0.5 h-9 my-1 ${\n                              step.completed ? \'bg-emerald-500/40\' : \'bg-zinc-800\'\n                            }`}\n                          />\n                        )}\n                      </div>\n\n                      <div className=\"flex-1 bg-zinc-950/40 border border-zinc-800/60 rounded-lg p-3\">\n                        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-1\">\n                          <h4 className={`text-xs font-semibold ${step.current ? \'text-emerald-300\' : \'text-zinc-200\'}`}>\n                            {step.title}\n                          </h4>\n                          <span className=\"text-[11px] font-mono text-zinc-400\">{step.timestamp}</span>\n                        </div>\n                        <p className=\"text-[11px] text-zinc-400 mt-0.5\">{step.location}</p>\n                        {step.detail && (\n                          <p className=\"text-[11px] text-zinc-400 mt-1 border-t border-zinc-800/60 pt-1\">\n                            {step.detail}\n                          </p>\n                        )}\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n            </div>\n          )}\n\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
