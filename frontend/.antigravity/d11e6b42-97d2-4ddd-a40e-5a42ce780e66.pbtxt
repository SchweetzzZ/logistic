  file_change {
    absolute_path_uri: "file:///src/components/PartnerSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { ArrowRight, CheckCircle2, Building2, Truck, ShieldCheck, Check } from \'lucide-react\';\n\ninterface PartnerSectionProps {\n  onOpenRegisterModal: () => void;\n}\n\nexport const PartnerSection: React.FC<PartnerSectionProps> = ({ onOpenRegisterModal }) => {\n  const [empresa, setEmpresa] = useState(\'\');\n  const [cnpj, setCnpj] = useState(\'\');\n  const [email, setEmail] = useState(\'\');\n  const [tipo, setTipo] = useState(\'Transportador / Frotista\');\n  const [submitted, setSubmitted] = useState(false);\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setSubmitted(true);\n    setTimeout(() => {\n      setSubmitted(false);\n      setEmpresa(\'\');\n      setCnpj(\'\');\n      setEmail(\'\');\n    }, 4000);\n  };\n\n  return (\n    <section id=\"parceiros\" className=\"py-20 relative scroll-mt-24\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        <div className=\"bg-zinc-900/60 border border-zinc-800 rounded-3xl p-8 sm:p-12 backdrop-blur-sm shadow-xl\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-center\">\n            \n            {/* LEFT COLUMN: VALUE PROPOSITION */}\n            <div className=\"lg:col-span-7 space-y-6\">\n              <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-950 border border-zinc-800 text-xs text-zinc-300\">\n                <span className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n                <span>Expans\303\243o de malha de fretes corporativos</span>\n              </div>\n\n              <h2 className=\"text-3xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight\">\n                Seja um parceiro LogiFlow e conecte sua frota \303\240s maiores cargas do pa\303\255s\n              </h2>\n\n              <p className=\"text-sm sm:text-base text-zinc-400 leading-relaxed max-w-xl\">\n                Trabalhamos em estreita colabora\303\247\303\243o com embarcadores industriais e operadoras de log\303\255stica rodovi\303\241ria para assegurar previsibilidade de demanda, rotas otimizadas e pagamento rigorosamente no prazo.\n              </p>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2\">\n                <div className=\"flex items-start gap-3\">\n                  <div className=\"w-5 h-5 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0 mt-0.5\">\n                    <Check className=\"w-3.5 h-3.5\" />\n                  </div>\n                  <div>\n                    <p className=\"text-xs font-semibold text-zinc-200\">Zero ociosidade de frotas</p>\n                    <p className=\"text-[11px] text-zinc-400\">Match instant\303\242neo com fretes de retorno no mesmo corredor rodovi\303\241rio.</p>\n                  </div>\n                </div>\n\n                <div className=\"flex items-start gap-3\">\n                  <div className=\"w-5 h-5 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0 mt-0.5\">\n                    <Check className=\"w-3.5 h-3.5\" />\n                  </div>\n                  <div>\n                    <p className=\"text-xs font-semibold text-zinc-200\">Emiss\303\243o fiscal simplificada</p>\n                    <p className=\"text-[11px] text-zinc-400\">Sincroniza\303\247\303\243o imediata de CT-e e MDF-e com as secretarias estaduais de fazenda.</p>\n                  </div>\n                </div>\n\n                <div className=\"flex items-start gap-3\">\n                  <div className=\"w-5 h-5 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0 mt-0.5\">\n                    <Check className=\"w-3.5 h-3.5\" />\n                  </div>\n                  <div>\n                    <p className=\"text-xs font-semibold text-zinc-200\">Liquida\303\247\303\243o pontual e segura</p>\n                    <p className=\"text-[11px] text-zinc-400\">Garantia de pagamento auditado sem glosas imprevistas.</p>\n                  </div>\n                </div>\n\n                <div className=\"flex items-start gap-3\">\n                  <div className=\"w-5 h-5 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0 mt-0.5\">\n                    <Check className=\"w-3.5 h-3.5\" />\n                  </div>\n                  <div>\n                    <p className=\"text-xs font-semibold text-zinc-200\">Acesso via API ou Web</p>\n                    <p className=\"text-[11px] text-zinc-400\">Integra\303\247\303\243o nativa com os principais TMS e ERPs do mercado brasileiro.</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* RIGHT COLUMN: QUICK LEAD CAPTURE FORM */}\n            <div className=\"lg:col-span-5\">\n              <div className=\"bg-zinc-950 border border-zinc-800 rounded-2xl p-6 sm:p-7 shadow-lg\">\n                <div className=\"mb-5\">\n                  <h3 className=\"text-lg font-bold text-white mb-1\">\n                    Cadastrar empresa parceira\n                  </h3>\n                  <p className=\"text-xs text-zinc-400\">\n                    Preencha os dados b\303\241sicos para homologa\303\247\303\243o cadastral priorit\303\241ria.\n                  </p>\n                </div>\n\n                {submitted ? (\n                  <div className=\"py-8 text-center space-y-3 bg-zinc-900/50 rounded-xl border border-zinc-800\">\n                    <div className=\"w-10 h-10 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 mx-auto flex items-center justify-center\">\n                      <CheckCircle2 className=\"w-5 h-5\" />\n                    </div>\n                    <p className=\"text-sm font-semibold text-zinc-100\">Cadastro iniciado com sucesso</p>\n                    <p className=\"text-xs text-zinc-400 px-4\">\n                      Nossa equipe t\303\251cnica entrar\303\241 em contato pelo e-mail corporativo fornecido.\n                    </p>\n                  </div>\n                ) : (\n                  <form onSubmit={handleSubmit} className=\"space-y-3.5\">\n                    <div>\n                      <label className=\"block text-xs font-medium text-zinc-300 mb-1\">\n                        Raz\303\243o social ou nome fantasia\n                      </label>\n                      <input\n                        type=\"text\"\n                        required\n                        value={empresa}\n                        onChange={(e) => setEmpresa(e.target.value)}\n                        placeholder=\"Ex: Transportes & Cargas Alian\303\247a Ltda\"\n                        className=\"w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2 text-xs text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 transition\"\n                      />\n                    </div>\n\n                    <div className=\"grid grid-cols-2 gap-3\">\n                      <div>\n                        <label className=\"block text-xs font-medium text-zinc-300 mb-1\">\n                          CNPJ da empresa\n                        </label>\n                        <input\n                          type=\"text\"\n                          required\n                          value={cnpj}\n                          onChange={(e) => setCnpj(e.target.value)}\n                          placeholder=\"00.000.000/0001-00\"\n                          className=\"w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2 text-xs font-mono text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 transition\"\n                        />\n                      </div>\n\n                      <div>\n                        <label className=\"block text-xs font-medium text-zinc-300 mb-1\">\n                          Perfil de atua\303\247\303\243o\n                        </label>\n                        <select\n                          value={tipo}\n                          onChange={(e) => setTipo(e.target.value)}\n                          className=\"w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2 text-xs text-zinc-200 focus:outline-none focus:border-emerald-500 transition\"\n                        >\n                          <option value=\"Transportador / Frotista\">Transportador</option>\n                          <option value=\"Embarcador Industrial\">Embarcador</option>\n                          <option value=\"Operador Log\303\255stico 3PL\">Operador 3PL</option>\n                        </select>\n                      </div>\n                    </div>\n\n                    <div>\n                      <label className=\"block text-xs font-medium text-zinc-300 mb-1\">\n                        E-mail de contato institucional\n                      </label>\n                      <input\n                        type=\"email\"\n                        required\n                        value={email}\n                        onChange={(e) => setEmail(e.target.value)}\n                        placeholder=\"diretoria@transportesalianca.com.br\"\n                        className=\"w-full bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2 text-xs text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 transition\"\n                      />\n                    </div>\n\n                    <button\n                      type=\"submit\"\n                      className=\"w-full mt-2 bg-emerald-500 hover:bg-emerald-400 active:scale-[0.98] text-zinc-950 font-semibold py-2.5 px-4 rounded-lg text-xs transition-all duration-150 shadow-sm flex items-center justify-center gap-1.5\"\n                    >\n                      <span>Cadastrar empresa / parceiro</span>\n                      <ArrowRight className=\"w-3.5 h-3.5\" />\n                    </button>\n\n                    <p className=\"text-[11px] text-zinc-400 text-center pt-1\">\n                      Precisa de um contrato enterprise personalizado?{\' \'}\n                      <button\n                        type=\"button\"\n                        onClick={onOpenRegisterModal}\n                        className=\"text-emerald-400 hover:text-emerald-300 underline\"\n                      >\n                        Abrir formul\303\241rio estendido\n                      </button>\n                    </p>\n                  </form>\n                )}\n              </div>\n            </div>\n\n          </div>\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
