      arguments_json: "{\"Content\":\"import React, { useState } from \'react\';\\nimport { ArrowRight, RefreshCw, Layers } from \'lucide-react\';\\nimport { QuoteOption } from \'../types\';\\n\\ninterface FreightSimulatorProps {\\n  onSelectQuote: (quote: QuoteOption) => void;\\n}\\n\\nexport const FreightSimulator: React.FC<FreightSimulatorProps> = ({ onSelectQuote }) => {\\n  const [cepOrigem, setCepOrigem] = useState(\'01001-000\');\\n  const [cepDestino, setCepDestino] = useState(\'80010-000\');\\n  const [pesoKg, setPesoKg] = useState(\'35\');\\n  const [comprimentoCm, setComprimentoCm] = useState(\'60\');\\n  const [larguraCm, setLarguraCm] = useState(\'40\');\\n  const [alturaCm, setAlturaCm] = useState(\'50\');\\n\\n  const [calculating, setCalculating] = useState(false);\\n  const [cubagemM3, setCubagemM3] = useState(\'0,120\');\\n  const [pesoCubadoKg, setPesoCubadoKg] = useState(\'36,0\');\\n\\n  const [quoteResults, setQuoteResults] = useState<QuoteOption[]>([\\n    {\\n      id: \'quote-1\',\\n      carrierName: \'Expresso S\303\243o Paulo\',\\n      badge: \'Melhor pre\303\247o\',\\n      badgeType: \'best-price\',\\n      transitDays: 4,\\n      transitTimeText: \'3 a 4 dias \303\272teis\',\\n      price: 138.5,\\n      modality: \'Carga fracionada standard\',\\n      coverage: \'Cobertura com seguro RCTR-C\',\\n    },\\n    {\\n      id: \'quote-2\',\\n      carrierName: \'VeloExpress Cargas\',\\n      badge: \'Mais r\303\241pido\',\\n      badgeType: \'fastest\',\\n      transitDays: 1,\\n      transitTimeText: \'1 a 2 dias \303\272teis\',\\n      price: 212.0,\\n      modality: \'Expresso rodovi\303\241rio priorit\303\241rio\',\\n      coverage: \'Cobertura com seguro RCTR-C\',\\n    },\\n    {\\n      id: \'quote-3\',\\n      carrierName: \'TransSul Linha Direta\',\\n      badgeType: \'standard\',\\n      transitDays: 3,\\n      transitTimeText: \'2 a 3 dias \303\272teis\',\\n      price: 165.0,\\n      modality: \'Linha direta regular\',\\n      coverage: \'Cobertura com seguro RCTR-C\',\\n    },\\n  ]);\\n\\n  const handleCalculate = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setCalculating(true);\\n\\n    const c = parseFloat(comprimentoCm) || 60;\\n    const l = parseFloat(larguraCm) || 40;\\n    const a = parseFloat(alturaCm) || 50;\\n    const realWeight = parseFloat(pesoKg) || 35;\\n\\n    // C\303\241lculo de volume e cubagem padr\303\243o rodovi\303\241rio (fator 300 kg/m\302\263)\\n    const volumeM3 = (c * l * a) / 1000000;\\n    const cubado = volumeM3 * 300;\\n    const pesoTaxado = Math.max(realWeight, cubado);\\n\\n    setTimeout(() => {\\n      setCubagemM3(volumeM3.toFixed(3).replace(\'.\', \',\'));\\n      setPesoCubadoKg(pesoTaxado.toFixed(1).replace(\'.\', \',\'));\\n\\n      // Ajuste proporcional baseado no peso taxado\\n      const factor = pesoTaxado / 36;\\n      setQuoteResults([\\n        {\\n          id: \'quote-1\',\\n          carrierName: \'Expresso S\303\243o Paulo\',\\n          badge: \'Melhor pre\303\247o\',\\n          badgeType: \'best-price\',\\n          transitDays: 4,\\n          transitTimeText: \'3 a 4 dias \303\272teis\',\\n          price: Math.round(138.5 * factor * 10) / 10,\\n          modality: \'Carga fracionada standard\',\\n          coverage: \'Cobertura com seguro RCTR-C\',\\n        },\\n        {\\n          id: \'quote-2\',\\n          carrierName: \'VeloExpress Cargas\',\\n          badge: \'Mais r\303\241pido\',\\n          badgeType: \'fastest\',\\n          transitDays: 1,\\n          transitTimeText: \'1 a 2 dias \303\272teis\',\\n          price: Math.round(212.0 * factor * 10) / 10,\\n          modality: \'Expresso rodovi\303\241rio priorit\303\241rio\',\\n          coverage: \'Cobertura com seguro RCTR-C\',\\n        },\\n        {\\n          id: \'quote-3\',\\n          carrierName: \'TransSul Linha Direta\',\\n          badgeType: \'standard\',\\n          transitDays: 3,\\n          transitTimeText: \'2 a 3 dias \303\272teis\',\\n          price: Math.round(165.0 * factor * 10) / 10,\\n          modality: \'Linha direta regular\',\\n          coverage: \'Cobertura com seguro RCTR-C\',\\n        },\\n      ]);\\n      setCalculating(false);\\n    }, 400);\\n  };\\n\\n  return (\\n    <section id=\\\"simulador-frete\\\" className=\\\"py-20 md:py-28 border-b border-zinc-800/60 scroll-mt-20\\\">\\n      <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\\\">\\n        \\n        {/* Cabe\303\247alho */}\\n        <div className=\\\"max-w-2xl mb-12\\\">\\n          <p className=\\\"text-xs font-mono uppercase tracking-wider text-emerald-400 mb-2\\\">\\n            Simula\303\247\303\243o p\303\272blica\\n          </p>\\n          <h2 className=\\\"text-2xl sm:text-3xl font-semibold tracking-tight text-white\\\">\\n            Simulador de frete inteligente\\n          </h2>\\n          <p className=\\\"text-zinc-400 text-sm sm:text-base mt-2\\\">\\n            Informe os dados da carga e compare instantaneamente as tabelas vigentes de transportadoras cadastradas.\\n          </p>\\n        </div>\\n\\n        {/* Card do simulador */}\\n        <div className=\\\"rounded-xl bg-zinc-900/60 border border-zinc-800 p-6 sm:p-8 backdrop-blur-sm\\\">\\n          \\n          <form onSubmit={handleCalculate} className=\\\"space-y-6\\\">\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\\\">\\n              \\n              {/* CEP de origem */}\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-zinc-300 mb-1.5\\\">\\n                  CEP de origem\\n                </label>\\n                <input\\n                  type=\\\"text\\\"\\n                  required\\n                  value={cepOrigem}\\n                  onChange={(e) => setCepOrigem(e.target.value)}\\n                  placeholder=\\\"00000-000\\\"\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm font-mono text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 transition\\\"\\n                />\\n                <span className=\\\"text-[11px] text-zinc-500 mt-1 block\\\">S\303\243o Paulo, SP</span>\\n              </div>\\n\\n              {/* CEP de destino */}\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-zinc-300 mb-1.5\\\">\\n                  CEP de destino\\n                </label>\\n                <input\\n                  type=\\\"text\\\"\\n                  required\\n                  value={cepDestino}\\n                  onChange={(e) => setCepDestino(e.target.value)}\\n                  placeholder=\\\"00000-000\\\"\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm font-mono text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 transition\\\"\\n                />\\n                <span className=\\\"text-[11px] text-zinc-500 mt-1 block\\\">Curitiba, PR</span>\\n              </div>\\n\\n              {/* Peso em kg */}\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-zinc-300 mb-1.5\\\">\\n                  Peso (kg)\\n                </label>\\n                <input\\n                  type=\\\"number\\\"\\n                  required\\n                  min=\\\"0.5\\\"\\n                  step=\\\"0.1\\\"\\n                  value={pesoKg}\\n                  onChange={(e) => setPesoKg(e.target.value)}\\n                  placeholder=\\\"35\\\"\\n                  className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm font-mono text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 transition\\\"\\n                />\\n                <span className=\\\"text-[11px] text-zinc-500 mt-1 block\\\">Peso real da mercadoria</span>\\n              </div>\\n\\n              {/* Dimens\303\265es em cm */}\\n              <div>\\n                <label className=\\\"block text-xs font-medium text-zinc-300 mb-1.5\\\">\\n                  Dimens\303\265es (C x L x A em cm)\\n                </label>\\n                <div className=\\\"grid grid-cols-3 gap-1.5\\\">\\n                  <input\\n                    type=\\\"number\\\"\\n                    required\\n                    min=\\\"1\\\"\\n                    value={comprimentoCm}\\n                    onChange={(e) => setComprimentoCm(e.target.value)}\\n                    placeholder=\\\"Comp\\\"\\n                    title=\\\"Comprimento em cm\\\"\\n                    className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-2 py-2.5 text-xs font-mono text-zinc-100 placeholder-zinc-500 text-center focus:outline-none focus:border-emerald-500 transition\\\"\\n                  />\\n                  <input\\n                    type=\\\"number\\\"\\n                    required\\n                    min=\\\"1\\\"\\n                    value={larguraCm}\\n                    onChange={(e) => setLarguraCm(e.target.value)}\\n                    placeholder=\\\"Larg\\\"\\n                    title=\\\"Largura em cm\\\"\\n                    className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-2 py-2.5 text-xs font-mono text-zinc-100 placeholder-zinc-500 text-center focus:outline-none focus:border-emerald-500 transition\\\"\\n                  />\\n                  <input\\n                    type=\\\"number\\\"\\n                    required\\n                    min=\\\"1\\\"\\n                    value={alturaCm}\\n                    onChange={(e) => setAlturaCm(e.target.value)}\\n                    placeholder=\\\"Alt\\\"\\n                    title=\\\"Altura em cm\\\"\\n                    className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-2 py-2.5 text-xs font-mono text-zinc-100 placeholder-zinc-500 text-center focus:outline-none focus:border-emerald-500 transition\\\"\\n                  />\\n                </div>\\n                <span className=\\\"text-[11px] text-zinc-500 mt-1 block font-mono\\\">\\n                  {comprimentoCm}x{larguraCm}x{alturaCm} cm\\n                </span>\\n              </div>\\n\\n            </div>\\n\\n            {/* Barra de resumo de cubagem e bot\303\243o de c\303\241lculo */}\\n            <div className=\\\"pt-4 border-t border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4\\\">\\n              <div className=\\\"flex items-center gap-4 text-xs font-mono text-zinc-400\\\">\\n                <span className=\\\"flex items-center gap-1.5 text-zinc-300\\\">\\n                  <Layers className=\\\"w-4 h-4 text-emerald-400\\\" />\\n                  <span>Volume: {cubagemM3} m\302\263</span>\\n                </span>\\n                <span className=\\\"text-zinc-600\\\">\342\200\242</span>\\n                <span>Peso taxado estimado: {pesoCubadoKg} kg</span>\\n              </div>\\n\\n              <button\\n                type=\\\"submit\\\"\\n                disabled={calculating}\\n                className=\\\"w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-400 disabled:opacity-75 text-zinc-950 font-medium px-6 py-2.5 rounded-lg text-sm transition-all duration-150 shadow-sm cursor-pointer\\\"\\n              >\\n                {calculating ? (\\n                  <>\\n                    <RefreshCw className=\\\"w-4 h-4 animate-spin text-zinc-950\\\" />\\n                    <span>Processando tabelas...</span>\\n                  </>\\n                ) : (\\n                  <>\\n                    <span>Calcular op\303\247\303\265es de envio</span>\\n                    <ArrowRight className=\\\"w-4 h-4 text-zinc-950\\\" />\\n                  </>\\n                )}\\n              </button>\\n            </div>\\n          </form>\\n\\n          {/* RESULTADOS DA SIMULA\303\207\303\203O */}\\n          <div className=\\\"mt-8 pt-8 border-t border-zinc-800\\\">\\n            <div className=\\\"flex items-center justify-between mb-4\\\">\\n              <span className=\\\"text-xs font-medium text-zinc-300\\\">\\n                Op\303\247\303\265es dispon\303\255veis para contrata\303\247\303\243o\\n              </span>\\n              <span className=\\\"text-xs text-zinc-500\\\">\\n                Tabelas integradas em tempo real\\n              </span>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-4\\\">\\n              {quoteResults.map((quote) => (\\n                <div\\n                  key={quote.id}\\n                  className={`rounded-xl p-5 border transition flex flex-col justify-between ${\\n                    quote.badgeType === \'best-price\'\\n                      ? \'bg-zinc-950/80 border-emerald-500/40\'\\n                      : \'bg-zinc-950/50 border-zinc-800/90 hover:border-zinc-700\'\\n                  }`}\\n                >\\n                  <div>\\n                    {/* Header do card com tag discreta */}\\n                    <div className=\\\"flex items-center justify-between mb-3 min-h-[22px]\\\">\\n                      {quote.badge ? (\\n                        <span\\n                          className={`text-[11px] font-medium px-2 py-0.5 rounded ${\\n                            quote.badgeType === \'best-price\'\\n                              ? \'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\'\\n                              : \'bg-zinc-800 text-zinc-300 border border-zinc-700\'\\n                          }`}\\n                        >\\n                          {quote.badge}\\n                        </span>\\n                      ) : (\\n                        <span className=\\\"text-[11px] font-mono text-zinc-500\\\">\\n                          Linha direta\\n                        </span>\\n                      )}\\n                    </div>\\n\\n                    <h3 className=\\\"text-base font-semibold text-white mb-1\\\">\\n                      {quote.carrierName}\\n                    </h3>\\n                    <p className=\\\"text-xs text-zinc-400 mb-4\\\">{quote.modality}</p>\\n\\n                    <div className=\\\"space-y-2 py-3 border-y border-zinc-800 text-xs mb-4\\\">\\n                      <div className=\\\"flex justify-between text-zinc-300\\\">\\n                        <span className=\\\"text-zinc-500\\\">Prazo estimado:</span>\\n                        <span className=\\\"font-medium text-zinc-200\\\">{quote.transitTimeText}</span>\\n                      </div>\\n                      <div className=\\\"flex justify-between text-zinc-300\\\">\\n                        <span className=\\\"text-zinc-500\\\">Seguro de carga:</span>\\n                        <span className=\\\"text-zinc-300\\\">Incluso no c\303\241lculo</span>\\n                      </div>\\n                    </div>\\n                  </div>\\n\\n                  <div>\\n                    <div className=\\\"mb-4\\\">\\n                      <span className=\\\"text-[11px] text-zinc-500 block\\\">Valor do frete</span>\\n                      <span className=\\\"text-2xl font-semibold font-mono text-white\\\">\\n                        R$ {quote.price.toFixed(2).replace(\'.\', \',\')}\\n                      </span>\\n                    </div>\\n\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => onSelectQuote(quote)}\\n                      className={`w-full py-2.5 px-3 rounded-lg text-xs font-medium transition flex items-center justify-center gap-1.5 cursor-pointer ${\\n                        quote.badgeType === \'best-price\'\\n                          ? \'bg-emerald-500 hover:bg-emerald-400 text-zinc-950\'\\n                          : \'bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700\'\\n                      }`}\\n                    >\\n                      <span>Contratar frete</span>\\n                      <ArrowRight className=\\\"w-3.5 h-3.5\\\" />\\n                    </button>\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n\\n        </div>\\n\\n      </div>\\n    </section>\\n  );\\n};\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/components/FreightSimulator.tsx\", \"toolAction\":\"Updating FreightSimulator.tsx to exact specification\", \"toolSummary\":\"Update FreightSimulator\"}"
