  file_change {
    absolute_path_uri: "file:///src/components/Modals.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { X, CheckCircle2, ArrowRight, Layers, RefreshCw } from \'lucide-react\';\nimport { QuoteOption } from \'../types\';\n\ninterface ModalsProps {\n  loginOpen: boolean;\n  onCloseLogin: () => void;\n  registerOpen: boolean;\n  onCloseRegister: () => void;\n  registerDefaultType?: \'embarcador\' | \'transportadora\';\n  simulatorOpen: boolean;\n  onCloseSimulator: () => void;\n  selectedQuote: QuoteOption | null;\n  onCloseQuoteModal: () => void;\n  onSelectQuote: (quote: QuoteOption) => void;\n  onOpenRegisterFromLogin?: () => void;\n}\n\nexport const Modals: React.FC<ModalsProps> = ({\n  loginOpen,\n  onCloseLogin,\n  registerOpen,\n  onCloseRegister,\n  registerDefaultType = \'embarcador\',\n  simulatorOpen,\n  onCloseSimulator,\n  selectedQuote,\n  onCloseQuoteModal,\n  onSelectQuote,\n  onOpenRegisterFromLogin,\n}) => {\n  // Login State\n  const [loginEmail, setLoginEmail] = useState(\'\');\n  const [loginPassword, setLoginPassword] = useState(\'\');\n  const [loginSuccess, setLoginSuccess] = useState(false);\n\n  // Register State\n  const [regName, setRegName] = useState(\'\');\n  const [regCnpj, setRegCnpj] = useState(\'\');\n  const [regEmail, setRegEmail] = useState(\'\');\n  const [regType, setRegType] = useState<\'embarcador\' | \'transportadora\'>(registerDefaultType);\n  const [regSuccess, setRegSuccess] = useState(false);\n\n  // Simulator State\n  const [cepOrigem, setCepOrigem] = useState(\'01001-000\');\n  const [cepDestino, setCepDestino] = useState(\'80010-000\');\n  const [pesoKg, setPesoKg] = useState(\'35\');\n  const [comprimentoCm, setComprimentoCm] = useState(\'60\');\n  const [larguraCm, setLarguraCm] = useState(\'40\');\n  const [alturaCm, setAlturaCm] = useState(\'50\');\n  const [calculating, setCalculating] = useState(false);\n  const [volumeM3Text, setVolumeM3Text] = useState(\'0,120\');\n  const [pesoTaxadoText, setPesoTaxadoText] = useState(\'36,0\');\n\n  const [quoteResults, setQuoteResults] = useState<QuoteOption[]>([\n    {\n      id: \'quote-1\',\n      carrierName: \'Expresso S\303\243o Paulo\',\n      badge: \'Melhor pre\303\247o\',\n      badgeType: \'best-price\',\n      transitDays: 4,\n      transitTimeText: \'3 a 4 dias \303\272teis\',\n      price: 138.5,\n      modality: \'Carga fracionada standard\',\n      coverage: \'Cobertura com seguro RCTR-C\',\n    },\n    {\n      id: \'quote-2\',\n      carrierName: \'VeloExpress Cargas\',\n      badge: \'Mais r\303\241pido\',\n      badgeType: \'fastest\',\n      transitDays: 1,\n      transitTimeText: \'1 a 2 dias \303\272teis\',\n      price: 212.0,\n      modality: \'Expresso rodovi\303\241rio priorit\303\241rio\',\n      coverage: \'Cobertura com seguro RCTR-C\',\n    },\n    {\n      id: \'quote-3\',\n      carrierName: \'TransSul Linha Direta\',\n      badgeType: \'standard\',\n      transitDays: 3,\n      transitTimeText: \'2 a 3 dias \303\272teis\',\n      price: 165.0,\n      modality: \'Linha direta regular\',\n      coverage: \'Cobertura com seguro RCTR-C\',\n    },\n  ]);\n\n  // Contract State\n  const [contractSuccess, setContractSuccess] = useState(false);\n  const [nfeKey, setNfeKey] = useState(\'\');\n\n  const handleLoginSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoginSuccess(true);\n    setTimeout(() => {\n      setLoginSuccess(false);\n      onCloseLogin();\n    }, 1400);\n  };\n\n  const handleRegisterSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setRegSuccess(true);\n    setTimeout(() => {\n      setRegSuccess(false);\n      onCloseRegister();\n    }, 1600);\n  };\n\n  const handleSimulatorCalculate = (e: React.FormEvent) => {\n    e.preventDefault();\n    setCalculating(true);\n\n    const c = parseFloat(comprimentoCm) || 60;\n    const l = parseFloat(larguraCm) || 40;\n    const a = parseFloat(alturaCm) || 50;\n    const realWeight = parseFloat(pesoKg) || 35;\n\n    const volumeM3 = (c * l * a) / 1000000;\n    const cubado = volumeM3 * 300;\n    const pesoTaxado = Math.max(realWeight, cubado);\n\n    setTimeout(() => {\n      setVolumeM3Text(volumeM3.toFixed(3).replace(\'.\', \',\'));\n      setPesoTaxadoText(pesoTaxado.toFixed(1).replace(\'.\', \',\'));\n\n      const factor = pesoTaxado / 36;\n      setQuoteResults([\n        {\n          id: \'quote-1\',\n          carrierName: \'Expresso S\303\243o Paulo\',\n          badge: \'Melhor pre\303\247o\',\n          badgeType: \'best-price\',\n          transitDays: 4,\n          transitTimeText: \'3 a 4 dias \303\272teis\',\n          price: Math.round(138.5 * factor * 10) / 10,\n          modality: \'Carga fracionada standard\',\n          coverage: \'Cobertura com seguro RCTR-C\',\n        },\n        {\n          id: \'quote-2\',\n          carrierName: \'VeloExpress Cargas\',\n          badge: \'Mais r\303\241pido\',\n          badgeType: \'fastest\',\n          transitDays: 1,\n          transitTimeText: \'1 a 2 dias \303\272teis\',\n          price: Math.round(212.0 * factor * 10) / 10,\n          modality: \'Expresso rodovi\303\241rio priorit\303\241rio\',\n          coverage: \'Cobertura com seguro RCTR-C\',\n        },\n        {\n          id: \'quote-3\',\n          carrierName: \'TransSul Linha Direta\',\n          badgeType: \'standard\',\n          transitDays: 3,\n          transitTimeText: \'2 a 3 dias \303\272teis\',\n          price: Math.round(165.0 * factor * 10) / 10,\n          modality: \'Linha direta regular\',\n          coverage: \'Cobertura com seguro RCTR-C\',\n        },\n      ]);\n      setCalculating(false);\n    }, 350);\n  };\n\n  const handleContractSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setContractSuccess(true);\n    setTimeout(() => {\n      setContractSuccess(false);\n      onCloseQuoteModal();\n    }, 1600);\n  };\n\n  return (\n    <>\n      {/* 1. MODAL DE LOGIN (/login) */}\n      {loginOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-900/40 backdrop-blur-sm animate-in fade-in duration-200\">\n          <div className=\"relative w-full max-w-md bg-white border border-zinc-200 rounded-2xl p-6 sm:p-8 shadow-xl text-zinc-900\">\n            <button\n              onClick={onCloseLogin}\n              className=\"absolute top-4 right-4 p-2 text-zinc-400 hover:text-zinc-700 rounded-lg hover:bg-zinc-100 transition cursor-pointer\"\n              aria-label=\"Fechar\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            {loginSuccess ? (\n              <div className=\"py-8 text-center space-y-3\">\n                <div className=\"w-12 h-12 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-600 mx-auto flex items-center justify-center\">\n                  <CheckCircle2 className=\"w-6 h-6\" />\n                </div>\n                <h3 className=\"text-xl font-semibold text-zinc-900\">Acesso autorizado</h3>\n                <p className=\"text-sm text-zinc-600\">\n                  Carregando seu ambiente de cota\303\247\303\243o...\n                </p>\n              </div>\n            ) : (\n              <div>\n                <h2 className=\"text-2xl font-semibold tracking-tight text-zinc-900 mb-2\">Entrar na LogiFlow</h2>\n                <p className=\"text-sm text-zinc-600 mb-6\">\n                  Informe suas credenciais corporativas de embarcador ou transportadora.\n                </p>\n\n                <form onSubmit={handleLoginSubmit} className=\"space-y-4\">\n                  <div>\n                    <label className=\"block text-xs font-medium text-zinc-700 mb-1.5\">\n                      E-mail corporativo\n                    </label>\n                    <input\n                      type=\"email\"\n                      required\n                      placeholder=\"seu.nome@empresa.com.br\"\n                      value={loginEmail}\n                      onChange={(e) => setLoginEmail(e.target.value)}\n                      className=\"w-full bg-white border border-zinc-300 rounded-lg px-3.5 py-2.5 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 transition\"\n                    />\n                  </div>\n\n                  <div>\n                    <div className=\"flex items-center justify-between mb-1.5\">\n                      <label className=\"block text-xs font-medium text-zinc-700\">\n                        Senha\n                      </label>\n                      <a href=\"#recuperar\" onClick={(e) => e.preventDefault()} className=\"text-xs text-amber-600 hover:text-amber-700 transition\">\n                        Esqueceu a senha?\n                      </a>\n                    </div>\n                    <input\n                      type=\"password\"\n                      required\n                      placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                      value={loginPassword}\n                      onChange={(e) => setLoginPassword(e.target.value)}\n                      className=\"w-full bg-white border border-zinc-300 rounded-lg px-3.5 py-2.5 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 transition\"\n                    />\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    className=\"w-full mt-2 bg-zinc-900 hover:bg-zinc-800 text-white font-medium py-2.5 px-4 rounded-lg text-sm transition-all duration-150 shadow-sm cursor-pointer\"\n                  >\n                    Acessar sistema\n                  </button>\n                </form>\n\n                <div className=\"mt-6 pt-5 border-t border-zinc-100 text-center\">\n                  <p className=\"text-xs text-zinc-600\">\n                    Sua empresa ainda n\303\243o possui conta?{\' \'}\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        onCloseLogin();\n                        if (onOpenRegisterFromLogin) onOpenRegisterFromLogin();\n                      }}\n                      className=\"text-amber-600 hover:text-amber-700 font-medium ml-1 cursor-pointer\"\n                    >\n                      Cadastrar empresa\n                    </button>\n                  </p>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* 2. MODAL DE CADASTRO DE TENANT (/register) */}\n      {registerOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-900/40 backdrop-blur-sm animate-in fade-in duration-200\">\n          <div className=\"relative w-full max-w-lg bg-white border border-zinc-200 rounded-2xl p-6 sm:p-8 shadow-xl text-zinc-900 max-h-[90vh] overflow-y-auto\">\n            <button\n              onClick={onCloseRegister}\n              className=\"absolute top-4 right-4 p-2 text-zinc-400 hover:text-zinc-700 rounded-lg hover:bg-zinc-100 transition cursor-pointer\"\n              aria-label=\"Fechar\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            {regSuccess ? (\n              <div className=\"py-8 text-center space-y-3\">\n                <div className=\"w-12 h-12 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-600 mx-auto flex items-center justify-center\">\n                  <CheckCircle2 className=\"w-6 h-6\" />\n                </div>\n                <h3 className=\"text-xl font-semibold text-zinc-900\">Cadastro recebido</h3>\n                <p className=\"text-sm text-zinc-600\">\n                  Os dados foram registrados para homologa\303\247\303\243o da sua conta corporativa.\n                </p>\n              </div>\n            ) : (\n              <div>\n                <h2 className=\"text-2xl font-semibold tracking-tight text-zinc-900 mb-2\">Cadastrar empresa</h2>\n                <p className=\"text-sm text-zinc-600 mb-6\">\n                  Selecione o seu perfil de opera\303\247\303\243o para configurar o ambiente do seu neg\303\263cio.\n                </p>\n\n                <form onSubmit={handleRegisterSubmit} className=\"space-y-4\">\n                  <div>\n                    <label className=\"block text-xs font-medium text-zinc-700 mb-1.5\">\n                      Tipo de empresa\n                    </label>\n                    <div className=\"grid grid-cols-2 gap-2\">\n                      <button\n                        type=\"button\"\n                        onClick={() => setRegType(\'embarcador\')}\n                        className={`py-2 px-3 text-xs font-medium rounded-lg border text-center transition cursor-pointer ${\n                          regType === \'embarcador\'\n                            ? \'bg-amber-50 border-amber-500 text-amber-900\'\n                            : \'bg-white border-zinc-300 text-zinc-600 hover:border-zinc-400\'\n                        }`}\n                      >\n                        Embarcador\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => setRegType(\'transportadora\')}\n                        className={`py-2 px-3 text-xs font-medium rounded-lg border text-center transition cursor-pointer ${\n                          regType === \'transportadora\'\n                            ? \'bg-amber-50 border-amber-500 text-amber-900\'\n                            : \'bg-white border-zinc-300 text-zinc-600 hover:border-zinc-400\'\n                        }`}\n                      >\n                        Transportadora parceira\n                      </button>\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-medium text-zinc-700 mb-1.5\">\n                      Raz\303\243o social\n                    </label>\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"Nome completo da empresa\"\n                      value={regName}\n                      onChange={(e) => setRegName(e.target.value)}\n                      className=\"w-full bg-white border border-zinc-300 rounded-lg px-3.5 py-2.5 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 transition\"\n                    />\n                  </div>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                    <div>\n                      <label className=\"block text-xs font-medium text-zinc-700 mb-1.5\">\n                        CNPJ\n                      </label>\n                      <input\n                        type=\"text\"\n                        required\n                        placeholder=\"00.000.000/0001-00\"\n                        value={regCnpj}\n                        onChange={(e) => setRegCnpj(e.target.value)}\n                        className=\"w-full bg-white border border-zinc-300 rounded-lg px-3.5 py-2.5 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 transition\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"block text-xs font-medium text-zinc-700 mb-1.5\">\n                        E-mail de contato\n                      </label>\n                      <input\n                        type=\"email\"\n                        required\n                        placeholder=\"contato@empresa.com.br\"\n                        value={regEmail}\n                        onChange={(e) => setRegEmail(e.target.value)}\n                        className=\"w-full bg-white border border-zinc-300 rounded-lg px-3.5 py-2.5 text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 transition\"\n                      />\n                    </div>\n                  </div>\n\n                  <div className=\"bg-zinc-50 border border-zinc-200 rounded-lg p-3 text-xs text-zinc-600 space-y-1\">\n                    <p className=\"font-medium text-zinc-900\">Integra\303\247\303\243o de tabelas:</p>\n                    <p>\342\200\242 Valida\303\247\303\243o autom\303\241tica de CNPJ e dados cadastrais.</p>\n                    <p>\342\200\242 Painel dedicado para importa\303\247\303\243o de tabelas de frete ou emiss\303\243o direta.</p>\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    className=\"w-full mt-3 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-medium py-2.5 px-4 rounded-lg text-sm transition-all duration-150 shadow-sm flex items-center justify-center gap-2 cursor-pointer\"\n                  >\n                    <span>Concluir cadastro da empresa</span>\n                    <ArrowRight className=\"w-4 h-4 text-zinc-950\" />\n                  </button>\n                </form>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* 3. MODAL DEDICADO DE SIMULA\303\207\303\203O DE FRETE (/simular-frete) */}\n      {simulatorOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-900/40 backdrop-blur-sm animate-in fade-in duration-200\">\n          <div className=\"relative w-full max-w-4xl bg-white border border-zinc-200 rounded-2xl p-6 sm:p-8 shadow-2xl text-zinc-900 max-h-[90vh] overflow-y-auto\">\n            <button\n              onClick={onCloseSimulator}\n              className=\"absolute top-4 right-4 p-2 text-zinc-400 hover:text-zinc-700 rounded-lg hover:bg-zinc-100 transition cursor-pointer\"\n              aria-label=\"Fechar\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            <div className=\"max-w-2xl mb-6\">\n              <h2 className=\"text-2xl font-semibold tracking-tight text-zinc-900\">\n                Simulador de frete inteligente\n              </h2>\n              <p className=\"text-sm text-zinc-600 mt-1\">\n                Calcule a cubagem volum\303\251trica e consulte as tabelas ativas em tempo real.\n              </p>\n            </div>\n\n            <form onSubmit={handleSimulatorCalculate} className=\"space-y-5 bg-zinc-50 border border-zinc-200/90 rounded-xl p-5 sm:p-6 mb-6\">\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n                <div>\n                  <label className=\"block text-xs font-medium text-zinc-700 mb-1\">\n                    CEP de origem\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={cepOrigem}\n                    onChange={(e) => setCepOrigem(e.target.value)}\n                    placeholder=\"00000-000\"\n                    className=\"w-full bg-white border border-zinc-300 rounded-lg px-3 py-2 text-sm font-mono text-zinc-900 focus:outline-none focus:border-zinc-900 transition\"\n                  />\n                  <span className=\"text-[11px] text-zinc-500 mt-0.5 block\">S\303\243o Paulo, SP</span>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-medium text-zinc-700 mb-1\">\n                    CEP de destino\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={cepDestino}\n                    onChange={(e) => setCepDestino(e.target.value)}\n                    placeholder=\"00000-000\"\n                    className=\"w-full bg-white border border-zinc-300 rounded-lg px-3 py-2 text-sm font-mono text-zinc-900 focus:outline-none focus:border-zinc-900 transition\"\n                  />\n                  <span className=\"text-[11px] text-zinc-500 mt-0.5 block\">Curitiba, PR</span>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-medium text-zinc-700 mb-1\">\n                    Peso (kg)\n                  </label>\n                  <input\n                    type=\"number\"\n                    required\n                    min=\"0.5\"\n                    step=\"0.1\"\n                    value={pesoKg}\n                    onChange={(e) => setPesoKg(e.target.value)}\n                    placeholder=\"35\"\n                    className=\"w-full bg-white border border-zinc-300 rounded-lg px-3 py-2 text-sm font-mono text-zinc-900 focus:outline-none focus:border-zinc-900 transition\"\n                  />\n                  <span className=\"text-[11px] text-zinc-500 mt-0.5 block\">Peso real</span>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-medium text-zinc-700 mb-1\">\n                    Dimens\303\265es (C x L x A cm)\n                  </label>\n                  <div className=\"grid grid-cols-3 gap-1\">\n                    <input\n                      type=\"number\"\n                      required\n                      min=\"1\"\n                      value={comprimentoCm}\n                      onChange={(e) => setComprimentoCm(e.target.value)}\n                      placeholder=\"C\"\n                      className=\"w-full bg-white border border-zinc-300 rounded-lg px-1.5 py-2 text-xs font-mono text-center focus:outline-none focus:border-zinc-900 transition\"\n                    />\n                    <input\n                      type=\"number\"\n                      required\n                      min=\"1\"\n                      value={larguraCm}\n                      onChange={(e) => setLarguraCm(e.target.value)}\n                      placeholder=\"L\"\n                      className=\"w-full bg-white border border-zinc-300 rounded-lg px-1.5 py-2 text-xs font-mono text-center focus:outline-none focus:border-zinc-900 transition\"\n                    />\n                    <input\n                      type=\"number\"\n                      required\n                      min=\"1\"\n                      value={alturaCm}\n                      onChange={(e) => setAlturaCm(e.target.value)}\n                      placeholder=\"A\"\n                      className=\"w-full bg-white border border-zinc-300 rounded-lg px-1.5 py-2 text-xs font-mono text-center focus:outline-none focus:border-zinc-900 transition\"\n                    />\n                  </div>\n                  <span className=\"text-[11px] text-zinc-500 mt-0.5 block font-mono\">\n                    {comprimentoCm}x{larguraCm}x{alturaCm} cm\n                  </span>\n                </div>\n              </div>\n\n              <div className=\"pt-3 border-t border-zinc-200 flex flex-col sm:flex-row items-center justify-between gap-3\">\n                <div className=\"flex items-center gap-3 text-xs font-mono text-zinc-600\">\n                  <span className=\"flex items-center gap-1.5 text-zinc-800\">\n                    <Layers className=\"w-4 h-4 text-amber-600\" />\n                    <span>Volume: {volumeM3Text} m\302\263</span>\n                  </span>\n                  <span>\342\200\242</span>\n                  <span>Peso cubado: {pesoTaxadoText} kg</span>\n                </div>\n\n                <button\n                  type=\"submit\"\n                  disabled={calculating}\n                  className=\"w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-400 disabled:opacity-75 text-zinc-950 font-medium px-5 py-2.5 rounded-lg text-sm transition-all duration-150 shadow-sm cursor-pointer\"\n                >\n                  {calculating ? (\n                    <>\n                      <RefreshCw className=\"w-4 h-4 animate-spin text-zinc-950\" />\n                      <span>Consultando tabelas...</span>\n                    </>\n                  ) : (\n                    <>\n                      <span>Calcular op\303\247\303\265es de envio</span>\n                      <ArrowRight className=\"w-4 h-4 text-zinc-950\" />\n                    </>\n                  )}\n                </button>\n              </div>\n            </form>\n\n            {/* Resultados das cota\303\247\303\265es */}\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center justify-between text-xs text-zinc-500 px-1\">\n                <span>Op\303\247\303\265es homologadas para a rota</span>\n                <span>Pre\303\247os finais com impostos inclusos</span>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                {quoteResults.map((quote) => (\n                  <div\n                    key={quote.id}\n                    className={`bg-white border rounded-xl p-5 flex flex-col justify-between transition-all ${\n                      quote.badgeType === \'best-price\'\n                        ? \'border-amber-500/70 shadow-sm shadow-amber-500/10\'\n                        : \'border-zinc-200 hover:border-zinc-300\'\n                    }`}\n                  >\n                    <div>\n                      <div className=\"flex items-center justify-between mb-3 min-h-[20px]\">\n                        {quote.badge ? (\n                          <span\n                            className={`text-[11px] font-medium px-2 py-0.5 rounded ${\n                              quote.badgeType === \'best-price\'\n                                ? \'bg-amber-50 text-amber-800 border border-amber-200\'\n                                : \'bg-zinc-100 text-zinc-700 border border-zinc-200\'\n                            }`}\n                          >\n                            {quote.badge}\n                          </span>\n                        ) : (\n                          <span className=\"text-[11px] font-mono text-zinc-400\">Linha direta</span>\n                        )}\n                      </div>\n\n                      <h3 className=\"text-base font-semibold text-zinc-900 mb-1\">\n                        {quote.carrierName}\n                      </h3>\n                      <p className=\"text-xs text-zinc-500 mb-4\">{quote.modality}</p>\n\n                      <div className=\"space-y-1.5 py-2.5 border-y border-zinc-100 text-xs mb-4 text-zinc-600\">\n                        <div className=\"flex justify-between\">\n                          <span className=\"text-zinc-500\">Prazo:</span>\n                          <span className=\"font-medium text-zinc-900\">{quote.transitTimeText}</span>\n                        </div>\n                        <div className=\"flex justify-between\">\n                          <span className=\"text-zinc-500\">Seguro:</span>\n                          <span>Incluso</span>\n                        </div>\n                      </div>\n                    </div>\n\n                    <div>\n                      <div className=\"mb-4\">\n                        <span className=\"text-[11px] text-zinc-400 block\">Valor do frete</span>\n                        <span className=\"text-2xl font-semibold font-mono text-zinc-900\">\n                          R$ {quote.price.toFixed(2).replace(\'.\', \',\')}\n                        </span>\n                      </div>\n\n                      <button\n                        type=\"button\"\n                        onClick={() => {\n                          onCloseSimulator();\n                          onSelectQuote(quote);\n                        }}\n                        className={`w-full py-2.5 px-3 rounded-lg text-xs font-medium transition flex items-center justify-center gap-1.5 cursor-pointer ${\n                          quote.badgeType === \'best-price\'\n                            ? \'bg-amber-500 hover:bg-amber-400 text-zinc-950 font-medium\'\n                            : \'bg-zinc-900 hover:bg-zinc-800 text-white\'\n                        }`}\n                      >\n                        <span>Contratar frete</span>\n                        <ArrowRight className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n          </div>\n        </div>\n      )}\n\n      {/* 4. MODAL DE CONTRATA\303\207\303\203O DE FRETE */}\n      {selectedQuote && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-900/40 backdrop-blur-sm animate-in fade-in duration-200\">\n          <div className=\"relative w-full max-w-md bg-white border border-zinc-200 rounded-2xl p-6 shadow-xl text-zinc-900\">\n            <button\n              onClick={onCloseQuoteModal}\n              className=\"absolute top-4 right-4 p-2 text-zinc-400 hover:text-zinc-700 rounded-lg hover:bg-zinc-100 transition cursor-pointer\"\n              aria-label=\"Fechar\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            {contractSuccess ? (\n              <div className=\"py-8 text-center space-y-3\">\n                <div className=\"w-12 h-12 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-600 mx-auto flex items-center justify-center\">\n                  <CheckCircle2 className=\"w-6 h-6\" />\n                </div>\n                <h3 className=\"text-xl font-semibold text-zinc-900\">Frete contratado</h3>\n                <p className=\"text-xs font-mono text-zinc-600\">\n                  Solicita\303\247\303\243o encaminhada para {selectedQuote.carrierName}.\n                </p>\n                <p className=\"text-xs text-zinc-500\">\n                  A minuta de despacho e o comprovante foram disponibilizados.\n                </p>\n              </div>\n            ) : (\n              <div>\n                <div className=\"flex items-center justify-between mb-3\">\n                  <span className=\"text-xs font-mono px-2 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200\">\n                    Contrata\303\247\303\243o direta\n                  </span>\n                  <span className=\"text-xs text-zinc-500\">{selectedQuote.transitTimeText}</span>\n                </div>\n\n                <h3 className=\"text-xl font-semibold text-zinc-900 mb-1\">\n                  {selectedQuote.carrierName}\n                </h3>\n                <p className=\"text-xs text-zinc-500 mb-4\">\n                  Modalidade: {selectedQuote.modality}\n                </p>\n\n                <div className=\"bg-zinc-50 border border-zinc-200 rounded-lg p-4 mb-4 space-y-2 text-xs\">\n                  <div className=\"flex justify-between items-center\">\n                    <span className=\"text-zinc-500\">Valor total do frete:</span>\n                    <span className=\"font-semibold text-base font-mono text-zinc-900\">\n                      R$ {selectedQuote.price.toFixed(2).replace(\'.\', \',\')}\n                    </span>\n                  </div>\n                  <div className=\"flex justify-between items-center text-zinc-600\">\n                    <span>Seguro da mercadoria:</span>\n                    <span className=\"text-emerald-700 font-mono\">Incluso</span>\n                  </div>\n                </div>\n\n                <form onSubmit={handleContractSubmit} className=\"space-y-4\">\n                  <div>\n                    <label className=\"block text-xs font-medium text-zinc-700 mb-1\">\n                      Chave da NF-e ou identificador da carga\n                    </label>\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"Ex: 3524 0900 0000 0000 0000 5500 1000 0000 0012 3456\"\n                      value={nfeKey}\n                      onChange={(e) => setNfeKey(e.target.value)}\n                      className=\"w-full bg-white border border-zinc-300 rounded-lg px-3 py-2 text-xs font-mono text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 transition\"\n                    />\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    className=\"w-full bg-amber-500 hover:bg-amber-400 text-zinc-950 font-medium py-2.5 px-4 rounded-lg text-sm transition-all duration-150 shadow-sm cursor-pointer\"\n                  >\n                    Confirmar contrata\303\247\303\243o de frete\n                  </button>\n                </form>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </>\n  );\n};\n"
    }
