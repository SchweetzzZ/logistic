  view_file {
    absolute_path_uri: "file:///src/components/Modals.tsx"
    end_line: 379
    content: "import React, { useState } from \'react\';\nimport { X, CheckCircle2, ArrowRight } from \'lucide-react\';\nimport { QuoteOption } from \'../types\';\n\ninterface ModalsProps {\n  loginOpen: boolean;\n  onCloseLogin: () => void;\n  registerOpen: boolean;\n  onCloseRegister: () => void;\n  selectedQuote: QuoteOption | null;\n  onCloseQuoteModal: () => void;\n  onOpenRegisterFromLogin?: () => void;\n}\n\nexport const Modals: React.FC<ModalsProps> = ({\n  loginOpen,\n  onCloseLogin,\n  registerOpen,\n  onCloseRegister,\n  selectedQuote,\n  onCloseQuoteModal,\n  onOpenRegisterFromLogin,\n}) => {\n  const [loginEmail, setLoginEmail] = useState(\'\');\n  const [loginPassword, setLoginPassword] = useState(\'\');\n  const [loginSuccess, setLoginSuccess] = useState(false);\n\n  const [regName, setRegName] = useState(\'\');\n  const [regCnpj, setRegCnpj] = useState(\'\');\n  const [regEmail, setRegEmail] = useState(\'\');\n  const [regType, setRegType] = useState(\'embarcador\');\n  const [regSuccess, setRegSuccess] = useState(false);\n\n  const [contractSuccess, setContractSuccess] = useState(false);\n\n  // Login submit handler\n  const handleLoginSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoginSuccess(true);\n    setTimeout(() => {\n      setLoginSuccess(false);\n      onCloseLogin();\n    }, 1800);\n  };\n\n  // Register submit handler\n  const handleRegisterSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setRegSuccess(true);\n    setTimeout(() => {\n      setRegSuccess(false);\n      onCloseRegister();\n    }, 2000);\n  };\n\n  // Contract freight submit handler\n  const handleContractSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setContractSuccess(true);\n    setTimeout(() => {\n      setContractSuccess(false);\n      onCloseQuoteModal();\n    }, 2200);\n  };\n\n  return (\n    <>\n      {/* LOGIN MODAL */}\n      {loginOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200\">\n          <div className=\"relative w-full max-w-md bg-zinc-900 border border-zinc-800 rounded-xl p-6 md:p-8 shadow-2xl text-zinc-100\">\n            <button\n              onClick={onCloseLogin}\n              className=\"absolute top-4 right-4 p-2 text-zinc-400 hover:text-zinc-200 rounded-lg hover:bg-zinc-800 transition\"\n              aria-label=\"Fechar\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            {loginSuccess ? (\n              <div className=\"py-8 text-center space-y-3\">\n                <div className=\"w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 mx-auto flex items-center justify-center\">\n                  <CheckCircle2 className=\"w-6 h-6\" />\n                </div>\n                <h3 className=\"text-xl font-semibold text-zinc-100\">Autentica\303\247\303\243o autorizada</h3>\n                <p className=\"text-sm text-zinc-400\">\n                  Redirecionando com seguran\303\247a para o Console LogiFlow Enterprise...\n                </p>\n              </div>\n            ) : (\n              <div>\n                <div className=\"flex items-center gap-2 mb-6\">\n                  <div className=\"w-2.5 h-2.5 rounded-full bg-emerald-500\" />\n                  <span className=\"text-xs font-mono uppercase tracking-wider text-zinc-400\">Portal do Cliente</span>\n                </div>\n\n                <h2 className=\"text-2xl font-bold tracking-tight text-white mb-2\">Acessar plataforma</h2>\n                <p className=\"text-sm text-zinc-400 mb-6\">\n                  Insira suas credenciais corporativas ou autentique-se via Single Sign-On (SSO).\n                </p>\n\n                <form onSubmit={handleLoginSubmit} className=\"space-y-4\">\n                  <div>\n                    <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                      E-mail corporativo\n                    </label>\n                    <input\n                      type=\"email\"\n                      required\n                      placeholder=\"nome@empresa.com.br\"\n                      value={loginEmail}\n                      onChange={(e) => setLoginEmail(e.target.value)}\n                      className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                    />\n                  </div>\n\n                  <div>\n                    <div className=\"flex items-center justify-between mb-1.5\">\n                      <label className=\"block text-xs font-medium text-zinc-300\">\n                        Senha de acesso\n                      </label>\n                      <a href=\"#recuperar\" onClick={(e) => e.preventDefault()} className=\"text-xs text-zinc-400 hover:text-emerald-400 transition\">\n                        Esqueceu a senha?\n                      </a>\n                    </div>\n                    <input\n                      type=\"password\"\n                      required\n                      placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                      value={loginPassword}\n                      onChange={(e) => setLoginPassword(e.target.value)}\n                      className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                    />\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    className=\"w-full mt-2 bg-emerald-500 hover:bg-emerald-400 active:scale-[0.99] text-zinc-950 font-semibold py-2.5 px-4 rounded-lg text-sm transition-all duration-150 shadow-sm\"\n                  >\n                    Entrar no sistema\n                  </button>\n                </form>\n\n                <div className=\"mt-6 pt-5 border-t border-zinc-800/80 text-center\">\n                  <p className=\"text-xs text-zinc-400\">\n                    Sua empresa ainda n\303\243o possui conta?{\' \'}\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        onCloseLogin();\n                        if (onOpenRegisterFromLogin) onOpenRegisterFromLogin();\n                      }}\n                      className=\"text-emerald-400 hover:text-emerald-300 font-medium ml-1\"\n                    >\n                      Cadastrar empresa parceira\n                    </button>\n                  </p>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* REGISTER / PARTNER MODAL */}\n      {registerOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200\">\n          <div className=\"relative w-full max-w-lg bg-zinc-900 border border-zinc-800 rounded-xl p-6 md:p-8 shadow-2xl text-zinc-100 max-h-[90vh] overflow-y-auto\">\n            <button\n              onClick={onCloseRegister}\n              className=\"absolute top-4 right-4 p-2 text-zinc-400 hover:text-zinc-200 rounded-lg hover:bg-zinc-800 transition\"\n              aria-label=\"Fechar\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            {regSuccess ? (\n              <div className=\"py-8 text-center space-y-3\">\n                <div className=\"w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 mx-auto flex items-center justify-center\">\n                  <CheckCircle2 className=\"w-6 h-6\" />\n                </div>\n                <h3 className=\"text-xl font-semibold text-zinc-100\">Solicita\303\247\303\243o enviada com sucesso</h3>\n                <p className=\"text-sm text-zinc-400\">\n                  Um especialista de parcerias corporativas da LogiFlow entrar\303\241 em contato em at\303\251 2 horas \303\272teis.\n                </p>\n              </div>\n            ) : (\n              <div>\n                <div className=\"flex items-center gap-2 mb-4\">\n                  <span className=\"px-2 py-0.5 text-[11px] font-mono rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\">\n                    Onboarding Corporativo\n                  </span>\n                </div>\n\n                <h2 className=\"text-2xl font-bold tracking-tight text-white mb-2\">Cadastrar empresa parceira</h2>\n                <p className=\"text-sm text-zinc-400 mb-6\">\n                  Integre sua transportadora \303\240 nossa malha ou obtenha acesso de embarcador com tabelas exclusivas.\n                </p>\n\n                <form onSubmit={handleRegisterSubmit} className=\"space-y-4\">\n                  <div>\n                    <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                      Tipo de opera\303\247\303\243o\n                    </label>\n                    <div className=\"grid grid-cols-2 gap-2\">\n                      <button\n                        type=\"button\"\n                        onClick={() => setRegType(\'embarcador\')}\n                        className={`py-2 px-3 text-xs font-medium rounded-lg border text-center transition ${\n                          regType === \'embarcador\'\n                            ? \'bg-zinc-800 border-emerald-500 text-emerald-300\'\n                            : \'bg-zinc-950 border-zinc-800 text-zinc-400 hover:border-zinc-700\'\n                        }`}\n                      >\n                        Sou Embarcador (Ind\303\272stria/Com\303\251rcio)\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => setRegType(\'transportador\')}\n                        className={`py-2 px-3 text-xs font-medium rounded-lg border text-center transition ${\n                          regType === \'transportador\'\n                            ? \'bg-zinc-800 border-emerald-500 text-emerald-300\'\n                            : \'bg-zinc-950 border-zinc-800 text-zinc-400 hover:border-zinc-700\'\n                        }`}\n                      >\n                        Sou Transportador / Frotista\n                      </button>\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                      Raz\303\243o social ou nome da empresa\n                    </label>\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"Ex: Log\303\255stica R\303\241pida Nacional Ltda\"\n                      value={regName}\n                      onChange={(e) => setRegName(e.target.value)}\n                      className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                    />\n                  </div>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                    <div>\n                      <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                        CNPJ\n                      </label>\n                      <input\n                        type=\"text\"\n                        required\n                        placeholder=\"00.000.000/0001-00\"\n                        value={regCnpj}\n                        onChange={(e) => setRegCnpj(e.target.value)}\n                        className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                        E-mail de contato corporativo\n                      </label>\n                      <input\n                        type=\"email\"\n                        required\n                        placeholder=\"contato@empresa.com.br\"\n                        value={regEmail}\n                        onChange={(e) => setRegEmail(e.target.value)}\n                        className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                      />\n                    </div>\n                  </div>\n\n                  <div className=\"bg-zinc-950/70 border border-zinc-800 rounded-lg p-3 text-xs text-zinc-400 space-y-1\">\n                    <p className=\"font-medium text-zinc-300\">Garantias LogiFlow:</p>\n                    <p>\342\200\242 Homologa\303\247\303\243o em conformidade com ANTT e emiss\303\243o autom\303\241tica de CT-e / MDF-e.</p>\n                    <p>\342\200\242 Gest\303\243o de fretes sem taxas ocultas ou mensalidades surpresa.</p>\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    className=\"w-full mt-3 bg-emerald-500 hover:bg-emerald-400 active:scale-[0.99] text-zinc-950 font-semibold py-2.5 px-4 rounded-lg text-sm transition-all duration-150 shadow-sm flex items-center justify-center gap-2\"\n                  >\n                    <span>Finalizar pr\303\251-cadastro corporativo</span>\n                    <ArrowRight className=\"w-4 h-4\" />\n                  </button>\n                </form>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* FREIGHT CONTRACT / DISPATCH MODAL */}\n      {selectedQuote && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200\">\n          <div className=\"relative w-full max-w-md bg-zinc-900 border border-zinc-800 rounded-xl p-6 shadow-2xl text-zinc-100\">\n            <button\n              onClick={onCloseQuoteModal}\n              className=\"absolute top-4 right-4 p-2 text-zinc-400 hover:text-zinc-200 rounded-lg hover:bg-zinc-800 transition\"\n              aria-label=\"Fechar\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            {contractSuccess ? (\n              <div className=\"py-8 text-center space-y-3\">\n                <div className=\"w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 mx-auto flex items-center justify-center\">\n                  <CheckCircle2 className=\"w-6 h-6\" />\n                </div>\n                <h3 className=\"text-xl font-semibold text-zinc-100\">Ordem de frete gerada</h3>\n                <p className=\"text-sm text-zinc-400 font-mono\">\n                  C\303\263digo de Coleta: LGF-{Math.floor(10000 + Math.random() * 90000)}-BR\n                </p>\n                <p className=\"text-xs text-zinc-400\">\n                  Notifica\303\247\303\243o despachada para {selectedQuote.carrierName}. A documenta\303\247\303\243o fiscal (CT-e) foi sincronizada.\n                </p>\n              </div>\n            ) : (\n              <div>\n                <div className=\"flex items-center justify-between mb-4\">\n                  <span className=\"text-xs font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\">\n                    Contrata\303\247\303\243o de Frete B2B\n                  </span>\n                  <span className=\"text-xs text-zinc-400\">SLA {selectedQuote.sla}</span>\n                </div>\n\n                <h3 className=\"text-xl font-bold text-white mb-1\">\n                  {selectedQuote.carrierName}\n                </h3>\n                <p className=\"text-xs text-zinc-400 mb-5\">\n                  Modalidade: {selectedQuote.modality} \342\200\242 Prazo estimado: {selectedQuote.transitTime}\n                </p>\n\n                <div className=\"bg-zinc-950 border border-zinc-800 rounded-lg p-4 mb-5 space-y-2.5\">\n                  <div className=\"flex justify-between items-center text-sm\">\n                    <span className=\"text-zinc-400\">Valor l\303\255quido do frete:</span>\n                    <span className=\"font-semibold text-zinc-100\">\n                      R$ {selectedQuote.price.toLocaleString(\'pt-BR\', { minimumFractionDigits: 2 })}\n                    </span>\n                  </div>\n                  <div className=\"flex justify-between items-center text-sm\">\n                    <span className=\"text-zinc-400\">Seguro de carga RCF-DC:</span>\n                    <span className=\"text-emerald-400 text-xs font-mono\">Incluso (Ap\303\263lice ativa)</span>\n                  </div>\n                  <div className=\"flex justify-between items-center text-sm\">\n                    <span className=\"text-zinc-400\">Rastreamento telem\303\251trico:</span>\n                    <span className=\"text-emerald-400 text-xs font-mono\">Tempo real 24/7</span>\n                  </div>\n                </div>\n\n                <form onSubmit={handleContractSubmit} className=\"space-y-4\">\n                  <div>\n                    <label className=\"block text-xs font-medium text-zinc-300 mb-1\">\n                      Chave de Acesso da NF-e ou Descri\303\247\303\243o da Carga\n                    </label>\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"Ex: 3524 0900 0000 0000 0000 5500 1000 0000 0012 3456 7890\"\n                      className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-xs font-mono text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-emerald-500 transition\"\n                    />\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    className=\"w-full bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-semibold py-2.5 px-4 rounded-lg text-sm transition-all duration-150 shadow-sm\"\n                  >\n                    Confirmar e despachar frete\n                  </button>\n                </form>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </>\n  );\n};\n"
    raw_content: "import React, { useState } from \'react\';\nimport { X, CheckCircle2, ArrowRight } from \'lucide-react\';\nimport { QuoteOption } from \'../types\';\n\ninterface ModalsProps {\n  loginOpen: boolean;\n  onCloseLogin: () => void;\n  registerOpen: boolean;\n  onCloseRegister: () => void;\n  selectedQuote: QuoteOption | null;\n  onCloseQuoteModal: () => void;\n  onOpenRegisterFromLogin?: () => void;\n}\n\nexport const Modals: React.FC<ModalsProps> = ({\n  loginOpen,\n  onCloseLogin,\n  registerOpen,\n  onCloseRegister,\n  selectedQuote,\n  onCloseQuoteModal,\n  onOpenRegisterFromLogin,\n}) => {\n  const [loginEmail, setLoginEmail] = useState(\'\');\n  const [loginPassword, setLoginPassword] = useState(\'\');\n  const [loginSuccess, setLoginSuccess] = useState(false);\n\n  const [regName, setRegName] = useState(\'\');\n  const [regCnpj, setRegCnpj] = useState(\'\');\n  const [regEmail, setRegEmail] = useState(\'\');\n  const [regType, setRegType] = useState(\'embarcador\');\n  const [regSuccess, setRegSuccess] = useState(false);\n\n  const [contractSuccess, setContractSuccess] = useState(false);\n\n  // Login submit handler\n  const handleLoginSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoginSuccess(true);\n    setTimeout(() => {\n      setLoginSuccess(false);\n      onCloseLogin();\n    }, 1800);\n  };\n\n  // Register submit handler\n  const handleRegisterSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setRegSuccess(true);\n    setTimeout(() => {\n      setRegSuccess(false);\n      onCloseRegister();\n    }, 2000);\n  };\n\n  // Contract freight submit handler\n  const handleContractSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setContractSuccess(true);\n    setTimeout(() => {\n      setContractSuccess(false);\n      onCloseQuoteModal();\n    }, 2200);\n  };\n\n  return (\n    <>\n      {/* LOGIN MODAL */}\n      {loginOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200\">\n          <div className=\"relative w-full max-w-md bg-zinc-900 border border-zinc-800 rounded-xl p-6 md:p-8 shadow-2xl text-zinc-100\">\n            <button\n              onClick={onCloseLogin}\n              className=\"absolute top-4 right-4 p-2 text-zinc-400 hover:text-zinc-200 rounded-lg hover:bg-zinc-800 transition\"\n              aria-label=\"Fechar\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            {loginSuccess ? (\n              <div className=\"py-8 text-center space-y-3\">\n                <div className=\"w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 mx-auto flex items-center justify-center\">\n                  <CheckCircle2 className=\"w-6 h-6\" />\n                </div>\n                <h3 className=\"text-xl font-semibold text-zinc-100\">Autentica\303\247\303\243o autorizada</h3>\n                <p className=\"text-sm text-zinc-400\">\n                  Redirecionando com seguran\303\247a para o Console LogiFlow Enterprise...\n                </p>\n              </div>\n            ) : (\n              <div>\n                <div className=\"flex items-center gap-2 mb-6\">\n                  <div className=\"w-2.5 h-2.5 rounded-full bg-emerald-500\" />\n                  <span className=\"text-xs font-mono uppercase tracking-wider text-zinc-400\">Portal do Cliente</span>\n                </div>\n\n                <h2 className=\"text-2xl font-bold tracking-tight text-white mb-2\">Acessar plataforma</h2>\n                <p className=\"text-sm text-zinc-400 mb-6\">\n                  Insira suas credenciais corporativas ou autentique-se via Single Sign-On (SSO).\n                </p>\n\n                <form onSubmit={handleLoginSubmit} className=\"space-y-4\">\n                  <div>\n                    <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                      E-mail corporativo\n                    </label>\n                    <input\n                      type=\"email\"\n                      required\n                      placeholder=\"nome@empresa.com.br\"\n                      value={loginEmail}\n                      onChange={(e) => setLoginEmail(e.target.value)}\n                      className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                    />\n                  </div>\n\n                  <div>\n                    <div className=\"flex items-center justify-between mb-1.5\">\n                      <label className=\"block text-xs font-medium text-zinc-300\">\n                        Senha de acesso\n                      </label>\n                      <a href=\"#recuperar\" onClick={(e) => e.preventDefault()} className=\"text-xs text-zinc-400 hover:text-emerald-400 transition\">\n                        Esqueceu a senha?\n                      </a>\n                    </div>\n                    <input\n                      type=\"password\"\n                      required\n                      placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                      value={loginPassword}\n                      onChange={(e) => setLoginPassword(e.target.value)}\n                      className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                    />\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    className=\"w-full mt-2 bg-emerald-500 hover:bg-emerald-400 active:scale-[0.99] text-zinc-950 font-semibold py-2.5 px-4 rounded-lg text-sm transition-all duration-150 shadow-sm\"\n                  >\n                    Entrar no sistema\n                  </button>\n                </form>\n\n                <div className=\"mt-6 pt-5 border-t border-zinc-800/80 text-center\">\n                  <p className=\"text-xs text-zinc-400\">\n                    Sua empresa ainda n\303\243o possui conta?{\' \'}\n                    <button\n                      type=\"button\"\n                      onClick={() => {\n                        onCloseLogin();\n                        if (onOpenRegisterFromLogin) onOpenRegisterFromLogin();\n                      }}\n                      className=\"text-emerald-400 hover:text-emerald-300 font-medium ml-1\"\n                    >\n                      Cadastrar empresa parceira\n                    </button>\n                  </p>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* REGISTER / PARTNER MODAL */}\n      {registerOpen && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200\">\n          <div className=\"relative w-full max-w-lg bg-zinc-900 border border-zinc-800 rounded-xl p-6 md:p-8 shadow-2xl text-zinc-100 max-h-[90vh] overflow-y-auto\">\n            <button\n              onClick={onCloseRegister}\n              className=\"absolute top-4 right-4 p-2 text-zinc-400 hover:text-zinc-200 rounded-lg hover:bg-zinc-800 transition\"\n              aria-label=\"Fechar\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            {regSuccess ? (\n              <div className=\"py-8 text-center space-y-3\">\n                <div className=\"w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 mx-auto flex items-center justify-center\">\n                  <CheckCircle2 className=\"w-6 h-6\" />\n                </div>\n                <h3 className=\"text-xl font-semibold text-zinc-100\">Solicita\303\247\303\243o enviada com sucesso</h3>\n                <p className=\"text-sm text-zinc-400\">\n                  Um especialista de parcerias corporativas da LogiFlow entrar\303\241 em contato em at\303\251 2 horas \303\272teis.\n                </p>\n              </div>\n            ) : (\n              <div>\n                <div className=\"flex items-center gap-2 mb-4\">\n                  <span className=\"px-2 py-0.5 text-[11px] font-mono rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\">\n                    Onboarding Corporativo\n                  </span>\n                </div>\n\n                <h2 className=\"text-2xl font-bold tracking-tight text-white mb-2\">Cadastrar empresa parceira</h2>\n                <p className=\"text-sm text-zinc-400 mb-6\">\n                  Integre sua transportadora \303\240 nossa malha ou obtenha acesso de embarcador com tabelas exclusivas.\n                </p>\n\n                <form onSubmit={handleRegisterSubmit} className=\"space-y-4\">\n                  <div>\n                    <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                      Tipo de opera\303\247\303\243o\n                    </label>\n                    <div className=\"grid grid-cols-2 gap-2\">\n                      <button\n                        type=\"button\"\n                        onClick={() => setRegType(\'embarcador\')}\n                        className={`py-2 px-3 text-xs font-medium rounded-lg border text-center transition ${\n                          regType === \'embarcador\'\n                            ? \'bg-zinc-800 border-emerald-500 text-emerald-300\'\n                            : \'bg-zinc-950 border-zinc-800 text-zinc-400 hover:border-zinc-700\'\n                        }`}\n                      >\n                        Sou Embarcador (Ind\303\272stria/Com\303\251rcio)\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => setRegType(\'transportador\')}\n                        className={`py-2 px-3 text-xs font-medium rounded-lg border text-center transition ${\n                          regType === \'transportador\'\n                            ? \'bg-zinc-800 border-emerald-500 text-emerald-300\'\n                            : \'bg-zinc-950 border-zinc-800 text-zinc-400 hover:border-zinc-700\'\n                        }`}\n                      >\n                        Sou Transportador / Frotista\n                      </button>\n                    </div>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                      Raz\303\243o social ou nome da empresa\n                    </label>\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"Ex: Log\303\255stica R\303\241pida Nacional Ltda\"\n                      value={regName}\n                      onChange={(e) => setRegName(e.target.value)}\n                      className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                    />\n                  </div>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                    <div>\n                      <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                        CNPJ\n                      </label>\n                      <input\n                        type=\"text\"\n                        required\n                        placeholder=\"00.000.000/0001-00\"\n                        value={regCnpj}\n                        onChange={(e) => setRegCnpj(e.target.value)}\n                        className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                        E-mail de contato corporativo\n                      </label>\n                      <input\n                        type=\"email\"\n                        required\n                        placeholder=\"contato@empresa.com.br\"\n                        value={regEmail}\n                        onChange={(e) => setRegEmail(e.target.value)}\n                        className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                      />\n                    </div>\n                  </div>\n\n                  <div className=\"bg-zinc-950/70 border border-zinc-800 rounded-lg p-3 text-xs text-zinc-400 space-y-1\">\n                    <p className=\"font-medium text-zinc-300\">Garantias LogiFlow:</p>\n                    <p>\342\200\242 Homologa\303\247\303\243o em conformidade com ANTT e emiss\303\243o autom\303\241tica de CT-e / MDF-e.</p>\n                    <p>\342\200\242 Gest\303\243o de fretes sem taxas ocultas ou mensalidades surpresa.</p>\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    className=\"w-full mt-3 bg-emerald-500 hover:bg-emerald-400 active:scale-[0.99] text-zinc-950 font-semibold py-2.5 px-4 rounded-lg text-sm transition-all duration-150 shadow-sm flex items-center justify-center gap-2\"\n                  >\n                    <span>Finalizar pr\303\251-cadastro corporativo</span>\n                    <ArrowRight className=\"w-4 h-4\" />\n                  </button>\n                </form>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* FREIGHT CONTRACT / DISPATCH MODAL */}\n      {selectedQuote && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200\">\n          <div className=\"relative w-full max-w-md bg-zinc-900 border border-zinc-800 rounded-xl p-6 shadow-2xl text-zinc-100\">\n            <button\n              onClick={onCloseQuoteModal}\n              className=\"absolute top-4 right-4 p-2 text-zinc-400 hover:text-zinc-200 rounded-lg hover:bg-zinc-800 transition\"\n              aria-label=\"Fechar\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n\n            {contractSuccess ? (\n              <div className=\"py-8 text-center space-y-3\">\n                <div className=\"w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 mx-auto flex items-center justify-center\">\n                  <CheckCircle2 className=\"w-6 h-6\" />\n                </div>\n                <h3 className=\"text-xl font-semibold text-zinc-100\">Ordem de frete gerada</h3>\n                <p className=\"text-sm text-zinc-400 font-mono\">\n                  C\303\263digo de Coleta: LGF-{Math.floor(10000 + Math.random() * 90000)}-BR\n                </p>\n                <p className=\"text-xs text-zinc-400\">\n                  Notifica\303\247\303\243o despachada para {selectedQuote.carrierName}. A documenta\303\247\303\243o fiscal (CT-e) foi sincronizada.\n                </p>\n              </div>\n            ) : (\n              <div>\n                <div className=\"flex items-center justify-between mb-4\">\n                  <span className=\"text-xs font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\">\n                    Contrata\303\247\303\243o de Frete B2B\n                  </span>\n                  <span className=\"text-xs text-zinc-400\">SLA {selectedQuote.sla}</span>\n                </div>\n\n                <h3 className=\"text-xl font-bold text-white mb-1\">\n                  {selectedQuote.carrierName}\n                </h3>\n                <p className=\"text-xs text-zinc-400 mb-5\">\n                  Modalidade: {selectedQuote.modality} \342\200\242 Prazo estimado: {selectedQuote.transitTime}\n                </p>\n\n                <div className=\"bg-zinc-950 border border-zinc-800 rounded-lg p-4 mb-5 space-y-2.5\">\n                  <div className=\"flex justify-between items-center text-sm\">\n                    <span className=\"text-zinc-400\">Valor l\303\255quido do frete:</span>\n                    <span className=\"font-semibold text-zinc-100\">\n                      R$ {selectedQuote.price.toLocaleString(\'pt-BR\', { minimumFractionDigits: 2 })}\n                    </span>\n                  </div>\n                  <div className=\"flex justify-between items-center text-sm\">\n                    <span className=\"text-zinc-400\">Seguro de carga RCF-DC:</span>\n                    <span className=\"text-emerald-400 text-xs font-mono\">Incluso (Ap\303\263lice ativa)</span>\n                  </div>\n                  <div className=\"flex justify-between items-center text-sm\">\n                    <span className=\"text-zinc-400\">Rastreamento telem\303\251trico:</span>\n                    <span className=\"text-emerald-400 text-xs font-mono\">Tempo real 24/7</span>\n                  </div>\n                </div>\n\n                <form onSubmit={handleContractSubmit} className=\"space-y-4\">\n                  <div>\n                    <label className=\"block text-xs font-medium text-zinc-300 mb-1\">\n                      Chave de Acesso da NF-e ou Descri\303\247\303\243o da Carga\n                    </label>\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"Ex: 3524 0900 0000 0000 0000 5500 1000 0000 0012 3456 7890\"\n                      className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-xs font-mono text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-emerald-500 transition\"\n                    />\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    className=\"w-full bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-semibold py-2.5 px-4 rounded-lg text-sm transition-all duration-150 shadow-sm\"\n                  >\n                    Confirmar e despachar frete\n                  </button>\n                </form>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </>\n  );\n};\n"
    num_lines: 380
    num_bytes: 18007
  }
}
