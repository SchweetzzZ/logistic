      arguments_json: "{\"Content\":\"import React, { useState } from \'react\';\\nimport { X, CheckCircle2, ArrowRight } from \'lucide-react\';\\nimport { QuoteOption } from \'../types\';\\n\\ninterface ModalsProps {\\n  loginOpen: boolean;\\n  onCloseLogin: () => void;\\n  registerOpen: boolean;\\n  onCloseRegister: () => void;\\n  selectedQuote: QuoteOption | null;\\n  onCloseQuoteModal: () => void;\\n  onOpenRegisterFromLogin?: () => void;\\n}\\n\\nexport const Modals: React.FC<ModalsProps> = ({\\n  loginOpen,\\n  onCloseLogin,\\n  registerOpen,\\n  onCloseRegister,\\n  selectedQuote,\\n  onCloseQuoteModal,\\n  onOpenRegisterFromLogin,\\n}) => {\\n  const [loginEmail, setLoginEmail] = useState(\'\');\\n  const [loginPassword, setLoginPassword] = useState(\'\');\\n  const [loginSuccess, setLoginSuccess] = useState(false);\\n\\n  const [regName, setRegName] = useState(\'\');\\n  const [regCnpj, setRegCnpj] = useState(\'\');\\n  const [regEmail, setRegEmail] = useState(\'\');\\n  const [regType, setRegType] = useState<\'embarcador\' | \'transportadora\'>(\'embarcador\');\\n  const [regSuccess, setRegSuccess] = useState(false);\\n\\n  const [contractSuccess, setContractSuccess] = useState(false);\\n  const [nfeKey, setNfeKey] = useState(\'\');\\n\\n  const handleLoginSubmit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setLoginSuccess(true);\\n    setTimeout(() => {\\n      setLoginSuccess(false);\\n      onCloseLogin();\\n    }, 1500);\\n  };\\n\\n  const handleRegisterSubmit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setRegSuccess(true);\\n    setTimeout(() => {\\n      setRegSuccess(false);\\n      onCloseRegister();\\n    }, 1800);\\n  };\\n\\n  const handleContractSubmit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setContractSuccess(true);\\n    setTimeout(() => {\\n      setContractSuccess(false);\\n      onCloseQuoteModal();\\n    }, 1800);\\n  };\\n\\n  return (\\n    <>\\n      {/* MODAL DE LOGIN (/login) */}\\n      {loginOpen && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200\\\">\\n          <div className=\\\"relative w-full max-w-md bg-zinc-900 border border-zinc-800 rounded-xl p-6 md:p-8 shadow-2xl text-zinc-100\\\">\\n            <button\\n              onClick={onCloseLogin}\\n              className=\\\"absolute top-4 right-4 p-2 text-zinc-400 hover:text-zinc-200 rounded-lg hover:bg-zinc-800 transition cursor-pointer\\\"\\n              aria-label=\\\"Fechar\\\"\\n            >\\n              <X className=\\\"w-5 h-5\\\" />\\n            </button>\\n\\n            {loginSuccess ? (\\n              <div className=\\\"py-8 text-center space-y-3\\\">\\n                <div className=\\\"w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 mx-auto flex items-center justify-center\\\">\\n                  <CheckCircle2 className=\\\"w-6 h-6\\\" />\\n                </div>\\n                <h3 className=\\\"text-xl font-semibold text-zinc-100\\\">Acesso autorizado</h3>\\n                <p className=\\\"text-sm text-zinc-400\\\">\\n                  Carregando seu painel corporativo...\\n                </p>\\n              </div>\\n            ) : (\\n              <div>\\n                <div className=\\\"flex items-center gap-2 mb-6\\\">\\n                  <div className=\\\"w-2 h-2 rounded-full bg-emerald-400\\\" />\\n                  <span className=\\\"text-xs font-mono text-zinc-400\\\">Acesso ao sistema</span>\\n                </div>\\n\\n                <h2 className=\\\"text-2xl font-semibold tracking-tight text-white mb-2\\\">Entrar na LogiFlow</h2>\\n                <p className=\\\"text-sm text-zinc-400 mb-6\\\">\\n                  Informe suas credenciais corporativas de embarcador ou transportadora.\\n                </p>\\n\\n                <form onSubmit={handleLoginSubmit} className=\\\"space-y-4\\\">\\n                  <div>\\n                    <label className=\\\"block text-xs font-medium text-zinc-300 mb-1.5\\\">\\n                      E-mail corporativo\\n                    </label>\\n                    <input\\n                      type=\\\"email\\\"\\n                      required\\n                      placeholder=\\\"seu.nome@empresa.com.br\\\"\\n                      value={loginEmail}\\n                      onChange={(e) => setLoginEmail(e.target.value)}\\n                      className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 transition\\\"\\n                    />\\n                  </div>\\n\\n                  <div>\\n                    <div className=\\\"flex items-center justify-between mb-1.5\\\">\\n                      <label className=\\\"block text-xs font-medium text-zinc-300\\\">\\n                        Senha\\n                      </label>\\n                      <a href=\\\"#recuperar\\\" onClick={(e) => e.preventDefault()} className=\\\"text-xs text-zinc-400 hover:text-emerald-400 transition\\\">\\n                        Esqueceu a senha?\\n                      </a>\\n                    </div>\\n                    <input\\n                      type=\\\"password\\\"\\n                      required\\n                      placeholder=\\\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\\\"\\n                      value={loginPassword}\\n                      onChange={(e) => setLoginPassword(e.target.value)}\\n                      className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 transition\\\"\\n                    />\\n                  </div>\\n\\n                  <button\\n                    type=\\\"submit\\\"\\n                    className=\\\"w-full mt-2 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-medium py-2.5 px-4 rounded-lg text-sm transition-all duration-150 shadow-sm cursor-pointer\\\"\\n                  >\\n                    Acessar sistema\\n                  </button>\\n                </form>\\n\\n                <div className=\\\"mt-6 pt-5 border-t border-zinc-800 text-center\\\">\\n                  <p className=\\\"text-xs text-zinc-400\\\">\\n                    Sua empresa ainda n\303\243o possui conta?{\' \'}\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => {\\n                        onCloseLogin();\\n                        if (onOpenRegisterFromLogin) onOpenRegisterFromLogin();\\n                      }}\\n                      className=\\\"text-emerald-400 hover:text-emerald-300 font-medium ml-1 cursor-pointer\\\"\\n                    >\\n                      Cadastrar empresa\\n                    </button>\\n                  </p>\\n                </div>\\n              </div>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* MODAL DE CADASTRO DE TENANT (/register) */}\\n      {registerOpen && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200\\\">\\n          <div className=\\\"relative w-full max-w-lg bg-zinc-900 border border-zinc-800 rounded-xl p-6 md:p-8 shadow-2xl text-zinc-100 max-h-[90vh] overflow-y-auto\\\">\\n            <button\\n              onClick={onCloseRegister}\\n              className=\\\"absolute top-4 right-4 p-2 text-zinc-400 hover:text-zinc-200 rounded-lg hover:bg-zinc-800 transition cursor-pointer\\\"\\n              aria-label=\\\"Fechar\\\"\\n            >\\n              <X className=\\\"w-5 h-5\\\" />\\n            </button>\\n\\n            {regSuccess ? (\\n              <div className=\\\"py-8 text-center space-y-3\\\">\\n                <div className=\\\"w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 mx-auto flex items-center justify-center\\\">\\n                  <CheckCircle2 className=\\\"w-6 h-6\\\" />\\n                </div>\\n                <h3 className=\\\"text-xl font-semibold text-zinc-100\\\">Cadastro recebido</h3>\\n                <p className=\\\"text-sm text-zinc-400\\\">\\n                  Os dados foram registrados para homologa\303\247\303\243o da sua conta corporativa.\\n                </p>\\n              </div>\\n            ) : (\\n              <div>\\n                <div className=\\\"flex items-center gap-2 mb-4\\\">\\n                  <span className=\\\"px-2 py-0.5 text-[11px] font-mono rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\\\">\\n                    Onboarding corporativo\\n                  </span>\\n                </div>\\n\\n                <h2 className=\\\"text-2xl font-semibold tracking-tight text-white mb-2\\\">Cadastrar empresa</h2>\\n                <p className=\\\"text-sm text-zinc-400 mb-6\\\">\\n                  Selecione o tipo de opera\303\247\303\243o para configurar o ambiente do seu neg\303\263cio.\\n                </p>\\n\\n                <form onSubmit={handleRegisterSubmit} className=\\\"space-y-4\\\">\\n                  <div>\\n                    <label className=\\\"block text-xs font-medium text-zinc-300 mb-1.5\\\">\\n                      Tipo de empresa\\n                    </label>\\n                    <div className=\\\"grid grid-cols-2 gap-2\\\">\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => setRegType(\'embarcador\')}\\n                        className={`py-2 px-3 text-xs font-medium rounded-lg border text-center transition cursor-pointer ${\\n                          regType === \'embarcador\'\\n                            ? \'bg-zinc-800 border-emerald-500 text-emerald-300\'\\n                            : \'bg-zinc-950 border-zinc-800 text-zinc-400 hover:border-zinc-700\'\\n                        }`}\\n                      >\\n                        Embarcador\\n                      </button>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => setRegType(\'transportadora\')}\\n                        className={`py-2 px-3 text-xs font-medium rounded-lg border text-center transition cursor-pointer ${\\n                          regType === \'transportadora\'\\n                            ? \'bg-zinc-800 border-emerald-500 text-emerald-300\'\\n                            : \'bg-zinc-950 border-zinc-800 text-zinc-400 hover:border-zinc-700\'\\n                        }`}\\n                      >\\n                        Transportadora parceira\\n                      </button>\\n                    </div>\\n                  </div>\\n\\n                  <div>\\n                    <label className=\\\"block text-xs font-medium text-zinc-300 mb-1.5\\\">\\n                      Raz\303\243o social\\n                    </label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      required\\n                      placeholder=\\\"Nome da empresa\\\"\\n                      value={regName}\\n                      onChange={(e) => setRegName(e.target.value)}\\n                      className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 transition\\\"\\n                    />\\n                  </div>\\n\\n                  <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n                    <div>\\n                      <label className=\\\"block text-xs font-medium text-zinc-300 mb-1.5\\\">\\n                        CNPJ\\n                      </label>\\n                      <input\\n                        type=\\\"text\\\"\\n                        required\\n                        placeholder=\\\"00.000.000/0001-00\\\"\\n                        value={regCnpj}\\n                        onChange={(e) => setRegCnpj(e.target.value)}\\n                        className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 transition\\\"\\n                      />\\n                    </div>\\n                    <div>\\n                      <label className=\\\"block text-xs font-medium text-zinc-300 mb-1.5\\\">\\n                        E-mail de contato\\n                      </label>\\n                      <input\\n                        type=\\\"email\\\"\\n                        required\\n                        placeholder=\\\"contato@empresa.com.br\\\"\\n                        value={regEmail}\\n                        onChange={(e) => setRegEmail(e.target.value)}\\n                        className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 transition\\\"\\n                      />\\n                    </div>\\n                  </div>\\n\\n                  <div className=\\\"bg-zinc-950/70 border border-zinc-800 rounded-lg p-3 text-xs text-zinc-400 space-y-1\\\">\\n                    <p className=\\\"font-medium text-zinc-300\\\">Integra\303\247\303\243o de tabelas:</p>\\n                    <p>\342\200\242 Valida\303\247\303\243o autom\303\241tica de CNPJ e dados cadastrais.</p>\\n                    <p>\342\200\242 Painel dedicado para importa\303\247\303\243o de tabelas de frete ou emiss\303\243o direta.</p>\\n                  </div>\\n\\n                  <button\\n                    type=\\\"submit\\\"\\n                    className=\\\"w-full mt-3 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-medium py-2.5 px-4 rounded-lg text-sm transition-all duration-150 shadow-sm flex items-center justify-center gap-2 cursor-pointer\\\"\\n                  >\\n                    <span>Concluir cadastro da empresa</span>\\n                    <ArrowRight className=\\\"w-4 h-4 text-zinc-950\\\" />\\n                  </button>\\n                </form>\\n              </div>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* MODAL DE CONTRATA\303\207\303\203O DE FRETE */}\\n      {selectedQuote && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200\\\">\\n          <div className=\\\"relative w-full max-w-md bg-zinc-900 border border-zinc-800 rounded-xl p-6 shadow-2xl text-zinc-100\\\">\\n            <button\\n              onClick={onCloseQuoteModal}\\n              className=\\\"absolute top-4 right-4 p-2 text-zinc-400 hover:text-zinc-200 rounded-lg hover:bg-zinc-800 transition cursor-pointer\\\"\\n              aria-label=\\\"Fechar\\\"\\n            >\\n              <X className=\\\"w-5 h-5\\\" />\\n            </button>\\n\\n            {contractSuccess ? (\\n              <div className=\\\"py-8 text-center space-y-3\\\">\\n                <div className=\\\"w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 mx-auto flex items-center justify-center\\\">\\n                  <CheckCircle2 className=\\\"w-6 h-6\\\" />\\n                </div>\\n                <h3 className=\\\"text-xl font-semibold text-zinc-100\\\">Frete contratado</h3>\\n                <p className=\\\"text-xs font-mono text-zinc-400\\\">\\n                  Solicita\303\247\303\243o encaminhada diretamente para {selectedQuote.carrierName}.\\n                </p>\\n                <p className=\\\"text-xs text-zinc-400\\\">\\n                  A minuta de despacho e o comprovante foram disponibilizados.\\n                </p>\\n              </div>\\n            ) : (\\n              <div>\\n                <div className=\\\"flex items-center justify-between mb-3\\\">\\n                  <span className=\\\"text-xs font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\\\">\\n                    Contrata\303\247\303\243o direta\\n                  </span>\\n                  <span className=\\\"text-xs text-zinc-400\\\">{selectedQuote.transitTimeText}</span>\\n                </div>\\n\\n                <h3 className=\\\"text-xl font-semibold text-white mb-1\\\">\\n                  {selectedQuote.carrierName}\\n                </h3>\\n                <p className=\\\"text-xs text-zinc-400 mb-4\\\">\\n                  Modalidade: {selectedQuote.modality}\\n                </p>\\n\\n                <div className=\\\"bg-zinc-950 border border-zinc-800 rounded-lg p-4 mb-4 space-y-2 text-xs\\\">\\n                  <div className=\\\"flex justify-between items-center\\\">\\n                    <span className=\\\"text-zinc-400\\\">Valor total do frete:</span>\\n                    <span className=\\\"font-semibold text-base font-mono text-zinc-100\\\">\\n                      R$ {selectedQuote.price.toFixed(2).replace(\'.\', \',\')}\\n                    </span>\\n                  </div>\\n                  <div className=\\\"flex justify-between items-center text-zinc-400\\\">\\n                    <span>Seguro da mercadoria:</span>\\n                    <span className=\\\"text-emerald-400 font-mono\\\">Incluso</span>\\n                  </div>\\n                </div>\\n\\n                <form onSubmit={handleContractSubmit} className=\\\"space-y-4\\\">\\n                  <div>\\n                    <label className=\\\"block text-xs font-medium text-zinc-300 mb-1\\\">\\n                      Chave da NF-e ou identificador da carga\\n                    </label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      required\\n                      placeholder=\\\"Ex: 3524 0900 0000 0000 0000 5500 1000 0000 0012 3456\\\"\\n                      value={nfeKey}\\n                      onChange={(e) => setNfeKey(e.target.value)}\\n                      className=\\\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-xs font-mono text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-emerald-500 transition\\\"\\n                    />\\n                  </div>\\n\\n                  <button\\n                    type=\\\"submit\\\"\\n                    className=\\\"w-full bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-medium py-2.5 px-4 rounded-lg text-sm transition-all duration-150 shadow-sm cursor-pointer\\\"\\n                  >\\n                    Confirmar contrata\303\247\303\243o de frete\\n                  </button>\\n                </form>\\n              </div>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n    </>\\n  );\\n};\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/components/Modals.tsx\", \"toolAction\":\"Updating Modals.tsx\", \"toolSummary\":\"Update Modals\"}"
