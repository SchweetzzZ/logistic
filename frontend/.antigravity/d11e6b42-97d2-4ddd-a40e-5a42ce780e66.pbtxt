  view_file {
    absolute_path_uri: "file:///src/components/Navbar.tsx"
    end_line: 196
    content: "import React, { useState, useEffect } from \'react\';\nimport { Menu, X } from \'lucide-react\';\n\ninterface NavbarProps {\n  onOpenLogin: () => void;\n  onOpenRegister: () => void;\n  onScrollToSimulator: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  onOpenLogin,\n  onOpenRegister,\n  onScrollToSimulator,\n}) => {\n  const [scrolled, setScrolled] = useState(false);\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      setScrolled(window.scrollY > 20);\n    };\n    window.addEventListener(\'scroll\', handleScroll);\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  const handleNavClick = (sectionId: string) => {\n    setMobileMenuOpen(false);\n    if (sectionId === \'simulador\') {\n      onScrollToSimulator();\n      return;\n    }\n    const element = document.getElementById(sectionId);\n    if (element) {\n      element.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  return (\n    <header\n      className={`fixed top-0 left-0 right-0 z-40 transition-all duration-200 ${\n        scrolled\n          ? \'bg-zinc-950/85 backdrop-blur-md border-b border-zinc-800/80 py-3.5 shadow-sm\'\n          : \'bg-zinc-950/40 backdrop-blur-sm border-b border-white/[0.04] py-4\'\n      }`}\n    >\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between\">\n        {/* LOGO */}\n        <a\n          href=\"#\"\n          className=\"flex items-center gap-2.5 group focus:outline-none\"\n          onClick={(e) => {\n            e.preventDefault();\n            window.scrollTo({ top: 0, behavior: \'smooth\' });\n          }}\n        >\n          {/* Geometric subtle icon inspired by Sinka chevron and high-performance logistics */}\n          <div className=\"flex items-center justify-center w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 group-hover:border-zinc-700 transition\">\n            <svg\n              className=\"w-4 h-4 text-emerald-400\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2.5\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n            >\n              <polyline points=\"13 17 18 12 13 7\" />\n              <polyline points=\"6 17 11 12 6 7\" />\n            </svg>\n          </div>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-lg font-bold tracking-tight text-white\">LogiFlow</span>\n            <span className=\"text-[10px] font-mono tracking-wider uppercase px-1.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-400\">\n              Enterprise\n            </span>\n          </div>\n        </a>\n\n        {/* CENTER LINKS (DESKTOP) */}\n        <nav className=\"hidden md:flex items-center gap-7 text-sm font-normal text-zinc-400\">\n          <button\n            onClick={() => handleNavClick(\'solucoes\')}\n            className=\"hover:text-zinc-100 transition duration-150\"\n          >\n            Solu\303\247\303\265es\n          </button>\n          <button\n            onClick={() => handleNavClick(\'simulador\')}\n            className=\"hover:text-zinc-100 transition duration-150\"\n          >\n            Simula\303\247\303\243o de frete\n          </button>\n          <button\n            onClick={() => handleNavClick(\'diferenciais\')}\n            className=\"hover:text-zinc-100 transition duration-150\"\n          >\n            Diferenciais\n          </button>\n          <button\n            onClick={() => handleNavClick(\'parceiros\')}\n            className=\"hover:text-zinc-100 transition duration-150\"\n          >\n            Para parceiros\n          </button>\n        </nav>\n\n        {/* RIGHT ACTIONS */}\n        <div className=\"hidden md:flex items-center gap-4\">\n          <button\n            onClick={onOpenLogin}\n            className=\"text-sm text-zinc-300 hover:text-white px-3 py-2 rounded-lg transition duration-150\"\n          >\n            Acessar sistema\n          </button>\n\n          <button\n            onClick={onOpenRegister}\n            className=\"inline-flex items-center justify-center text-sm font-semibold bg-emerald-500 hover:bg-emerald-400 text-zinc-950 px-4 py-2 rounded-lg transition-all duration-150 active:scale-[0.98] shadow-sm\"\n          >\n            Seja um parceiro\n          </button>\n        </div>\n\n        {/* MOBILE MENU TOGGLE */}\n        <div className=\"flex items-center md:hidden gap-2\">\n          <button\n            onClick={onOpenLogin}\n            className=\"text-xs text-zinc-300 hover:text-white px-2.5 py-1.5 rounded-lg border border-zinc-800\"\n          >\n            Entrar\n          </button>\n          <button\n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            className=\"p-2 text-zinc-400 hover:text-zinc-200 rounded-lg hover:bg-zinc-900 border border-zinc-800\"\n            aria-label=\"Abrir menu\"\n          >\n            {mobileMenuOpen ? <X className=\"w-5 h-5\" /> : <Menu className=\"w-5 h-5\" />}\n          </button>\n        </div>\n      </div>\n\n      {/* MOBILE DRAWER */}\n      {mobileMenuOpen && (\n        <div className=\"md:hidden bg-zinc-950 border-b border-zinc-800 px-5 py-5 space-y-4 animate-in fade-in slide-in-from-top-2\">\n          <div className=\"flex flex-col space-y-3 text-sm text-zinc-300\">\n            <button\n              onClick={() => handleNavClick(\'solucoes\')}\n              className=\"text-left py-1 hover:text-white\"\n            >\n              Solu\303\247\303\265es\n            </button>\n            <button\n              onClick={() => handleNavClick(\'simulador\')}\n              className=\"text-left py-1 hover:text-white\"\n            >\n              Simula\303\247\303\243o de frete\n            </button>\n            <button\n              onClick={() => handleNavClick(\'diferenciais\')}\n              className=\"text-left py-1 hover:text-white\"\n            >\n              Diferenciais\n            </button>\n            <button\n              onClick={() => handleNavClick(\'parceiros\')}\n              className=\"text-left py-1 hover:text-white\"\n            >\n              Para parceiros\n            </button>\n          </div>\n\n          <div className=\"pt-3 border-t border-zinc-800 flex flex-col gap-2.5\">\n            <button\n              onClick={() => {\n                setMobileMenuOpen(false);\n                onOpenLogin();\n              }}\n              className=\"w-full text-center py-2 text-sm text-zinc-300 border border-zinc-800 rounded-lg\"\n            >\n              Acessar sistema\n            </button>\n            <button\n              onClick={() => {\n                setMobileMenuOpen(false);\n                onOpenRegister();\n              }}\n              className=\"w-full text-center py-2 text-sm font-semibold bg-emerald-500 text-zinc-950 rounded-lg\"\n            >\n              Seja um parceiro\n            </button>\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
    raw_content: "import React, { useState, useEffect } from \'react\';\nimport { Menu, X } from \'lucide-react\';\n\ninterface NavbarProps {\n  onOpenLogin: () => void;\n  onOpenRegister: () => void;\n  onScrollToSimulator: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  onOpenLogin,\n  onOpenRegister,\n  onScrollToSimulator,\n}) => {\n  const [scrolled, setScrolled] = useState(false);\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      setScrolled(window.scrollY > 20);\n    };\n    window.addEventListener(\'scroll\', handleScroll);\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  const handleNavClick = (sectionId: string) => {\n    setMobileMenuOpen(false);\n    if (sectionId === \'simulador\') {\n      onScrollToSimulator();\n      return;\n    }\n    const element = document.getElementById(sectionId);\n    if (element) {\n      element.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  return (\n    <header\n      className={`fixed top-0 left-0 right-0 z-40 transition-all duration-200 ${\n        scrolled\n          ? \'bg-zinc-950/85 backdrop-blur-md border-b border-zinc-800/80 py-3.5 shadow-sm\'\n          : \'bg-zinc-950/40 backdrop-blur-sm border-b border-white/[0.04] py-4\'\n      }`}\n    >\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between\">\n        {/* LOGO */}\n        <a\n          href=\"#\"\n          className=\"flex items-center gap-2.5 group focus:outline-none\"\n          onClick={(e) => {\n            e.preventDefault();\n            window.scrollTo({ top: 0, behavior: \'smooth\' });\n          }}\n        >\n          {/* Geometric subtle icon inspired by Sinka chevron and high-performance logistics */}\n          <div className=\"flex items-center justify-center w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 group-hover:border-zinc-700 transition\">\n            <svg\n              className=\"w-4 h-4 text-emerald-400\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              strokeWidth=\"2.5\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n            >\n              <polyline points=\"13 17 18 12 13 7\" />\n              <polyline points=\"6 17 11 12 6 7\" />\n            </svg>\n          </div>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-lg font-bold tracking-tight text-white\">LogiFlow</span>\n            <span className=\"text-[10px] font-mono tracking-wider uppercase px-1.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-400\">\n              Enterprise\n            </span>\n          </div>\n        </a>\n\n        {/* CENTER LINKS (DESKTOP) */}\n        <nav className=\"hidden md:flex items-center gap-7 text-sm font-normal text-zinc-400\">\n          <button\n            onClick={() => handleNavClick(\'solucoes\')}\n            className=\"hover:text-zinc-100 transition duration-150\"\n          >\n            Solu\303\247\303\265es\n          </button>\n          <button\n            onClick={() => handleNavClick(\'simulador\')}\n            className=\"hover:text-zinc-100 transition duration-150\"\n          >\n            Simula\303\247\303\243o de frete\n          </button>\n          <button\n            onClick={() => handleNavClick(\'diferenciais\')}\n            className=\"hover:text-zinc-100 transition duration-150\"\n          >\n            Diferenciais\n          </button>\n          <button\n            onClick={() => handleNavClick(\'parceiros\')}\n            className=\"hover:text-zinc-100 transition duration-150\"\n          >\n            Para parceiros\n          </button>\n        </nav>\n\n        {/* RIGHT ACTIONS */}\n        <div className=\"hidden md:flex items-center gap-4\">\n          <button\n            onClick={onOpenLogin}\n            className=\"text-sm text-zinc-300 hover:text-white px-3 py-2 rounded-lg transition duration-150\"\n          >\n            Acessar sistema\n          </button>\n\n          <button\n            onClick={onOpenRegister}\n            className=\"inline-flex items-center justify-center text-sm font-semibold bg-emerald-500 hover:bg-emerald-400 text-zinc-950 px-4 py-2 rounded-lg transition-all duration-150 active:scale-[0.98] shadow-sm\"\n          >\n            Seja um parceiro\n          </button>\n        </div>\n\n        {/* MOBILE MENU TOGGLE */}\n        <div className=\"flex items-center md:hidden gap-2\">\n          <button\n            onClick={onOpenLogin}\n            className=\"text-xs text-zinc-300 hover:text-white px-2.5 py-1.5 rounded-lg border border-zinc-800\"\n          >\n            Entrar\n          </button>\n          <button\n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            className=\"p-2 text-zinc-400 hover:text-zinc-200 rounded-lg hover:bg-zinc-900 border border-zinc-800\"\n            aria-label=\"Abrir menu\"\n          >\n            {mobileMenuOpen ? <X className=\"w-5 h-5\" /> : <Menu className=\"w-5 h-5\" />}\n          </button>\n        </div>\n      </div>\n\n      {/* MOBILE DRAWER */}\n      {mobileMenuOpen && (\n        <div className=\"md:hidden bg-zinc-950 border-b border-zinc-800 px-5 py-5 space-y-4 animate-in fade-in slide-in-from-top-2\">\n          <div className=\"flex flex-col space-y-3 text-sm text-zinc-300\">\n            <button\n              onClick={() => handleNavClick(\'solucoes\')}\n              className=\"text-left py-1 hover:text-white\"\n            >\n              Solu\303\247\303\265es\n            </button>\n            <button\n              onClick={() => handleNavClick(\'simulador\')}\n              className=\"text-left py-1 hover:text-white\"\n            >\n              Simula\303\247\303\243o de frete\n            </button>\n            <button\n              onClick={() => handleNavClick(\'diferenciais\')}\n              className=\"text-left py-1 hover:text-white\"\n            >\n              Diferenciais\n            </button>\n            <button\n              onClick={() => handleNavClick(\'parceiros\')}\n              className=\"text-left py-1 hover:text-white\"\n            >\n              Para parceiros\n            </button>\n          </div>\n\n          <div className=\"pt-3 border-t border-zinc-800 flex flex-col gap-2.5\">\n            <button\n              onClick={() => {\n                setMobileMenuOpen(false);\n                onOpenLogin();\n              }}\n              className=\"w-full text-center py-2 text-sm text-zinc-300 border border-zinc-800 rounded-lg\"\n            >\n              Acessar sistema\n            </button>\n            <button\n              onClick={() => {\n                setMobileMenuOpen(false);\n                onOpenRegister();\n              }}\n              className=\"w-full text-center py-2 text-sm font-semibold bg-emerald-500 text-zinc-950 rounded-lg\"\n            >\n              Seja um parceiro\n            </button>\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
