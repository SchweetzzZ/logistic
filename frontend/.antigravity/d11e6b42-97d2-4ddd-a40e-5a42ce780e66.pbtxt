    replacement_chunks {
      replacement_content: "import React from \'react\';\n\ninterface HeroProps {\n  onScrollToSimulator: () => void;\n  onOpenRegister: () => void;\n}\n\nexport const Hero: React.FC<HeroProps> = ({\n  onScrollToSimulator,\n  onOpenRegister,\n}) => {\n  return (\n    <section className=\"relative pt-36 pb-24 md:pt-48 md:pb-36 bg-white border-b border-zinc-200/80\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center\">\n        \n        {/* T\303\255tulo principal centralizado */}\n        <h1 className=\"text-4xl sm:text-6xl font-semibold tracking-tight text-zinc-900 max-w-4xl mx-auto leading-[1.12]\">\n          Cota\303\247\303\243o inteligente de fretes, sem planilhas ou intermedi\303\241rios.\n        </h1>\n\n        {/* Subt\303\255tulo centralizado */}\n        <p className=\"text-lg sm:text-xl text-zinc-600 max-w-2xl mx-auto mt-6 leading-relaxed font-normal\">\n          Conecte sua empresa a transportadoras homologadas. Calcule cubagem autom\303\241tica e encontre a melhor op\303\247\303\243o de frete em segundos.\n        </p>\n\n        {/* Grupo de bot\303\265es centralizado */}\n        <div className=\"mt-8 flex flex-col sm:flex-row items-center justify-center gap-4\">\n          <button\n            onClick={onScrollToSimulator}\n            className=\"w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-medium px-6 py-3 rounded-lg shadow-sm hover:shadow transition-all active:scale-[0.98] cursor-pointer\"\n          >\n            <span>Simular frete agora</span>\n            <span aria-hidden=\"true\">\342\206\222</span>\n          </button>\n\n          <a\n            href=\"/register\"\n            onClick={(e) => {\n              e.preventDefault();\n              onOpenRegister();\n            }}\n            className=\"w-full sm:w-auto inline-flex items-center justify-center bg-white hover:bg-zinc-50 border border-zinc-300 text-zinc-700 font-medium px-6 py-3 rounded-lg transition-all cursor-pointer\"\n          >\n            Seja uma transportadora parceira\n          </a>\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
