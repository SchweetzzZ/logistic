    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Building2, Truck, Check } from \'lucide-react\';\n\ninterface PartnershipSectionProps {\n  onOpenRegister: (defaultType?: \'embarcador\' | \'transportadora\') => void;\n}\n\nexport const PartnershipSection: React.FC<PartnershipSectionProps> = ({ onOpenRegister }) => {\n  return (\n    <section id=\"parcerias\" className=\"py-24 md:py-32 bg-zinc-50 border-b border-zinc-200/80 scroll-mt-20\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* T\303\255tulo da se\303\247\303\243o */}\n        <div className=\"max-w-2xl mb-14\">\n          <h2 className=\"text-3xl sm:text-4xl font-semibold tracking-tight text-zinc-900\">\n            Solu\303\247\303\265es para os dois lados do frete\n          </h2>\n          <p className=\"text-zinc-600 text-base sm:text-lg mt-3 leading-relaxed\">\n            Eliminamos o atrito na contrata\303\247\303\243o conectando diretamente quem despacha a quem transporta.\n          </p>\n        </div>\n\n        {/* Grid com 2 blocos arejados em fundo branco */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n          \n          {/* Bloco 1: Para o Embarcador */}\n          <div className=\"bg-white border border-zinc-200 p-8 sm:p-10 rounded-xl flex flex-col justify-between shadow-sm hover:shadow-md hover:shadow-zinc-200/60 transition-all duration-200\">\n            <div>\n              <div className=\"w-11 h-11 rounded-lg bg-zinc-100 border border-zinc-200/80 flex items-center justify-center text-zinc-800 mb-6\">\n                <Building2 className=\"w-5 h-5 text-amber-600\" />\n              </div>\n\n              <h3 className=\"text-xl font-semibold text-zinc-900 mb-3\">\n                Para o embarcador\n              </h3>\n              \n              <p className=\"text-zinc-600 text-sm sm:text-base leading-relaxed mb-6\">\n                Centraliza\303\247\303\243o de cota\303\247\303\265es em um \303\272nico lugar, sem perder tempo consultando m\303\272ltiplos canais, planilhas e e-mails dispersos.\n              </p>\n\n              <ul className=\"space-y-3 text-sm text-zinc-600 mb-8\">\n                <li className=\"flex items-start gap-2.5\">\n                  <Check className=\"w-4 h-4 text-amber-600 shrink-0 mt-1\" />\n                  <span>C\303\241lculo volum\303\251trico e cubagem autom\303\241tica com valida\303\247\303\243o instant\303\242nea de CEP.</span>\n                </li>\n                <li className=\"flex items-start gap-2.5\">\n                  <Check className=\"w-4 h-4 text-amber-600 shrink-0 mt-1\" />\n                  <span>Comparativo imediato por menor custo ou menor prazo de entrega.</span>\n                </li>\n                <li className=\"flex items-start gap-2.5\">\n                  <Check className=\"w-4 h-4 text-amber-600 shrink-0 mt-1\" />\n                  <span>Hist\303\263rico unificado de despachos e faturamento consolidado.</span>\n                </li>\n              </ul>\n            </div>\n\n            <div className=\"pt-6 border-t border-zinc-100\">\n              <a\n                href=\"/register\"\n                onClick={(e) => {\n                  e.preventDefault();\n                  onOpenRegister(\'embarcador\');\n                }}\n                className=\"inline-flex items-center gap-1.5 text-sm font-medium text-amber-600 hover:text-amber-700 transition cursor-pointer\"\n              >\n                <span>Cadastrar como embarcador</span>\n                <span aria-hidden=\"true\">\342\206\222</span>\n              </a>\n            </div>\n          </div>\n\n          {/* Bloco 2: Para a Transportadora */}\n          <div className=\"bg-white border border-zinc-200 p-8 sm:p-10 rounded-xl flex flex-col justify-between shadow-sm hover:shadow-md hover:shadow-zinc-200/60 transition-all duration-200\">\n            <div>\n              <div className=\"w-11 h-11 rounded-lg bg-zinc-100 border border-zinc-200/80 flex items-center justify-center text-zinc-800 mb-6\">\n                <Truck className=\"w-5 h-5 text-amber-600\" />\n              </div>\n\n              <h3 className=\"text-xl font-semibold text-zinc-900 mb-3\">\n                Para a transportadora\n              </h3>\n              \n              <p className=\"text-zinc-600 text-sm sm:text-base leading-relaxed mb-6\">\n                Canal direto para receber novas demandas qualificadas e gerenciar tabelas de frete em um painel exclusivo e intuitivo.\n              </p>\n\n              <ul className=\"space-y-3 text-sm text-zinc-600 mb-8\">\n                <li className=\"flex items-start gap-2.5\">\n                  <Check className=\"w-4 h-4 text-amber-600 shrink-0 mt-1\" />\n                  <span>Gest\303\243o flex\303\255vel de tabelas tarif\303\241rias por faixa de CEP e peso.</span>\n                </li>\n                <li className=\"flex items-start gap-2.5\">\n                  <Check className=\"w-4 h-4 text-amber-600 shrink-0 mt-1\" />\n                  <span>Demandas B2B prontas para coleta sem intermedia\303\247\303\243o opaca.</span>\n                </li>\n                <li className=\"flex items-start gap-2.5\">\n                  <Check className=\"w-4 h-4 text-amber-600 shrink-0 mt-1\" />\n                  <span>Comunica\303\247\303\243o direta com o cliente para emiss\303\243o de CTe e manifesto.</span>\n                </li>\n              </ul>\n            </div>\n\n            <div className=\"pt-6 border-t border-zinc-100\">\n              <a\n                href=\"/register\"\n                onClick={(e) => {\n                  e.preventDefault();\n                  onOpenRegister(\'transportadora\');\n                }}\n                className=\"inline-flex items-center gap-1.5 text-sm font-medium text-amber-600 hover:text-amber-700 transition cursor-pointer\"\n              >\n                <span>Cadastrar como transportadora</span>\n                <span aria-hidden=\"true\">\342\206\222</span>\n              </a>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
