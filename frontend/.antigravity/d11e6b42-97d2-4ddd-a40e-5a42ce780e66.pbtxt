    content: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, sans-serif;\n  }\n  code, .font-mono {\n    font-family: \'JetBrains Mono\', monospace;\n  }\n}\n\n@keyframes dashFlow {\n  from {\n    stroke-dashoffset: 400;\n  }\n  to {\n    stroke-dashoffset: 0;\n  }\n}\n\n@keyframes pulseGlow {\n  0%, 100% {\n    opacity: 0.3;\n    transform: scale(0.98);\n  }\n  50% {\n    opacity: 0.8;\n    transform: scale(1.02);\n  }\n}\n\n@keyframes travelAlongRoute {\n  0% {\n    offset-distance: 0%;\n  }\n  45% {\n    offset-distance: 48%;\n  }\n  55% {\n    offset-distance: 52%;\n  }\n  100% {\n    offset-distance: 100%;\n  }\n}\n\n.route-dash-animated {\n  stroke-dasharray: 6 8;\n  animation: dashFlow 16s linear infinite;\n}\n\n.route-dash-fast {\n  stroke-dasharray: 4 6;\n  animation: dashFlow 10s linear infinite;\n}\n\n.truck-traveler {\n  offset-path: path(\"M 30,160 C 130,50 250,220 370,110 C 470,20 540,210 650,140\");\n  animation: travelAlongRoute 12s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite alternate;\n  offset-rotate: auto 0deg;\n}\n\n.truck-traveler-mobile {\n  offset-path: path(\"M 20,130 C 80,40 160,180 240,90 C 300,30 350,150 400,100\");\n  animation: travelAlongRoute 10s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite alternate;\n  offset-rotate: auto 0deg;\n}\n\n"
