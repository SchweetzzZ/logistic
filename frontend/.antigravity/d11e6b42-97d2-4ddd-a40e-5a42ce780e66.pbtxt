      replacement_content: "import React from \'react\';\n\ninterface FooterProps {\n  onOpenLogin: () => void;\n  onOpenRegister: () => void;\n  onScrollToSimulator: () => void;\n  onScrollToHowItWorks: () => void;\n  onScrollToPartnership: () => void;\n}\n\nexport const Footer: React.FC<FooterProps> = ({\n  onOpenLogin,\n  onOpenRegister,\n  onScrollToSimulator,\n  onScrollToHowItWorks,\n  onScrollToPartnership,\n}) => {\n  return (\n    <footer className=\"bg-zinc-950 border-t border-zinc-800/80 pt-16 pb-12 text-zinc-400 text-xs\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* Barra superior do footer com status s\303\263brio */}\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-10 border-b border-zinc-800/80\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"flex items-center justify-center w-7 h-7 rounded-lg bg-zinc-900 border border-zinc-800\">\n              <svg\n                className=\"w-3.5 h-3.5 text-emerald-400\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                strokeWidth=\"2.5\"\n                strokeLinecap=\"round\"\n                strokeLinejoin=\"round\"\n              >\n                <polyline points=\"13 17 18 12 13 7\" />\n                <polyline points=\"6 17 11 12 6 7\" />\n              </svg>\n            </div>\n            <span className=\"text-sm font-semibold text-white tracking-tight\">LogiFlow</span>\n            <span className=\"text-zinc-600\">|</span>\n            <span className=\"text-xs text-zinc-400\">Gest\303\243o e simula\303\247\303\243o inteligente de fretes B2B</span>\n          </div>\n\n          {/* Status s\303\263brio da plataforma */}\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-md bg-zinc-900 border border-zinc-800 text-xs text-zinc-300\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-400\" />\n            <span>Sistemas operacionais</span>\n            <span className=\"text-zinc-600\">\342\200\242</span>\n            <span className=\"text-zinc-400 font-mono\">Tabelas ativas</span>\n          </div>\n        </div>\n\n        {/* Links organizados por categorias */}\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-8 py-10\">\n          \n          {/* Categoria 1: Produto */}\n          <div>\n            <h4 className=\"text-xs font-medium text-zinc-200 mb-3.5\">\n              Produto\n            </h4>\n            <ul className=\"space-y-2.5\">\n              <li>\n                <button\n                  onClick={onScrollToSimulator}\n                  className=\"hover:text-zinc-200 transition cursor-pointer\"\n                >\n                  Simulador de frete\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={onScrollToHowItWorks}\n                  className=\"hover:text-zinc-200 transition cursor-pointer\"\n                >\n                  Como funciona\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={onScrollToPartnership}\n                  className=\"hover:text-zinc-200 transition cursor-pointer\"\n                >\n                  C\303\241lculo de cubagem\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Categoria 2: Portais */}\n          <div>\n            <h4 className=\"text-xs font-medium text-zinc-200 mb-3.5\">\n              Acesso\n            </h4>\n            <ul className=\"space-y-2.5\">\n              <li>\n                <a\n                  href=\"/login\"\n                  onClick={(e) => {\n                    e.preventDefault();\n                    onOpenLogin();\n                  }}\n                  className=\"hover:text-zinc-200 transition cursor-pointer\"\n                >\n                  Entrar no sistema\n                </a>\n              </li>\n              <li>\n                <a\n                  href=\"/register\"\n                  onClick={(e) => {\n                    e.preventDefault();\n                    onOpenRegister();\n                  }}\n                  className=\"hover:text-zinc-200 transition cursor-pointer\"\n                >\n                  Cadastrar empresa\n                </a>\n              </li>\n              <li>\n                <button\n                  onClick={onScrollToPartnership}\n                  className=\"hover:text-zinc-200 transition cursor-pointer\"\n                >\n                  Para transportadoras\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Categoria 3: Opera\303\247\303\243o */}\n          <div>\n            <h4 className=\"text-xs font-medium text-zinc-200 mb-3.5\">\n              Operacional\n            </h4>\n            <ul className=\"space-y-2.5 text-zinc-400\">\n              <li>Cargas fracionadas</li>\n              <li>Lota\303\247\303\243o e linha direta</li>\n              <li>Tabelas integradas</li>\n              <li>Emiss\303\243o de minutas</li>\n            </ul>\n          </div>\n\n          {/* Categoria 4: Institucional & Legal */}\n          <div>\n            <h4 className=\"text-xs font-medium text-zinc-200 mb-3.5\">\n              Institucional\n            </h4>\n            <ul className=\"space-y-2.5\">\n              <li>\n                <span className=\"text-zinc-400\">Termos de uso</span>\n              </li>\n              <li>\n                <span className=\"text-zinc-400\">Pol\303\255tica de privacidade</span>\n              </li>\n              <li>\n                <span className=\"text-zinc-400\">Seguran\303\247a de dados</span>\n              </li>\n            </ul>\n          </div>\n\n        </div>\n\n        {/* Copyright institucional */}\n        <div className=\"pt-8 border-t border-zinc-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-zinc-500\">\n          <p>\n            \302\251 {new Date().getFullYear()} LogiFlow. Todos os direitos reservados.\n          </p>\n          <div className=\"flex items-center gap-4 text-[11px] font-mono\">\n            <span>Ambiente multi-tenant</span>\n            <span>\342\200\242</span>\n            <span>v2.4</span>\n          </div>\n        </div>\n\n      </div>\n    </footer>\n  );\n};\n"
