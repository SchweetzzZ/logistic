  view_file {
    absolute_path_uri: "file:///src/components/Footer.tsx"
    end_line: 188
    content: "import React from \'react\';\n\ninterface FooterProps {\n  onOpenLogin: () => void;\n  onOpenRegister: () => void;\n  onScrollToSimulator: () => void;\n}\n\nexport const Footer: React.FC<FooterProps> = ({\n  onOpenLogin,\n  onOpenRegister,\n  onScrollToSimulator,\n}) => {\n  return (\n    <footer className=\"bg-zinc-950 border-t border-zinc-800/80 pt-16 pb-12 text-zinc-400 text-xs\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* TOP STATUS BAR */}\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-12 border-b border-zinc-800/80\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"flex items-center justify-center w-7 h-7 rounded-lg bg-zinc-900 border border-zinc-800\">\n              <svg\n                className=\"w-3.5 h-3.5 text-emerald-400\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                strokeWidth=\"2.5\"\n                strokeLinecap=\"round\"\n                strokeLinejoin=\"round\"\n              >\n                <polyline points=\"13 17 18 12 13 7\" />\n                <polyline points=\"6 17 11 12 6 7\" />\n              </svg>\n            </div>\n            <span className=\"text-base font-bold text-white tracking-tight\">LogiFlow</span>\n            <span className=\"text-[10px] font-mono uppercase px-1.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-400\">\n              Enterprise\n            </span>\n          </div>\n\n          {/* Operational status indicator requested explicitly */}\n          <div className=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900/80 border border-zinc-800 text-xs text-zinc-300\">\n            <span className=\"relative flex h-2 w-2\">\n              <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\" />\n              <span className=\"relative inline-flex rounded-full h-2 w-2 bg-emerald-500\" />\n            </span>\n            <span className=\"font-medium text-zinc-200\">Todos os sistemas operacionais</span>\n            <span className=\"text-zinc-600\">\342\200\242</span>\n            <span className=\"font-mono text-emerald-400\">99.9% uptime</span>\n          </div>\n        </div>\n\n        {/* 4 INSTITUTIONAL COLUMNS */}\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-8 py-12\">\n          {/* Col 1: Plataforma */}\n          <div>\n            <h4 className=\"text-xs font-semibold uppercase tracking-wider text-zinc-200 mb-4 font-mono\">\n              Plataforma\n            </h4>\n            <ul className=\"space-y-2.5\">\n              <li>\n                <button\n                  onClick={onScrollToSimulator}\n                  className=\"hover:text-zinc-200 transition\"\n                >\n                  Simulador de frete\n                </button>\n              </li>\n              <li>\n                <a href=\"#rastreio\" className=\"hover:text-zinc-200 transition\">\n                  Telemetria & Rastreamento\n                </a>\n              </li>\n              <li>\n                <button\n                  onClick={onOpenLogin}\n                  className=\"hover:text-zinc-200 transition\"\n                >\n                  Portal do cliente\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={onOpenRegister}\n                  className=\"hover:text-zinc-200 transition\"\n                >\n                  Portal do transportador\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 2: Solu\303\247\303\265es */}\n          <div>\n            <h4 className=\"text-xs font-semibold uppercase tracking-wider text-zinc-200 mb-4 font-mono\">\n              Solu\303\247\303\265es\n            </h4>\n            <ul className=\"space-y-2.5\">\n              <li>\n                <a href=\"#solucoes\" className=\"hover:text-zinc-200 transition\">\n                  Gest\303\243o para embarcadores\n                </a>\n              </li>\n              <li>\n                <a href=\"#solucoes\" className=\"hover:text-zinc-200 transition\">\n                  Gest\303\243o para frotistas\n                </a>\n              </li>\n              <li>\n                <a href=\"#diferenciais\" className=\"hover:text-zinc-200 transition\">\n                  C\303\241lculo de cubagem 3D\n                </a>\n              </li>\n              <li>\n                <a href=\"#diferenciais\" className=\"hover:text-zinc-200 transition\">\n                  Auditoria de frete & faturas\n                </a>\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 3: Conformidade */}\n          <div>\n            <h4 className=\"text-xs font-semibold uppercase tracking-wider text-zinc-200 mb-4 font-mono\">\n              Conformidade\n            </h4>\n            <ul className=\"space-y-2.5\">\n              <li>\n                <span className=\"text-zinc-400\">Homologa\303\247\303\243o ANTT integrada</span>\n              </li>\n              <li>\n                <span className=\"text-zinc-400\">Valida\303\247\303\243o SEFAZ (CT-e / MDF-e)</span>\n              </li>\n              <li>\n                <span className=\"text-zinc-400\">Seguro RCF-DC & RCTR-C</span>\n              </li>\n              <li>\n                <span className=\"text-zinc-400\">Conformidade LGPD garantida</span>\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 4: Legal */}\n          <div>\n            <h4 className=\"text-xs font-semibold uppercase tracking-wider text-zinc-200 mb-4 font-mono\">\n              Legal\n            </h4>\n            <ul className=\"space-y-2.5\">\n              <li>\n                <a href=\"#termos\" onClick={(e) => e.preventDefault()} className=\"hover:text-zinc-200 transition\">\n                  Termos de servi\303\247o\n                </a>\n              </li>\n              <li>\n                <a href=\"#privacidade\" onClick={(e) => e.preventDefault()} className=\"hover:text-zinc-200 transition\">\n                  Pol\303\255tica de privacidade\n                </a>\n              </li>\n              <li>\n                <a href=\"#sla\" onClick={(e) => e.preventDefault()} className=\"hover:text-zinc-200 transition\">\n                  Acordo de n\303\255vel de servi\303\247o (SLA)\n                </a>\n              </li>\n              <li>\n                <a href=\"#seguranca\" onClick={(e) => e.preventDefault()} className=\"hover:text-zinc-200 transition\">\n                  Seguran\303\247a da informa\303\247\303\243o\n                </a>\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        {/* BOTTOM COPYRIGHT */}\n        <div className=\"pt-8 border-t border-zinc-800/80 flex flex-col sm:flex-row items-center justify-between gap-4\">\n          <p className=\"text-zinc-400\">\n            \302\251 {new Date().getFullYear()} LogiFlow Tecnologia Log\303\255stica S.A. Todos os direitos reservados.\n          </p>\n          <div className=\"flex items-center gap-6\">\n            <span className=\"text-zinc-400\">S\303\243o Paulo \342\200\242 Curitiba \342\200\242 Itaja\303\255</span>\n            <span className=\"text-zinc-600\">|</span>\n            <span className=\"font-mono text-zinc-400\">v2.4.0</span>\n          </div>\n        </div>\n\n      </div>\n    </footer>\n  );\n};\n"
    raw_content: "import React from \'react\';\n\ninterface FooterProps {\n  onOpenLogin: () => void;\n  onOpenRegister: () => void;\n  onScrollToSimulator: () => void;\n}\n\nexport const Footer: React.FC<FooterProps> = ({\n  onOpenLogin,\n  onOpenRegister,\n  onScrollToSimulator,\n}) => {\n  return (\n    <footer className=\"bg-zinc-950 border-t border-zinc-800/80 pt-16 pb-12 text-zinc-400 text-xs\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* TOP STATUS BAR */}\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-12 border-b border-zinc-800/80\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"flex items-center justify-center w-7 h-7 rounded-lg bg-zinc-900 border border-zinc-800\">\n              <svg\n                className=\"w-3.5 h-3.5 text-emerald-400\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                strokeWidth=\"2.5\"\n                strokeLinecap=\"round\"\n                strokeLinejoin=\"round\"\n              >\n                <polyline points=\"13 17 18 12 13 7\" />\n                <polyline points=\"6 17 11 12 6 7\" />\n              </svg>\n            </div>\n            <span className=\"text-base font-bold text-white tracking-tight\">LogiFlow</span>\n            <span className=\"text-[10px] font-mono uppercase px-1.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-400\">\n              Enterprise\n            </span>\n          </div>\n\n          {/* Operational status indicator requested explicitly */}\n          <div className=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900/80 border border-zinc-800 text-xs text-zinc-300\">\n            <span className=\"relative flex h-2 w-2\">\n              <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\" />\n              <span className=\"relative inline-flex rounded-full h-2 w-2 bg-emerald-500\" />\n            </span>\n            <span className=\"font-medium text-zinc-200\">Todos os sistemas operacionais</span>\n            <span className=\"text-zinc-600\">\342\200\242</span>\n            <span className=\"font-mono text-emerald-400\">99.9% uptime</span>\n          </div>\n        </div>\n\n        {/* 4 INSTITUTIONAL COLUMNS */}\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-8 py-12\">\n          {/* Col 1: Plataforma */}\n          <div>\n            <h4 className=\"text-xs font-semibold uppercase tracking-wider text-zinc-200 mb-4 font-mono\">\n              Plataforma\n            </h4>\n            <ul className=\"space-y-2.5\">\n              <li>\n                <button\n                  onClick={onScrollToSimulator}\n                  className=\"hover:text-zinc-200 transition\"\n                >\n                  Simulador de frete\n                </button>\n              </li>\n              <li>\n                <a href=\"#rastreio\" className=\"hover:text-zinc-200 transition\">\n                  Telemetria & Rastreamento\n                </a>\n              </li>\n              <li>\n                <button\n                  onClick={onOpenLogin}\n                  className=\"hover:text-zinc-200 transition\"\n                >\n                  Portal do cliente\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={onOpenRegister}\n                  className=\"hover:text-zinc-200 transition\"\n                >\n                  Portal do transportador\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 2: Solu\303\247\303\265es */}\n          <div>\n            <h4 className=\"text-xs font-semibold uppercase tracking-wider text-zinc-200 mb-4 font-mono\">\n              Solu\303\247\303\265es\n            </h4>\n            <ul className=\"space-y-2.5\">\n              <li>\n                <a href=\"#solucoes\" className=\"hover:text-zinc-200 transition\">\n                  Gest\303\243o para embarcadores\n                </a>\n              </li>\n              <li>\n                <a href=\"#solucoes\" className=\"hover:text-zinc-200 transition\">\n                  Gest\303\243o para frotistas\n                </a>\n              </li>\n              <li>\n                <a href=\"#diferenciais\" className=\"hover:text-zinc-200 transition\">\n                  C\303\241lculo de cubagem 3D\n                </a>\n              </li>\n              <li>\n                <a href=\"#diferenciais\" className=\"hover:text-zinc-200 transition\">\n                  Auditoria de frete & faturas\n                </a>\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 3: Conformidade */}\n          <div>\n            <h4 className=\"text-xs font-semibold uppercase tracking-wider text-zinc-200 mb-4 font-mono\">\n              Conformidade\n            </h4>\n            <ul className=\"space-y-2.5\">\n              <li>\n                <span className=\"text-zinc-400\">Homologa\303\247\303\243o ANTT integrada</span>\n              </li>\n              <li>\n                <span className=\"text-zinc-400\">Valida\303\247\303\243o SEFAZ (CT-e / MDF-e)</span>\n              </li>\n              <li>\n                <span className=\"text-zinc-400\">Seguro RCF-DC & RCTR-C</span>\n              </li>\n              <li>\n                <span className=\"text-zinc-400\">Conformidade LGPD garantida</span>\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 4: Legal */}\n          <div>\n            <h4 className=\"text-xs font-semibold uppercase tracking-wider text-zinc-200 mb-4 font-mono\">\n              Legal\n            </h4>\n            <ul className=\"space-y-2.5\">\n              <li>\n                <a href=\"#termos\" onClick={(e) => e.preventDefault()} className=\"hover:text-zinc-200 transition\">\n                  Termos de servi\303\247o\n                </a>\n              </li>\n              <li>\n                <a href=\"#privacidade\" onClick={(e) => e.preventDefault()} className=\"hover:text-zinc-200 transition\">\n                  Pol\303\255tica de privacidade\n                </a>\n              </li>\n              <li>\n                <a href=\"#sla\" onClick={(e) => e.preventDefault()} className=\"hover:text-zinc-200 transition\">\n                  Acordo de n\303\255vel de servi\303\247o (SLA)\n                </a>\n              </li>\n              <li>\n                <a href=\"#seguranca\" onClick={(e) => e.preventDefault()} className=\"hover:text-zinc-200 transition\">\n                  Seguran\303\247a da informa\303\247\303\243o\n                </a>\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        {/* BOTTOM COPYRIGHT */}\n        <div className=\"pt-8 border-t border-zinc-800/80 flex flex-col sm:flex-row items-center justify-between gap-4\">\n          <p className=\"text-zinc-400\">\n            \302\251 {new Date().getFullYear()} LogiFlow Tecnologia Log\303\255stica S.A. Todos os direitos reservados.\n          </p>\n          <div className=\"flex items-center gap-6\">\n            <span className=\"text-zinc-400\">S\303\243o Paulo \342\200\242 Curitiba \342\200\242 Itaja\303\255</span>\n            <span className=\"text-zinc-600\">|</span>\n            <span className=\"font-mono text-zinc-400\">v2.4.0</span>\n          </div>\n        </div>\n\n      </div>\n    </footer>\n  );\n};\n"
