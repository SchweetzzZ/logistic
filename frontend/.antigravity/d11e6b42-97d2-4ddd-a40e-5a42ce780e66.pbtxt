    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Navbar } from \'./components/Navbar\';\nimport { Hero } from \'./components/Hero\';\nimport { HowItWorks } from \'./components/HowItWorks\';\nimport { SimulatorInvite } from \'./components/SimulatorInvite\';\nimport { PartnershipSection } from \'./components/PartnershipSection\';\nimport { Footer } from \'./components/Footer\';\nimport { Modals } from \'./components/Modals\';\nimport { QuoteOption } from \'./types\';\n\nexport default function App() {\n  const [loginOpen, setLoginOpen] = useState(false);\n  const [registerOpen, setRegisterOpen] = useState(false);\n  const [registerDefaultType, setRegisterDefaultType] = useState<\'embarcador\' | \'transportadora\'>(\'embarcador\');\n  const [simulatorOpen, setSimulatorOpen] = useState(false);\n  const [selectedQuote, setSelectedQuote] = useState<QuoteOption | null>(null);\n\n  const handleScrollToSimulator = () => {\n    const el = document.getElementById(\'simulacao-frete\');\n    if (el) {\n      el.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  const handleScrollToHowItWorks = () => {\n    const el = document.getElementById(\'como-funciona\');\n    if (el) {\n      el.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  const handleScrollToPartnership = () => {\n    const el = document.getElementById(\'parcerias\');\n    if (el) {\n      el.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  const handleOpenRegister = (defaultType: \'embarcador\' | \'transportadora\' = \'embarcador\') => {\n    setRegisterDefaultType(defaultType);\n    setRegisterOpen(true);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-white text-zinc-900 selection:bg-amber-500/20 selection:text-amber-900 font-sans flex flex-col antialiased\">\n      {/* 1. HEADER / NAVBAR (MINIMALISTA E CLARO) */}\n      <Navbar\n        onOpenLogin={() => setLoginOpen(true)}\n        onOpenRegister={() => handleOpenRegister(\'embarcador\')}\n        onScrollToSimulator={handleScrollToSimulator}\n        onScrollToHowItWorks={handleScrollToHowItWorks}\n        onScrollToPartnership={handleScrollToPartnership}\n      />\n\n      <main className=\"flex-1\">\n        {/* 2. HERO SECTION (100% CENTRALIZADO, LIMPO E IMPONENTE) */}\n        <Hero\n          onScrollToSimulator={() => setSimulatorOpen(true)}\n          onOpenRegister={() => handleOpenRegister(\'transportadora\')}\n        />\n\n        {/* 3. STORYTELLING: COMO FUNCIONA O FLUXO (3 ETAPAS) */}\n        <HowItWorks />\n\n        {/* 4. SE\303\207\303\203O DO SIMULADOR (CONVITE NARRATIVO, SEM FORMUL\303\201RIO PESADO) */}\n        <SimulatorInvite\n          onOpenSimulatorModal={() => setSimulatorOpen(true)}\n        />\n\n        {/* 5. SE\303\207\303\203O PARCEIROS (EMBARCADOR & TRANSPORTADORA) */}\n        <PartnershipSection\n          onOpenRegister={handleOpenRegister}\n        />\n      </main>\n\n      {/* 6. FOOTER S\303\223BRIO */}\n      <Footer\n        onOpenLogin={() => setLoginOpen(true)}\n        onOpenRegister={() => handleOpenRegister(\'embarcador\')}\n        onScrollToSimulator={handleScrollToSimulator}\n        onScrollToHowItWorks={handleScrollToHowItWorks}\n        onScrollToPartnership={handleScrollToPartnership}\n      />\n\n      {/* MODALS: /login, /register, /simular-frete, and Freight Contract */}\n      <Modals\n        loginOpen={loginOpen}\n        onCloseLogin={() => setLoginOpen(false)}\n        registerOpen={registerOpen}\n        onCloseRegister={() => setRegisterOpen(false)}\n        registerDefaultType={registerDefaultType}\n        simulatorOpen={simulatorOpen}\n        onCloseSimulator={() => setSimulatorOpen(false)}\n        selectedQuote={selectedQuote}\n        onCloseQuoteModal={() => setSelectedQuote(null)}\n        onSelectQuote={(quote) => setSelectedQuote(quote)}\n        onOpenRegisterFromLogin={() => handleOpenRegister(\'embarcador\')}\n      />\n    </div>\n  );\n}\n"
    }
