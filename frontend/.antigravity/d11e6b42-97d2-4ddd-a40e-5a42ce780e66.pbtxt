      arguments_json: "{\"Content\":\"import React from \'react\';\\nimport { ArrowRight, Building2, Truck, Check } from \'lucide-react\';\\n\\ninterface PartnershipSectionProps {\\n  onOpenRegister: () => void;\\n}\\n\\nexport const PartnershipSection: React.FC<PartnershipSectionProps> = ({ onOpenRegister }) => {\\n  return (\\n    <section id=\\\"parcerias\\\" className=\\\"py-20 md:py-28 border-b border-zinc-800/60\\\">\\n      <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\\\">\\n        \\n        {/* T\303\255tulo da se\303\247\303\243o */}\\n        <div className=\\\"max-w-2xl mb-14\\\">\\n          <p className=\\\"text-xs font-mono uppercase tracking-wider text-emerald-400 mb-2\\\">\\n            Rede colaborativa\\n          </p>\\n          <h2 className=\\\"text-2xl sm:text-3xl font-semibold tracking-tight text-white\\\">\\n            Solu\303\247\303\243o integrada para os dois lados do frete\\n          </h2>\\n          <p className=\\\"text-zinc-400 text-sm sm:text-base mt-2\\\">\\n            Eliminamos o atrito na contrata\303\247\303\243o de fretes com conex\303\265es diretas entre quem despacha e quem transporta.\\n          </p>\\n        </div>\\n\\n        {/* Dois lados da plataforma */}\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-6 mb-12\\\">\\n          \\n          {/* Lado 1: Para o Embarcador */}\\n          <div className=\\\"rounded-xl bg-zinc-900/40 border border-zinc-800/80 p-7 flex flex-col justify-between hover:border-zinc-700 transition\\\">\\n            <div>\\n              <div className=\\\"w-10 h-10 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-300 mb-6\\\">\\n                <Building2 className=\\\"w-5 h-5 text-emerald-400\\\" />\\n              </div>\\n\\n              <span className=\\\"text-xs font-mono text-zinc-500 block mb-1\\\">Perfil corporativo</span>\\n              <h3 className=\\\"text-xl font-semibold text-white mb-3\\\">\\n                Para o embarcador\\n              </h3>\\n              \\n              <p className=\\\"text-sm text-zinc-400 leading-relaxed mb-6\\\">\\n                Centraliza\303\247\303\243o de cota\303\247\303\265es em um \303\272nico lugar, sem perder tempo consultando m\303\272ltiplos canais, planilhas e e-mails dispersos.\\n              </p>\\n\\n              <ul className=\\\"space-y-3 text-xs text-zinc-300\\\">\\n                <li className=\\\"flex items-start gap-2.5\\\">\\n                  <Check className=\\\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\\\" />\\n                  <span>C\303\241lculo volum\303\251trico e cubagem autom\303\241tica com valida\303\247\303\243o de CEP</span>\\n                </li>\\n                <li className=\\\"flex items-start gap-2.5\\\">\\n                  <Check className=\\\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\\\" />\\n                  <span>Comparativo imediato por menor custo ou prazo de entrega</span>\\n                </li>\\n                <li className=\\\"flex items-start gap-2.5\\\">\\n                  <Check className=\\\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\\\" />\\n                  <span>Hist\303\263rico completo de cota\303\247\303\265es e faturamento consolidado</span>\\n                </li>\\n              </ul>\\n            </div>\\n\\n            <div className=\\\"mt-8 pt-6 border-t border-zinc-800/60\\\">\\n              <a\\n                href=\\\"/register\\\"\\n                onClick={(e) => {\\n                  e.preventDefault();\\n                  onOpenRegister();\\n                }}\\n                className=\\\"inline-flex items-center gap-2 text-xs font-medium text-emerald-400 hover:text-emerald-300 transition\\\"\\n              >\\n                <span>Cadastrar como embarcador</span>\\n                <ArrowRight className=\\\"w-3.5 h-3.5\\\" />\\n              </a>\\n            </div>\\n          </div>\\n\\n          {/* Lado 2: Para a Transportadora */}\\n          <div className=\\\"rounded-xl bg-zinc-900/40 border border-zinc-800/80 p-7 flex flex-col justify-between hover:border-zinc-700 transition\\\">\\n            <div>\\n              <div className=\\\"w-10 h-10 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-300 mb-6\\\">\\n                <Truck className=\\\"w-5 h-5 text-emerald-400\\\" />\\n              </div>\\n\\n              <span className=\\\"text-xs font-mono text-zinc-500 block mb-1\\\">Perfil operacional</span>\\n              <h3 className=\\\"text-xl font-semibold text-white mb-3\\\">\\n                Para a transportadora\\n              </h3>\\n              \\n              <p className=\\\"text-sm text-zinc-400 leading-relaxed mb-6\\\">\\n                Canal direto para receber novas demandas qualificadas e gerenciar tabelas de frete em um painel exclusivo e intuitivo.\\n              </p>\\n\\n              <ul className=\\\"space-y-3 text-xs text-zinc-300\\\">\\n                <li className=\\\"flex items-start gap-2.5\\\">\\n                  <Check className=\\\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\\\" />\\n                  <span>Gest\303\243o flex\303\255vel de tabelas tarif\303\241rias por faixa de CEP e peso</span>\\n                </li>\\n                <li className=\\\"flex items-start gap-2.5\\\">\\n                  <Check className=\\\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\\\" />\\n                  <span>Demandas B2B prontas para coleta sem custos de intermedia\303\247\303\243o abusivos</span>\\n                </li>\\n                <li className=\\\"flex items-start gap-2.5\\\">\\n                  <Check className=\\\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\\\" />\\n                  <span>Comunica\303\247\303\243o direta com o cliente para emiss\303\243o de CTe e manifesto</span>\\n                </li>\\n              </ul>\\n            </div>\\n\\n            <div className=\\\"mt-8 pt-6 border-t border-zinc-800/60\\\">\\n              <a\\n                href=\\\"/register\\\"\\n                onClick={(e) => {\\n                  e.preventDefault();\\n                  onOpenRegister();\\n                }}\\n                className=\\\"inline-flex items-center gap-2 text-xs font-medium text-emerald-400 hover:text-emerald-300 transition\\\"\\n              >\\n                <span>Cadastrar como transportadora</span>\\n                <ArrowRight className=\\\"w-3.5 h-3.5\\\" />\\n              </a>\\n            </div>\\n          </div>\\n\\n        </div>\\n\\n        {/* CHAMADA DE A\303\207\303\203O FINAL COM BOT\303\203O /register */}\\n        <div className=\\\"rounded-xl bg-zinc-900/80 border border-zinc-800 p-8 text-center flex flex-col sm:flex-row items-center justify-between gap-6\\\">\\n          <div className=\\\"text-left max-w-xl\\\">\\n            <h3 className=\\\"text-lg font-semibold text-white\\\">\\n              Pronto para modernizar a cota\303\247\303\243o de fretes da sua empresa?\\n            </h3>\\n            <p className=\\\"text-xs sm:text-sm text-zinc-400 mt-1\\\">\\n              Crie a conta da sua organiza\303\247\303\243o em minutos e tenha acesso imediato \303\240 plataforma.\\n            </p>\\n          </div>\\n\\n          <a\\n            href=\\\"/register\\\"\\n            onClick={(e) => {\\n              e.preventDefault();\\n              onOpenRegister();\\n            }}\\n            className=\\\"shrink-0 inline-flex items-center justify-center gap-2 text-sm font-medium bg-emerald-500 hover:bg-emerald-400 text-zinc-950 px-6 py-3 rounded-lg transition-all duration-150 shadow-sm cursor-pointer\\\"\\n          >\\n            <span>Cadastrar empresa</span>\\n            <ArrowRight className=\\\"w-4 h-4 text-zinc-950\\\" />\\n          </a>\\n        </div>\\n\\n      </div>\\n    </section>\\n  );\\n};\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/components/PartnershipSection.tsx\", \"toolAction\":\"Creating clean PartnershipSection component\", \"toolSummary\":\"Create PartnershipSection\"}"
      thought_signature: ""
      original_name: "create_file"
    }
