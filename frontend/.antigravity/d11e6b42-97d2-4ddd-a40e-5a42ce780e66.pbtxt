    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Navbar } from \'./components/Navbar\';\nimport { Hero } from \'./components/Hero\';\nimport { FreightSimulator } from \'./components/FreightSimulator\';\nimport { CargoTracking } from \'./components/CargoTracking\';\nimport { SolutionsGrid } from \'./components/SolutionsGrid\';\nimport { PartnerSection } from \'./components/PartnerSection\';\nimport { Footer } from \'./components/Footer\';\nimport { Modals } from \'./components/Modals\';\nimport { QuoteOption } from \'./types\';\n\nexport default function App() {\n  const [loginOpen, setLoginOpen] = useState(false);\n  const [registerOpen, setRegisterOpen] = useState(false);\n  const [selectedQuote, setSelectedQuote] = useState<QuoteOption | null>(null);\n\n  const handleScrollToSimulator = () => {\n    const el = document.getElementById(\'simulador\');\n    if (el) {\n      el.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-zinc-950 text-zinc-100 selection:bg-emerald-500/30 selection:text-emerald-300 font-sans flex flex-col\">\n      {/* NAVBAR */}\n      <Navbar\n        onOpenLogin={() => setLoginOpen(true)}\n        onOpenRegister={() => setRegisterOpen(true)}\n        onScrollToSimulator={handleScrollToSimulator}\n      />\n\n      {/* MAIN CONTENT SECTIONS */}\n      <main className=\"flex-1\">\n        {/* HERO SECTION WITH VECTOR ANIMATED LOGISTICS ROUTE */}\n        <Hero\n          onScrollToSimulator={handleScrollToSimulator}\n          onOpenRegister={() => setRegisterOpen(true)}\n        />\n\n        {/* FREIGHT SIMULATOR WIDGET */}\n        <FreightSimulator\n          onSelectQuote={(quote) => setSelectedQuote(quote)}\n        />\n\n        {/* REAL-TIME CARGO TELEMETRY TRACKING */}\n        <CargoTracking />\n\n        {/* B2B SOLUTIONS & CORE DIFFERENTIALS (SINKA-INSPIRED DUAL AUDIENCE SWITCHER) */}\n        <SolutionsGrid />\n\n        {/* PARTNER / CARRIER EXPANSION SECTION */}\n        <PartnerSection\n          onOpenRegisterModal={() => setRegisterOpen(true)}\n        />\n      </main>\n\n      {/* FOOTER WITH SYSTEM OPERATIONAL STATUS */}\n      <Footer\n        onOpenLogin={() => setLoginOpen(true)}\n        onOpenRegister={() => setRegisterOpen(true)}\n        onScrollToSimulator={handleScrollToSimulator}\n      />\n\n      {/* MODALS: LOGIN (/login), PARTNER REGISTRATION (/register), AND FREIGHT DISPATCH */}\n      <Modals\n        loginOpen={loginOpen}\n        onCloseLogin={() => setLoginOpen(false)}\n        registerOpen={registerOpen}\n        onCloseRegister={() => setRegisterOpen(false)}\n        selectedQuote={selectedQuote}\n        onCloseQuoteModal={() => setSelectedQuote(null)}\n        onOpenRegisterFromLogin={() => setRegisterOpen(true)}\n      />\n    </div>\n  );\n}\n"
    }
