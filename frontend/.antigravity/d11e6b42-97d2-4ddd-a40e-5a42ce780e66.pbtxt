  file_change {
    absolute_path_uri: "file:///src/components/Hero.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ArrowRight, ChevronRight, ShieldCheck, Clock, Gauge } from \'lucide-react\';\n\ninterface HeroProps {\n  onScrollToSimulator: () => void;\n  onOpenRegister: () => void;\n}\n\nexport const Hero: React.FC<HeroProps> = ({\n  onScrollToSimulator,\n  onOpenRegister,\n}) => {\n  return (\n    <section className=\"relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden\">\n      {/* Background ambient lighting - strictly minimalist, no tacky neon gradients */}\n      <div className=\"absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-emerald-950/15 blur-[120px] rounded-full pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center\">\n          \n          {/* LEFT: TEXT CONTENT & CTAS */}\n          <div className=\"lg:col-span-6 space-y-7 text-left\">\n            {/* Context tag */}\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900/90 border border-zinc-800 text-xs text-zinc-300\">\n              <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" />\n              <span className=\"font-medium\">Rede ativa de transporte nacional</span>\n              <span className=\"text-zinc-600\">\342\200\242</span>\n              <span className=\"text-zinc-400 font-mono\">BR-101 / BR-116</span>\n            </div>\n\n            {/* Headline - Sentence case per instructions */}\n            <h1 className=\"text-4xl sm:text-5xl lg:text-[54px] font-extrabold tracking-tight text-white leading-[1.12]\">\n              Opera\303\247\303\265es de transporte sob controle, da cota\303\247\303\243o \303\240 entrega final.\n            </h1>\n\n            {/* Subtitle */}\n            <p className=\"text-base sm:text-lg text-zinc-400 leading-relaxed max-w-xl\">\n              Plataforma inteligente de despacho de cargas, c\303\241lculo de cubagem multi-transportadora e telemetria em tempo real para o ecossistema log\303\255stico.\n            </p>\n\n            {/* CTAs */}\n            <div className=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2\">\n              <button\n                onClick={onScrollToSimulator}\n                className=\"inline-flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-semibold px-6 py-3.5 rounded-lg text-sm transition-all duration-150 active:scale-[0.98] shadow-sm group\"\n              >\n                <span>Simular frete agora</span>\n                <ArrowRight className=\"w-4 h-4 transition-transform group-hover:translate-x-0.5\" />\n              </button>\n\n              <button\n                onClick={onOpenRegister}\n                className=\"inline-flex items-center justify-center gap-2 bg-zinc-900/80 hover:bg-zinc-800 text-zinc-200 border border-zinc-800 font-medium px-6 py-3.5 rounded-lg text-sm transition-all duration-150 active:scale-[0.98]\"\n              >\n                <span>Cadastrar minha transportadora</span>\n                <ChevronRight className=\"w-4 h-4 text-zinc-500\" />\n              </button>\n            </div>\n\n            {/* Key trust facts - clean sentence case */}\n            <div className=\"pt-6 border-t border-zinc-800/80 grid grid-cols-3 gap-4 text-left\">\n              <div>\n                <p className=\"text-2xl font-bold font-mono text-zinc-100\">99.8%</p>\n                <p className=\"text-xs text-zinc-400 mt-0.5\">SLA de pontualidade</p>\n              </div>\n              <div>\n                <p className=\"text-2xl font-bold font-mono text-zinc-100\">-24%</p>\n                <p className=\"text-xs text-zinc-400 mt-0.5\">Custo com cubagem inteligente</p>\n              </div>\n              <div>\n                <p className=\"text-2xl font-bold font-mono text-zinc-100\">4.2k+</p>\n                <p className=\"text-xs text-zinc-400 mt-0.5\">Frotistas homologados</p>\n              </div>\n            </div>\n          </div>\n\n          {/* RIGHT: VECTOR ANIMATED LOGISTICS ROUTE & TELEMETRY */}\n          <div className=\"lg:col-span-6\">\n            <div className=\"relative bg-zinc-900/60 border border-zinc-800 rounded-2xl p-6 sm:p-7 backdrop-blur-sm shadow-xl\">\n              \n              {/* Card top bar */}\n              <div className=\"flex items-center justify-between pb-4 mb-4 border-b border-zinc-800/80 text-xs\">\n                <div className=\"flex items-center gap-2\">\n                  <div className=\"w-2.5 h-2.5 rounded-full bg-emerald-500\" />\n                  <span className=\"font-semibold text-zinc-200\">Monitoramento de rota ativo</span>\n                </div>\n                <span className=\"font-mono text-zinc-400\">ID #LGF-9481</span>\n              </div>\n\n              {/* FLOATING STATUS PILL: TOP */}\n              <div className=\"mb-4 bg-zinc-950/80 border border-zinc-800/90 rounded-lg p-3 flex items-center justify-between\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-8 h-8 rounded-md bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400\">\n                    <Gauge className=\"w-4 h-4\" />\n                  </div>\n                  <div>\n                    <div className=\"flex items-center gap-1.5\">\n                      <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping\" />\n                      <p className=\"text-xs font-semibold text-zinc-100\">Carga despachada \342\200\242 BR-101 Sul</p>\n                    </div>\n                    <p className=\"text-[11px] text-zinc-400\">Velocidade est\303\241vel \342\200\242 78 km/h</p>\n                  </div>\n                </div>\n                <div className=\"text-right\">\n                  <span className=\"text-[10px] font-mono text-emerald-400 bg-emerald-950/40 border border-emerald-800/40 px-2 py-0.5 rounded\">\n                    SLA 99.8%\n                  </span>\n                  <p className=\"text-[11px] text-zinc-400 mt-1\">Previs\303\243o: No prazo</p>\n                </div>\n              </div>\n\n              {/* SVG ROUTE GRAPHIC WITH ANIMATED DASH AND MOVING FREIGHT TRUCK */}\n              <div className=\"relative w-full aspect-[16/9] sm:aspect-[2/1] bg-zinc-950/90 border border-zinc-800/70 rounded-xl overflow-hidden flex items-center justify-center\">\n                \n                {/* Subtle grid reference lines for engineering aesthetic */}\n                <div className=\"absolute inset-0 bg-[linear-gradient(to_right,#27272a15_1px,transparent_1px),linear-gradient(to_bottom,#27272a15_1px,transparent_1px)] bg-[size:32px_32px]\" />\n\n                <svg\n                  viewBox=\"0 0 680 320\"\n                  className=\"w-full h-full relative z-10\"\n                  preserveAspectRatio=\"xMidYMid meet\"\n                >\n                  <defs>\n                    <linearGradient id=\"routeGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                      <stop offset=\"0%\" stopColor=\"#22c55e\" stopOpacity=\"0.4\" />\n                      <stop offset=\"50%\" stopColor=\"#22c55e\" stopOpacity=\"0.9\" />\n                      <stop offset=\"100%\" stopColor=\"#22c55e\" stopOpacity=\"0.4\" />\n                    </linearGradient>\n\n                    <filter id=\"emeraldGlow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n                      <feGaussianBlur stdDeviation=\"3\" result=\"blur\" />\n                      <feComposite in=\"SourceGraphic\" in2=\"blur\" operator=\"over\" />\n                    </filter>\n                  </defs>\n\n                  {/* Base corridor highway background path */}\n                  <path\n                    d=\"M 50,210 C 170,110 270,240 370,140 C 470,40 550,230 630,120\"\n                    fill=\"none\"\n                    stroke=\"#27272a\"\n                    strokeWidth=\"4\"\n                    strokeLinecap=\"round\"\n                  />\n\n                  {/* Animated dotted active logistics transit line */}\n                  <path\n                    d=\"M 50,210 C 170,110 270,240 370,140 C 470,40 550,230 630,120\"\n                    fill=\"none\"\n                    stroke=\"url(#routeGradient)\"\n                    strokeWidth=\"3\"\n                    strokeLinecap=\"round\"\n                    className=\"route-dash-animated\"\n                    filter=\"url(#emeraldGlow)\"\n                  />\n\n                  {/* WAYPOINT 1: ORIGEM (Cajamar, SP) */}\n                  <g transform=\"translate(50, 210)\">\n                    <circle r=\"14\" fill=\"#09090b\" stroke=\"#27272a\" strokeWidth=\"2\" />\n                    <circle r=\"6\" fill=\"#22c55e\" />\n                    <text\n                      x=\"0\"\n                      y=\"-22\"\n                      textAnchor=\"middle\"\n                      fill=\"#e4e4e7\"\n                      fontSize=\"11\"\n                      fontWeight=\"600\"\n                      fontFamily=\"Plus Jakarta Sans, sans-serif\"\n                    >\n                      Origem: CD Cajamar\n                    </text>\n                    <text\n                      x=\"0\"\n                      y=\"26\"\n                      textAnchor=\"middle\"\n                      fill=\"#71717a\"\n                      fontSize=\"9\"\n                      fontFamily=\"JetBrains Mono, monospace\"\n                    >\n                      SP-330 km 38\n                    </text>\n                  </g>\n\n                  {/* WAYPOINT 2: HUB CROSSDOCKING (Curitiba, PR) */}\n                  <g transform=\"translate(370, 140)\">\n                    <circle r=\"16\" fill=\"#09090b\" stroke=\"#3f3f46\" strokeWidth=\"2\" />\n                    <circle r=\"7\" fill=\"#10b981\" />\n                    <circle r=\"12\" fill=\"none\" stroke=\"#22c55e\" strokeWidth=\"1\" strokeDasharray=\"2 3\" opacity=\"0.6\" />\n                    <text\n                      x=\"0\"\n                      y=\"-24\"\n                      textAnchor=\"middle\"\n                      fill=\"#e4e4e7\"\n                      fontSize=\"11\"\n                      fontWeight=\"600\"\n                      fontFamily=\"Plus Jakarta Sans, sans-serif\"\n                    >\n                      Hub Crossdocking\n                    </text>\n                    <text\n                      x=\"0\"\n                      y=\"28\"\n                      textAnchor=\"middle\"\n                      fill=\"#71717a\"\n                      fontSize=\"9\"\n                      fontFamily=\"JetBrains Mono, monospace\"\n                    >\n                      Curitiba / PR\n                    </text>\n                  </g>\n\n                  {/* WAYPOINT 3: DESTINO (Itaja\303\255, SC) */}\n                  <g transform=\"translate(630, 120)\">\n                    <circle r=\"14\" fill=\"#09090b\" stroke=\"#27272a\" strokeWidth=\"2\" />\n                    <circle r=\"6\" fill=\"#22c55e\" />\n                    <text\n                      x=\"0\"\n                      y=\"-22\"\n                      textAnchor=\"middle\"\n                      fill=\"#e4e4e7\"\n                      fontSize=\"11\"\n                      fontWeight=\"600\"\n                      fontFamily=\"Plus Jakarta Sans, sans-serif\"\n                    >\n                      Destino: Porto Seco\n                    </text>\n                    <text\n                      x=\"0\"\n                      y=\"26\"\n                      textAnchor=\"middle\"\n                      fill=\"#71717a\"\n                      fontSize=\"9\"\n                      fontFamily=\"JetBrains Mono, monospace\"\n                    >\n                      Itaja\303\255 / SC\n                    </text>\n                  </g>\n\n                  {/* MOVING FREIGHT TRUCK / TELEMETRY VEHICLE (PURE SVG ANIMATEMOTION FOR 60FPS) */}\n                  <g>\n                    <animateMotion\n                      path=\"M 50,210 C 170,110 270,240 370,140 C 470,40 550,230 630,120\"\n                      dur=\"14s\"\n                      repeatCount=\"indefinite\"\n                      rotate=\"auto\"\n                    />\n\n                    {/* Beacon glow halo */}\n                    <circle r=\"18\" fill=\"#22c55e\" opacity=\"0.15\" />\n                    <circle r=\"8\" fill=\"#22c55e\" opacity=\"0.3\" />\n\n                    {/* Freight truck vehicle body */}\n                    <rect\n                      x=\"-14\"\n                      y=\"-7\"\n                      width=\"28\"\n                      height=\"14\"\n                      rx=\"3\"\n                      fill=\"#09090b\"\n                      stroke=\"#22c55e\"\n                      strokeWidth=\"1.5\"\n                    />\n                    {/* Truck cab */}\n                    <rect\n                      x=\"7\"\n                      y=\"-5\"\n                      width=\"6\"\n                      height=\"10\"\n                      rx=\"1\"\n                      fill=\"#22c55e\"\n                    />\n                    {/* Live signal dot */}\n                    <circle cx=\"-6\" cy=\"0\" r=\"2\" fill=\"#22c55e\" />\n                  </g>\n                </svg>\n              </div>\n\n              {/* FLOATING STATUS PILL: BOTTOM */}\n              <div className=\"mt-4 grid grid-cols-2 gap-3\">\n                <div className=\"bg-zinc-950/80 border border-zinc-800/80 rounded-lg p-2.5 flex items-center gap-2.5\">\n                  <div className=\"w-2 h-2 rounded-full bg-emerald-400 shrink-0\" />\n                  <div className=\"min-w-0\">\n                    <p className=\"text-[11px] font-medium text-zinc-200 truncate\">Telemetria de temperatura</p>\n                    <p className=\"text-[10px] font-mono text-zinc-400\">18.4\302\260C \342\200\242 Carga refrigerada</p>\n                  </div>\n                </div>\n\n                <div className=\"bg-zinc-950/80 border border-zinc-800/80 rounded-lg p-2.5 flex items-center gap-2.5\">\n                  <div className=\"w-2 h-2 rounded-full bg-emerald-400 shrink-0\" />\n                  <div className=\"min-w-0\">\n                    <p className=\"text-[11px] font-medium text-zinc-200 truncate\">Seguro de carga ativo</p>\n                    <p className=\"text-[10px] font-mono text-zinc-400\">R$ 380.000,00 coberto</p>\n                  </div>\n                </div>\n              </div>\n\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
