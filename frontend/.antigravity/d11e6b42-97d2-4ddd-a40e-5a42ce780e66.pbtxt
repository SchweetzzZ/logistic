  view_file {
    absolute_path_uri: "file:///src/components/SolutionsGrid.tsx"
    end_line: 9
    content: "import React, { useState } from \'react\';\nimport { \n  TrendingDown, \n  Activity, \n  Zap, \n  ShieldCheck, \n  Boxes, \n  FileCheck2, \n  Route, \n  BarChart3,"
    raw_content: "import React, { useState } from \'react\';\nimport { \n  TrendingDown, \n  Activity, \n  Zap, \n  ShieldCheck, \n  Boxes, \n  FileCheck2, \n  Route, \n  BarChart3,\n  ChevronRight\n} from \'lucide-react\';\nimport { SolutionAudience } from \'../types\';\n\nexport const SolutionsGrid: React.FC = () => {\n  const [audience, setAudience] = useState<SolutionAudience>(\'embarcador\');\n\n  const coreDifferentials = [\n    {\n      icon: TrendingDown,\n      title: \'Redu\303\247\303\243o imediata de custos de frete\',\n      description: \'Algoritmo inteligente que cruza cubagem e tabelas para encontrar a op\303\247\303\243o mais econ\303\264mica para cada envio.\',\n      highlight: \'-24% em m\303\251dia\',\n      metric: \'Otimiza\303\247\303\243o volum\303\251trica\',\n    },\n    {\n      icon: Activity,\n      title: \'Visibilidade total de ponta a ponta\',\n      description: \'Acompanhamento passo a passo do status da carga com previs\303\265es de entrega precisas para o cliente final.\',\n      highlight: \'SLA 99.8%\',\n      metric: \'Telemetria em tempo real\',\n    },\n    {\n      icon: Zap,\n      title: \'Despacho \303\241gil e sem burocracia\',\n      description: \'Integra\303\247\303\243o fluida entre o embarcador e a transportadora, agilizando coletas e etiquetas em poucos cliques.\',\n      highlight: \'< 2 min\',\n      metric: \'Emiss\303\243o e averba\303\247\303\243o\',\n    },\n    {\n      icon: ShieldCheck,\n      title: \'Rede homologada de transportadoras\',\n      description: \'Conecte sua carga apenas a parceiros verificados com hist\303\263rico comprovado de pontualidade e seguran\303\247a.\',\n      highlight: \'100% verificadas\',\n      metric: \'ANTT e ap\303\263lice ativa\',\n    },\n  ];\n\n  const audienceSpecificFeatures = {\n    embarcador: [\n      {\n        title: \'Cota\303\247\303\243o multi-transportadora centralizada\',\n        desc: \'Unifique tabelas contratuais e cota\303\247\303\265es spot em um \303\272nico painel sem planilhas dispersas.\',\n      },\n      {\n        title: \'Auditoria e confer\303\252ncia de faturas (CT-e)\',\n        desc: \'Identifica\303\247\303\243o autom\303\241tica de diverg\303\252ncias de peso, cubagem, ped\303\241gio e cobran\303\247as indevidas.\',\n      },\n      {\n        title: \'Gest\303\243o de ocorr\303\252ncias e estadias\',\n        desc: \'Registro digital com geolocaliza\303\247\303\243o de recusas, avarias parciais e tempo de espera em doca.\',\n      },\n    ],\n    transportador: [\n      {\n        title: \'Capta\303\247\303\243o cont\303\255nua de fretes de retorno\',\n        desc: \'Reduza a ociosidade da sua frota com cargas compat\303\255veis no trajeto de volta.\',\n      },\n      {\n        title: \'Emiss\303\243o automatizada de MDF-e em lote\',\n        desc: \'Gera\303\247\303\243o e sincroniza\303\247\303\243o tribut\303\241ria com SEFAZ em segundos diretamente pelo LogiFlow.\',\n      },\n      {\n        title: \'Pontualidade de pagamento e adiantamento\',\n        desc: \'Fluxo financeiro transparente com liquida\303\247\303\243o garantida e antecipa\303\247\303\243o de frete descomplicada.\',\n      },\n    ],\n  };\n\n  return (\n    <section id=\"diferenciais\" className=\"py-20 relative scroll-mt-24\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* SECTION HEADER */}\n        <div className=\"max-w-3xl mb-12\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-xs text-zinc-300 mb-3\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n            <span>Diferenciais de engenharia log\303\255stica</span>\n          </div>\n          <h2 className=\"text-3xl sm:text-4xl font-bold tracking-tight text-white mb-3\">\n            Efici\303\252ncia operacional projetada para alto volume\n          </h2>\n          <p className=\"text-sm sm:text-base text-zinc-400\">\n            Arquitetura desenhada para eliminar gargalos manuais, mitigar preju\303\255zos com cubagem inadequada e dar transpar\303\252ncia completa aos envolvidos.\n          </p>\n        </div>\n\n        {/* CORE 4 DIFFERENTIALS GRID (2x2) */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5 mb-14\">\n          {coreDifferentials.map((item, index) => {\n            const IconComponent = item.icon;\n            return (\n              <div\n                key={index}\n                className=\"bg-zinc-900/60 border border-zinc-800 hover:border-zinc-700/80 rounded-xl p-6 sm:p-7 backdrop-blur-sm transition-all duration-150 flex flex-col justify-between group\"\n              >\n                <div>\n                  <div className=\"flex items-center justify-between mb-4\">\n                    <div className=\"w-10 h-10 rounded-lg bg-zinc-950 border border-zinc-800 flex items-center justify-center text-emerald-400 group-hover:border-emerald-500/40 transition\">\n                      <IconComponent className=\"w-5 h-5\" />\n                    </div>\n                    <span className=\"text-xs font-mono font-semibold px-2 py-0.5 rounded bg-zinc-950 text-emerald-400 border border-zinc-800\">\n                      {item.highlight}\n                    </span>\n                  </div>\n\n                  <h3 className=\"text-lg font-semibold text-white mb-2\">\n                    {item.title}\n                  </h3>\n                  <p className=\"text-sm text-zinc-400 leading-relaxed\">\n                    {item.description}\n                  </p>\n                </div>\n\n                <div className=\"pt-4 mt-4 border-t border-zinc-800/80 flex items-center justify-between text-xs text-zinc-400\">\n                  <span>Indicador-chave:</span>\n                  <span className=\"font-mono text-zinc-300\">{item.metric}</span>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* AUDIENCE TAB SWITCHER (INSPIRED BY SINKA SEGMENTATION) */}\n        <div id=\"solucoes\" className=\"pt-10 border-t border-zinc-800/80 scroll-mt-24\">\n          \n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8\">\n            <div>\n              <h3 className=\"text-2xl font-bold text-white\">\n                M\303\263dulos sob medida para o seu papel na cadeia\n              </h3>\n              <p className=\"text-xs sm:text-sm text-zinc-400 mt-1\">\n                Selecione o perfil da sua empresa para explorar as solu\303\247\303\265es integradas.\n              </p>\n            </div>\n\n            {/* TAB CONTROLS */}\n            <div className=\"inline-flex p-1 rounded-xl bg-zinc-900 border border-zinc-800 self-start sm:self-auto\">\n              <button\n                onClick={() => setAudience(\'embarcador\')}\n                className={`px-4 py-2 rounded-lg text-xs font-semibold transition ${\n                  audience === \'embarcador\'\n                    ? \'bg-emerald-500 text-zinc-950 shadow-sm\'\n                    : \'text-zinc-400 hover:text-zinc-200\'\n                }`}\n              >\n                Solu\303\247\303\265es para o embarcador\n              </button>\n              <button\n                onClick={() => setAudience(\'transportador\')}\n                className={`px-4 py-2 rounded-lg text-xs font-semibold transition ${\n                  audience === \'transportador\'\n                    ? \'bg-emerald-500 text-zinc-950 shadow-sm\'\n                    : \'text-zinc-400 hover:text-zinc-200\'\n                }`}\n              >\n                Solu\303\247\303\265es para o transportador\n              </button>\n            </div>\n          </div>\n\n          {/* AUDIENCE FEATURE CARDS */}\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n            {audienceSpecificFeatures[audience].map((feat, idx) => (\n              <div\n                key={idx}\n                className=\"bg-zinc-900/40 border border-zinc-800/80 rounded-xl p-5 hover:bg-zinc-900/70 transition\"\n              >\n                <div className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 mb-3\" />\n                <h4 className=\"text-sm font-semibold text-zinc-100 mb-2\">\n                  {feat.title}\n                </h4>\n                <p className=\"text-xs text-zinc-400 leading-relaxed\">\n                  {feat.desc}\n                </p>\n              </div>\n            ))}\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    num_lines: 196
    num_bytes: 7901
  }
}
