  view_file {
    absolute_path_uri: "file:///src/components/FreightSimulator.tsx"
    end_line: 320
    content: "import React, { useState } from \'react\';\nimport { Calculator, ArrowRight, Check, Sparkles, Truck, RefreshCw } from \'lucide-react\';\nimport { QuoteOption } from \'../types\';\n\ninterface FreightSimulatorProps {\n  onSelectQuote: (quote: QuoteOption) => void;\n}\n\nexport const FreightSimulator: React.FC<FreightSimulatorProps> = ({ onSelectQuote }) => {\n  const [cepOrigem, setCepOrigem] = useState(\'07760-000\');\n  const [cepDestino, setCepDestino] = useState(\'88301-000\');\n  const [peso, setPeso] = useState(\'850\');\n  const [dimensoes, setDimensoes] = useState(\'120 x 80 x 140\');\n  const [tipoCarga, setTipoCarga] = useState(\'Geral / Paletizada\');\n\n  const [calculating, setCalculating] = useState(false);\n  const [calculated, setCalculated] = useState(true);\n\n  // Dynamic calculated options\n  const [quoteResults, setQuoteResults] = useState<QuoteOption[]>([\n    {\n      id: \'quote-1\',\n      carrierName: \'TransBrasil Log\303\255stica Integrada\',\n      badge: \'Melhor pre\303\247o\',\n      badgeType: \'best-price\',\n      transitTime: \'3 a 4 dias \303\272teis\',\n      price: 740.0,\n      sla: \'99.4%\',\n      modality: \'Rodovi\303\241rio Fracionado Consolidado\',\n      insuranceIncluded: true,\n    },\n    {\n      id: \'quote-2\',\n      carrierName: \'AeroR\303\241pido Malha Express\',\n      badge: \'Mais r\303\241pido\',\n      badgeType: \'fastest\',\n      transitTime: \'24 a 36 horas\',\n      price: 1280.0,\n      sla: \'99.9%\',\n      modality: \'Expresso Priorit\303\241rio\',\n      insuranceIncluded: true,\n    },\n    {\n      id: \'quote-3\',\n      carrierName: \'LogiSul Transporte Direto\',\n      transitTime: \'2 dias \303\272teis\',\n      price: 920.0,\n      sla: \'99.7%\',\n      modality: \'Linha Direta Dedicada\',\n      insuranceIncluded: true,\n    },\n  ]);\n\n  const handleCalculate = (e: React.FormEvent) => {\n    e.preventDefault();\n    setCalculating(true);\n    \n    // Simulate real algorithm computing dimensional weight and route distance\n    setTimeout(() => {\n      const parsedWeight = parseFloat(peso) || 500;\n      const baseRatio = parsedWeight / 500;\n      \n      setQuoteResults([\n        {\n          id: \'quote-1\',\n          carrierName: \'TransBrasil Log\303\255stica Integrada\',\n          badge: \'Melhor pre\303\247o\',\n          badgeType: \'best-price\',\n          transitTime: \'3 a 4 dias \303\272teis\',\n          price: Math.round(540 * baseRatio * 1.05),\n          sla: \'99.4%\',\n          modality: \'Rodovi\303\241rio Fracionado Consolidado\',\n          insuranceIncluded: true,\n        },\n        {\n          id: \'quote-2\',\n          carrierName: \'AeroR\303\241pido Malha Express\',\n          badge: \'Mais r\303\241pido\',\n          badgeType: \'fastest\',\n          transitTime: \'24 a 36 horas\',\n          price: Math.round(980 * baseRatio * 1.1),\n          sla: \'99.9%\',\n          modality: \'Expresso Priorit\303\241rio\',\n          insuranceIncluded: true,\n        },\n        {\n          id: \'quote-3\',\n          carrierName: \'LogiSul Transporte Direto\',\n          transitTime: \'2 dias \303\272teis\',\n          price: Math.round(720 * baseRatio * 1.08),\n          sla: \'99.7%\',\n          modality: \'Linha Direta Dedicada\',\n          insuranceIncluded: true,\n        },\n      ]);\n      setCalculating(false);\n      setCalculated(true);\n    }, 450);\n  };\n\n  return (\n    <section id=\"simulador\" className=\"py-20 relative scroll-mt-24\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* Section Header */}\n        <div className=\"max-w-3xl mx-auto text-center mb-12 space-y-3\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-xs text-zinc-300\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n            <span>Simulador de cota\303\247\303\243o instant\303\242nea</span>\n          </div>\n          <h2 className=\"text-3xl sm:text-4xl font-bold tracking-tight text-white\">\n            Simula\303\247\303\243o de frete r\303\241pida e precisa\n          </h2>\n          <p className=\"text-sm sm:text-base text-zinc-400\">\n            Cruze tabelas homologadas de dezenas de transportadoras com c\303\241lculo autom\303\241tico de cubagem volum\303\251trica.\n          </p>\n        </div>\n\n        {/* SIMULATOR CONTAINER */}\n        <div className=\"max-w-5xl mx-auto bg-zinc-900/60 border border-zinc-800 rounded-2xl p-6 sm:p-8 backdrop-blur-sm shadow-xl\">\n          \n          {/* INPUTS FORM */}\n          <form onSubmit={handleCalculate} className=\"space-y-6\">\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n              \n              {/* CEP DE ORIGEM - No cluttering generic icons per instructions */}\n              <div>\n                <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                  CEP de Origem\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={cepOrigem}\n                  onChange={(e) => setCepOrigem(e.target.value)}\n                  placeholder=\"00000-000\"\n                  className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm font-mono text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                />\n                <p className=\"text-[11px] text-zinc-400 mt-1\">Cajamar, SP (CD Matriz)</p>\n              </div>\n\n              {/* CEP DE DESTINO */}\n              <div>\n                <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                  CEP de Destino\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={cepDestino}\n                  onChange={(e) => setCepDestino(e.target.value)}\n                  placeholder=\"00000-000\"\n                  className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm font-mono text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                />\n                <p className=\"text-[11px] text-zinc-400 mt-1\">Itaja\303\255, SC (Porto Seco)</p>\n              </div>\n\n              {/* PESO APROXIMADO */}\n              <div>\n                <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                  Peso aproximado (kg)\n                </label>\n                <input\n                  type=\"number\"\n                  required\n                  min=\"1\"\n                  value={peso}\n                  onChange={(e) => setPeso(e.target.value)}\n                  placeholder=\"Ex: 850\"\n                  className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm font-mono text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                />\n                <p className=\"text-[11px] text-zinc-400 mt-1\">Peso real aferido</p>\n              </div>\n\n              {/* DIMENS\303\225ES (C X L X A) */}\n              <div>\n                <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                  Dimens\303\265es (C x L x A cm)\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={dimensoes}\n                  onChange={(e) => setDimensoes(e.target.value)}\n                  placeholder=\"120 x 80 x 140\"\n                  className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm font-mono text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                />\n                <p className=\"text-[11px] text-zinc-400 mt-1\">Cubagem: ~1.34 m\302\263</p>\n              </div>\n\n            </div>\n\n            {/* ACTION ROW */}\n            <div className=\"pt-2 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-zinc-800/80\">\n              <div className=\"flex items-center gap-3 text-xs text-zinc-400\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500\" />\n                <span>Base homologada com 38 transportadoras ativas para a rota SP \342\236\224 SC</span>\n              </div>\n\n              <button\n                type=\"submit\"\n                disabled={calculating}\n                className=\"w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-400 disabled:opacity-75 text-zinc-950 font-semibold px-6 py-2.5 rounded-lg text-sm transition-all duration-150 active:scale-[0.98] shadow-sm\"\n              >\n                {calculating ? (\n                  <>\n                    <RefreshCw className=\"w-4 h-4 animate-spin text-zinc-950\" />\n                    <span>Calculando op\303\247\303\265es de envio...</span>\n                  </>\n                ) : (\n                  <>\n                    <span>Calcular op\303\247\303\265es de envio</span>\n                    <ArrowRight className=\"w-4 h-4\" />\n                  </>\n                )}\n              </button>\n            </div>\n          </form>\n\n          {/* QUOTE RESULTS COMPARISON CARDS */}\n          {calculated && (\n            <div className=\"mt-8 pt-8 border-t border-zinc-800/80\">\n              <div className=\"flex items-center justify-between mb-5\">\n                <div className=\"flex items-center gap-2\">\n                  <h3 className=\"text-sm font-semibold text-zinc-200\">\n                    Cota\303\247\303\265es encontradas para a sua rota\n                  </h3>\n                  <span className=\"text-xs font-mono text-emerald-400 bg-emerald-950/50 border border-emerald-800/40 px-2 py-0.5 rounded\">\n                    3 op\303\247\303\265es ideais\n                  </span>\n                </div>\n                <span className=\"text-xs text-zinc-400\">Valores com ICMS e seguro inclusos</span>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                {quoteResults.map((quote) => (\n                  <div\n                    key={quote.id}\n                    className={`relative rounded-xl p-5 border transition-all duration-150 flex flex-col justify-between ${\n                      quote.badgeType === \'best-price\'\n                        ? \'bg-zinc-950/90 border-emerald-500/40 shadow-sm\'\n                        : \'bg-zinc-950/60 border-zinc-800 hover:border-zinc-700\'\n                    }`}\n                  >\n                    <div>\n                      {/* BADGE (IF ANY) */}\n                      <div className=\"flex items-center justify-between mb-3 min-h-[22px]\">\n                        {quote.badge ? (\n                          <span\n                            className={`text-[11px] font-semibold px-2 py-0.5 rounded ${\n                              quote.badgeType === \'best-price\'\n                                ? \'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30\'\n                                : \'bg-blue-500/15 text-blue-300 border border-blue-500/30\'\n                            }`}\n                          >\n                            {quote.badge}\n                          </span>\n                        ) : (\n                          <span className=\"text-[11px] text-zinc-400 font-mono\">Rota direta</span>\n                        )}\n\n                        <span className=\"text-[11px] font-mono text-zinc-400\">\n                          SLA {quote.sla}\n                        </span>\n                      </div>\n\n                      <h4 className=\"text-base font-bold text-white mb-1 leading-snug\">\n                        {quote.carrierName}\n                      </h4>\n                      <p className=\"text-xs text-zinc-400 mb-4\">{quote.modality}</p>\n\n                      <div className=\"space-y-2 py-3 border-y border-zinc-800/70 mb-4 text-xs\">\n                        <div className=\"flex justify-between text-zinc-300\">\n                          <span className=\"text-zinc-400\">Prazo de entrega:</span>\n                          <span className=\"font-semibold text-zinc-200\">{quote.transitTime}</span>\n                        </div>\n                        <div className=\"flex justify-between text-zinc-300\">\n                          <span className=\"text-zinc-400\">Seguro de carga:</span>\n                          <span className=\"text-emerald-400 font-mono\">Incluso</span>\n                        </div>\n                        <div className=\"flex justify-between text-zinc-300\">\n                          <span className=\"text-zinc-400\">Rastreio telem\303\251trico:</span>\n                          <span className=\"text-emerald-400 font-mono\">Ativo 24/7</span>\n                        </div>\n                      </div>\n                    </div>\n\n                    <div>\n                      <div className=\"mb-4\">\n                        <p className=\"text-[11px] text-zinc-400\">Valor do frete</p>\n                        <p className=\"text-2xl font-extrabold font-mono text-zinc-100\">\n                          R$ {quote.price.toLocaleString(\'pt-BR\', { minimumFractionDigits: 2 })}\n                        </p>\n                      </div>\n\n                      <button\n                        type=\"button\"\n                        onClick={() => onSelectQuote(quote)}\n                        className={`w-full py-2.5 px-3 rounded-lg text-xs font-semibold transition-all duration-150 active:scale-[0.98] flex items-center justify-center gap-1.5 ${\n                          quote.badgeType === \'best-price\'\n                            ? \'bg-emerald-500 hover:bg-emerald-400 text-zinc-950 shadow-sm\'\n                            : \'bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700\'\n                        }`}\n                      >\n                        <span>Contratar frete</span>\n                        <ArrowRight className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    raw_content: "import React, { useState } from \'react\';\nimport { Calculator, ArrowRight, Check, Sparkles, Truck, RefreshCw } from \'lucide-react\';\nimport { QuoteOption } from \'../types\';\n\ninterface FreightSimulatorProps {\n  onSelectQuote: (quote: QuoteOption) => void;\n}\n\nexport const FreightSimulator: React.FC<FreightSimulatorProps> = ({ onSelectQuote }) => {\n  const [cepOrigem, setCepOrigem] = useState(\'07760-000\');\n  const [cepDestino, setCepDestino] = useState(\'88301-000\');\n  const [peso, setPeso] = useState(\'850\');\n  const [dimensoes, setDimensoes] = useState(\'120 x 80 x 140\');\n  const [tipoCarga, setTipoCarga] = useState(\'Geral / Paletizada\');\n\n  const [calculating, setCalculating] = useState(false);\n  const [calculated, setCalculated] = useState(true);\n\n  // Dynamic calculated options\n  const [quoteResults, setQuoteResults] = useState<QuoteOption[]>([\n    {\n      id: \'quote-1\',\n      carrierName: \'TransBrasil Log\303\255stica Integrada\',\n      badge: \'Melhor pre\303\247o\',\n      badgeType: \'best-price\',\n      transitTime: \'3 a 4 dias \303\272teis\',\n      price: 740.0,\n      sla: \'99.4%\',\n      modality: \'Rodovi\303\241rio Fracionado Consolidado\',\n      insuranceIncluded: true,\n    },\n    {\n      id: \'quote-2\',\n      carrierName: \'AeroR\303\241pido Malha Express\',\n      badge: \'Mais r\303\241pido\',\n      badgeType: \'fastest\',\n      transitTime: \'24 a 36 horas\',\n      price: 1280.0,\n      sla: \'99.9%\',\n      modality: \'Expresso Priorit\303\241rio\',\n      insuranceIncluded: true,\n    },\n    {\n      id: \'quote-3\',\n      carrierName: \'LogiSul Transporte Direto\',\n      transitTime: \'2 dias \303\272teis\',\n      price: 920.0,\n      sla: \'99.7%\',\n      modality: \'Linha Direta Dedicada\',\n      insuranceIncluded: true,\n    },\n  ]);\n\n  const handleCalculate = (e: React.FormEvent) => {\n    e.preventDefault();\n    setCalculating(true);\n    \n    // Simulate real algorithm computing dimensional weight and route distance\n    setTimeout(() => {\n      const parsedWeight = parseFloat(peso) || 500;\n      const baseRatio = parsedWeight / 500;\n      \n      setQuoteResults([\n        {\n          id: \'quote-1\',\n          carrierName: \'TransBrasil Log\303\255stica Integrada\',\n          badge: \'Melhor pre\303\247o\',\n          badgeType: \'best-price\',\n          transitTime: \'3 a 4 dias \303\272teis\',\n          price: Math.round(540 * baseRatio * 1.05),\n          sla: \'99.4%\',\n          modality: \'Rodovi\303\241rio Fracionado Consolidado\',\n          insuranceIncluded: true,\n        },\n        {\n          id: \'quote-2\',\n          carrierName: \'AeroR\303\241pido Malha Express\',\n          badge: \'Mais r\303\241pido\',\n          badgeType: \'fastest\',\n          transitTime: \'24 a 36 horas\',\n          price: Math.round(980 * baseRatio * 1.1),\n          sla: \'99.9%\',\n          modality: \'Expresso Priorit\303\241rio\',\n          insuranceIncluded: true,\n        },\n        {\n          id: \'quote-3\',\n          carrierName: \'LogiSul Transporte Direto\',\n          transitTime: \'2 dias \303\272teis\',\n          price: Math.round(720 * baseRatio * 1.08),\n          sla: \'99.7%\',\n          modality: \'Linha Direta Dedicada\',\n          insuranceIncluded: true,\n        },\n      ]);\n      setCalculating(false);\n      setCalculated(true);\n    }, 450);\n  };\n\n  return (\n    <section id=\"simulador\" className=\"py-20 relative scroll-mt-24\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* Section Header */}\n        <div className=\"max-w-3xl mx-auto text-center mb-12 space-y-3\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-xs text-zinc-300\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n            <span>Simulador de cota\303\247\303\243o instant\303\242nea</span>\n          </div>\n          <h2 className=\"text-3xl sm:text-4xl font-bold tracking-tight text-white\">\n            Simula\303\247\303\243o de frete r\303\241pida e precisa\n          </h2>\n          <p className=\"text-sm sm:text-base text-zinc-400\">\n            Cruze tabelas homologadas de dezenas de transportadoras com c\303\241lculo autom\303\241tico de cubagem volum\303\251trica.\n          </p>\n        </div>\n\n        {/* SIMULATOR CONTAINER */}\n        <div className=\"max-w-5xl mx-auto bg-zinc-900/60 border border-zinc-800 rounded-2xl p-6 sm:p-8 backdrop-blur-sm shadow-xl\">\n          \n          {/* INPUTS FORM */}\n          <form onSubmit={handleCalculate} className=\"space-y-6\">\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n              \n              {/* CEP DE ORIGEM - No cluttering generic icons per instructions */}\n              <div>\n                <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                  CEP de Origem\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={cepOrigem}\n                  onChange={(e) => setCepOrigem(e.target.value)}\n                  placeholder=\"00000-000\"\n                  className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm font-mono text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                />\n                <p className=\"text-[11px] text-zinc-400 mt-1\">Cajamar, SP (CD Matriz)</p>\n              </div>\n\n              {/* CEP DE DESTINO */}\n              <div>\n                <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                  CEP de Destino\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={cepDestino}\n                  onChange={(e) => setCepDestino(e.target.value)}\n                  placeholder=\"00000-000\"\n                  className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm font-mono text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                />\n                <p className=\"text-[11px] text-zinc-400 mt-1\">Itaja\303\255, SC (Porto Seco)</p>\n              </div>\n\n              {/* PESO APROXIMADO */}\n              <div>\n                <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                  Peso aproximado (kg)\n                </label>\n                <input\n                  type=\"number\"\n                  required\n                  min=\"1\"\n                  value={peso}\n                  onChange={(e) => setPeso(e.target.value)}\n                  placeholder=\"Ex: 850\"\n                  className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm font-mono text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                />\n                <p className=\"text-[11px] text-zinc-400 mt-1\">Peso real aferido</p>\n              </div>\n\n              {/* DIMENS\303\225ES (C X L X A) */}\n              <div>\n                <label className=\"block text-xs font-medium text-zinc-300 mb-1.5\">\n                  Dimens\303\265es (C x L x A cm)\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={dimensoes}\n                  onChange={(e) => setDimensoes(e.target.value)}\n                  placeholder=\"120 x 80 x 140\"\n                  className=\"w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3.5 py-2.5 text-sm font-mono text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition\"\n                />\n                <p className=\"text-[11px] text-zinc-400 mt-1\">Cubagem: ~1.34 m\302\263</p>\n              </div>\n\n            </div>\n\n            {/* ACTION ROW */}\n            <div className=\"pt-2 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-zinc-800/80\">\n              <div className=\"flex items-center gap-3 text-xs text-zinc-400\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500\" />\n                <span>Base homologada com 38 transportadoras ativas para a rota SP \342\236\224 SC</span>\n              </div>\n\n              <button\n                type=\"submit\"\n                disabled={calculating}\n                className=\"w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-400 disabled:opacity-75 text-zinc-950 font-semibold px-6 py-2.5 rounded-lg text-sm transition-all duration-150 active:scale-[0.98] shadow-sm\"\n              >\n                {calculating ? (\n                  <>\n                    <RefreshCw className=\"w-4 h-4 animate-spin text-zinc-950\" />\n                    <span>Calculando op\303\247\303\265es de envio...</span>\n                  </>\n                ) : (\n                  <>\n                    <span>Calcular op\303\247\303\265es de envio</span>\n                    <ArrowRight className=\"w-4 h-4\" />\n                  </>\n                )}\n              </button>\n            </div>\n          </form>\n\n          {/* QUOTE RESULTS COMPARISON CARDS */}\n          {calculated && (\n            <div className=\"mt-8 pt-8 border-t border-zinc-800/80\">\n              <div className=\"flex items-center justify-between mb-5\">\n                <div className=\"flex items-center gap-2\">\n                  <h3 className=\"text-sm font-semibold text-zinc-200\">\n                    Cota\303\247\303\265es encontradas para a sua rota\n                  </h3>\n                  <span className=\"text-xs font-mono text-emerald-400 bg-emerald-950/50 border border-emerald-800/40 px-2 py-0.5 rounded\">\n                    3 op\303\247\303\265es ideais\n                  </span>\n                </div>\n                <span className=\"text-xs text-zinc-400\">Valores com ICMS e seguro inclusos</span>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                {quoteResults.map((quote) => (\n                  <div\n                    key={quote.id}\n                    className={`relative rounded-xl p-5 border transition-all duration-150 flex flex-col justify-between ${\n                      quote.badgeType === \'best-price\'\n                        ? \'bg-zinc-950/90 border-emerald-500/40 shadow-sm\'\n                        : \'bg-zinc-950/60 border-zinc-800 hover:border-zinc-700\'\n                    }`}\n                  >\n                    <div>\n                      {/* BADGE (IF ANY) */}\n                      <div className=\"flex items-center justify-between mb-3 min-h-[22px]\">\n                        {quote.badge ? (\n                          <span\n                            className={`text-[11px] font-semibold px-2 py-0.5 rounded ${\n                              quote.badgeType === \'best-price\'\n                                ? \'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30\'\n                                : \'bg-blue-500/15 text-blue-300 border border-blue-500/30\'\n                            }`}\n                          >\n                            {quote.badge}\n                          </span>\n                        ) : (\n                          <span className=\"text-[11px] text-zinc-400 font-mono\">Rota direta</span>\n                        )}\n\n                        <span className=\"text-[11px] font-mono text-zinc-400\">\n                          SLA {quote.sla}\n                        </span>\n                      </div>\n\n                      <h4 className=\"text-base font-bold text-white mb-1 leading-snug\">\n                        {quote.carrierName}\n                      </h4>\n                      <p className=\"text-xs text-zinc-400 mb-4\">{quote.modality}</p>\n\n                      <div className=\"space-y-2 py-3 border-y border-zinc-800/70 mb-4 text-xs\">\n                        <div className=\"flex justify-between text-zinc-300\">\n                          <span className=\"text-zinc-400\">Prazo de entrega:</span>\n                          <span className=\"font-semibold text-zinc-200\">{quote.transitTime}</span>\n                        </div>\n                        <div className=\"flex justify-between text-zinc-300\">\n                          <span className=\"text-zinc-400\">Seguro de carga:</span>\n                          <span className=\"text-emerald-400 font-mono\">Incluso</span>\n                        </div>\n                        <div className=\"flex justify-between text-zinc-300\">\n                          <span className=\"text-zinc-400\">Rastreio telem\303\251trico:</span>\n                          <span className=\"text-emerald-400 font-mono\">Ativo 24/7</span>\n                        </div>\n                      </div>\n                    </div>\n\n                    <div>\n                      <div className=\"mb-4\">\n                        <p className=\"text-[11px] text-zinc-400\">Valor do frete</p>\n                        <p className=\"text-2xl font-extrabold font-mono text-zinc-100\">\n                          R$ {quote.price.toLocaleString(\'pt-BR\', { minimumFractionDigits: 2 })}\n                        </p>\n                      </div>\n\n                      <button\n                        type=\"button\"\n                        onClick={() => onSelectQuote(quote)}\n                        className={`w-full py-2.5 px-3 rounded-lg text-xs font-semibold transition-all duration-150 active:scale-[0.98] flex items-center justify-center gap-1.5 ${\n                          quote.badgeType === \'best-price\'\n                            ? \'bg-emerald-500 hover:bg-emerald-400 text-zinc-950 shadow-sm\'\n                            : \'bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700\'\n                        }`}\n                      >\n                        <span>Contratar frete</span>\n                        <ArrowRight className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
